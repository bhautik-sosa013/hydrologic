{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_xg6w6znepitv_6","type":"tool_result","content":"1\timport { useNavigate } from 'react-router-dom';\n2\timport {\n3\t  ArrowLeft,\n4\t  Award,\n5\t  CheckCircle2,\n6\t  Factory,\n7\t  Globe,\n8\t  Handshake,\n9\t  Leaf,\n10\t  Settings,\n11\t  Waves,\n12\t  Droplets,\n13\t  BarChart3,\n14\t  Clock,\n15\t  FileCheck,\n16\t  Users,\n17\t} from 'lucide-react';\n18\timport { Button } from '@/components/ui/button';\n19\timport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n20\timport { Badge } from '@/components/ui/badge';\n21\timport { Separator } from '@/components/ui/separator';\n22\timport { toast } from '@/lib/toast';\n23\t\n24\t// ── Mock data ─────────────────────────────────────────────────────────────────\n25\t\n26\t// TODO: fetch from backend config API when available\n27\tconst TREATMENT_PROCESSES = [\n28\t  {\n29\t    title: 'Preliminary Treatment',\n30\t    description:\n31\t      'Screening, grit removal, and flow measurement to protect downstream equipment and optimize processing efficiency.',\n32\t  },\n33\t  {\n34\t    title: 'Primary Sedimentation',\n35\t    description:\n36\t      'Physical separation of settleable solids and floating materials in primary clarifiers.',\n37\t  },\n38\t  {\n39\t    title: 'Biological Treatment',\n40\t    description:\n41\t      'Activated sludge, trickling filters, or biofilm reactors for organic matter removal and nutrient reduction.',\n42\t  },\n43\t  {\n44\t    title: 'Nutrient Removal',\n45\t    description:\n46\t      'Nitrification, denitrification, and phosphorus removal to meet stringent effluent standards.',\n47\t  },\n48\t  {\n49\t    title: 'Tertiary Treatment',\n50\t    description:\n51\t      'Advanced filtration, UV disinfection, or chemical polishing for water quality objectives.',\n52\t  },\n53\t  {\n54\t    title: 'Sludge Management',\n55\t    description:\n56\t      'Thickening, digestion, dewatering, and resource recovery including biogas generation.',\n57\t  },\n58\t];\n59\t\n60\t// TODO: fetch from backend config API when available\n61\tconst COMPLIANCE_STANDARDS = [\n62\t  'WHO wastewater reuse guidelines',\n63\t  'USEPA effluent guidelines (40 CFR Part 503)',\n64\t  'EU Urban Wastewater Treatment Directive',\n65\t  'National environmental discharge standards',\n66\t  'Local authority permit requirements',\n67\t  'Receiving water body classification standards',\n68\t];\n69\t\n70\t// TODO: fetch from backend config API when available\n71\tconst EFFLUENT_STANDARDS = [\n72\t  { parameter: 'BOD5', typical: '< 10 mg/L', stringent: '< 5 mg/L' },\n73\t  { parameter: 'TSS', typical: '< 10 mg/L', stringent: '< 5 mg/L' },\n74\t  { parameter: 'Ammonia-N', typical: '< 2 mg/L', stringent: '< 0.5 mg/L' },\n75\t  { parameter: 'Total Phosphorus', typical: '< 1 mg/L', stringent: '< 0.3 mg/L' },\n76\t  { parameter: 'Total Nitrogen', typical: '< 10 mg/L', stringent: '< 5 mg/L' },\n77\t  { parameter: 'E. coli', typical: '< 100 CFU/100mL', stringent: '< 10 CFU/100mL' },\n78\t];\n79\t\n80\t// TODO: fetch from backend config API when available\n81\tconst PROJECT_PHASES = [\n82\t  { phase: '01', title: 'Feasibility & Site Assessment', duration: '2-4 weeks' },\n83\t  { phase: '02', title: 'Process Design & Pilot Studies', duration: '4-8 weeks' },\n84\t  { phase: '03', title: 'Detailed Engineering Design', duration: '8-16 weeks' },\n85\t  { phase: '04', title: 'Procurement Support', duration: 'Ongoing' },\n86\t  { phase: '05', title: 'Construction Oversight', duration: 'Project-dependent' },\n87\t  { phase: '06', title: 'Commissioning & Startup', duration: '4-8 weeks' },\n88\t];\n89\t\n90\t// TODO: fetch from backend config API when available\n91\tconst CLIENT_TYPES = [\n92\t  {\n93\t    title: 'Municipal Utilities',\n94\t    description:\n95\t      'Municipal sewage treatment for towns and cities, designed for current and future population growth.',\n96\t    icon: Factory,\n97\t  },\n98\t  {\n99\t    title: 'Industrial Facilities',\n100\t    description:\n101\t      'Custom industrial wastewater treatment solutions for manufacturing, food processing, and heavy industry.',\n102\t    icon: Settings,\n103\t  },\n104\t  {\n105\t    title: 'Government Bodies',\n106\t    description:\n107\t      'Large-scale infrastructure projects for government agencies with stringent regulatory and environmental requirements.',\n108\t    icon: Globe,\n109\t  },\n110\t  {\n111\t    title: 'Real Estate Developers',\n112\t    description:\n113\t      'On-site sewage treatment for residential and commercial developments in areas without municipal sewer access.',\n114\t    icon: Award,\n115\t  },\n116\t];\n117\t\n118\t// TODO: fetch from backend config API when available\n119\tconst CAPABILITIES = [\n120\t  'Municipal wastewater treatment (5,000 to 500,000+ PE)',\n121\t  'Industrial effluent treatment and pretreatment',\n122\t  'Package treatment plant specifications',\n123\t  'Retrofit and upgrade designs for existing facilities',\n124\t  'Effluent recycling and water reuse systems',\n125\t  'Odor control systems engineering',\n126\t  'Energy-efficient aeration system design',\n127\t  'Sludge-to-energy recovery systems',\n128\t  'Real-time monitoring and SCADA integration',\n129\t  'Operations and maintenance manual development',\n130\t];\n131\t\n132\t// TODO: fetch from backend config API when available\n133\tconst FAQS = [\n134\t  {\n135\t    question: 'What is the typical timeline for STP design?',\n136\t    answer:\n137\t      'Project timelines vary based on complexity and regulatory requirements. A typical municipal STP design project ranges from 6 months to 2 years from feasibility through commissioning. We provide detailed project schedules during the initial assessment phase.',\n138\t  },\n139\t  {\n140\t    question: 'How do you handle variable flow conditions?',\n141\t    answer:\n142\t      'Our designs incorporate flow equalization basins, adjustable aeration rates, and flexible treatment trains that adapt to diurnal, seasonal, and emergency flow variations while maintaining consistent effluent quality.',\n143\t  },\n144\t  {\n145\t    question: 'What effluent standards can be achieved?',\n146\t    answer:\n147\t      'Our advanced treatment trains routinely achieve BOD < 10 mg/L, TSS < 10 mg/L, NH3-N < 2 mg/L, and TP < 1 mg/L, exceeding typical discharge permit limits. We also design for water reuse standards where applicable.',\n148\t  },\n149\t  {\n150\t    question: 'Do you provide operations training?',\n151\t    answer:\n152\t      'Yes, we provide comprehensive operator training, maintenance staff certification programs, and ongoing technical support during the warranty period. Our O&M manuals are tailored to your specific equipment and staffing configuration.',\n153\t  },\n154\t];\n155\t\n156\tconst SewageTreatmentPlantDesign = () => {\n157\t  const navigate = useNavigate();\n158\t\n159\t  const handleContact = () => {\n160\t    toast.success('Redirecting to contact form', {\n161\t      description: 'Our STP engineering team will respond within 24 hours.',\n162\t    });\n163\t    navigate('/contact');\n164\t  };\n165\t\n166\t  return (\n167\t    <div className=\"min-h-screen\">\n168\t      {/* ── Hero Section ────────────────────────────────────────────────────── */}\n169\t      <section className=\"relative w-full\">\n170\t        <div className=\"relative w-full h-64 md:h-72 lg:h-80 rounded-xl overflow-hidden mx-4 mt-4 lg:mx-8\">\n171\t          <img\n172\t            src=\"https://images.unsplash.com/photo-1584432810601-6c7f27d2362b?w=1200&h=600&fit=crop\"\n173\t            alt=\"Sewage Treatment Plant\"\n174\t            className=\"absolute inset-0 w-full h-full object-cover\"\n175\t          />\n176\t          <div className=\"absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/30\" />\n177\t          <div className=\"relative z-10 flex flex-col justify-end h-full p-6 md:p-8 lg:p-10\">\n178\t            <Badge\n179\t              variant=\"secondary\"\n180\t              className=\"w-fit mb-3 bg-white/20 text-white border-white/30 backdrop-blur-sm\"\n181\t            >\n182\t              Wastewater Engineering\n183\t            </Badge>\n184\t            <h1 className=\"text-3xl md:text-4xl font-bold text-white mb-2\">\n185\t              Sewage Treatment Plant Design\n186\t            </h1>\n187\t            <p className=\"text-base md:text-lg text-white/80 max-w-3xl\">\n188\t              Comprehensive STP Engineering Solutions\n189\t            </p>\n190\t          </div>\n191\t        </div>\n192\t      </section>\n193\t\n194\t      {/* ── Back Button & Main Content ─────────────────────────────────────── */}\n195\t      <div className=\"container mx-auto max-w-7xl px-4 lg:px-8 py-8\">\n196\t        {/* Back navigation */}\n197\t        <Button\n198\t          variant=\"ghost\"\n199\t          onClick={() => navigate(-1)}\n200\t          className=\"mb-6 pl-0 hover:bg-transparent hover:pl-2 transition-all duration-200\"\n201\t        >\n202\t          <ArrowLeft className=\"mr-2 h-4 w-4\" />\n203\t          Back to Services\n204\t        </Button>\n205\t\n206\t        {/* Overview Section */}\n207\t        <section className=\"mb-16\">\n208\t          <div className=\"grid lg:grid-cols-2 gap-10 items-start\">\n209\t            <div>\n210\t              <h2 className=\"text-2xl md:text-3xl font-semibold mb-4\">\n211\t                End-to-End Sewage Treatment Plant Engineering\n212\t              </h2>\n213\t              <p className=\"text-muted-foreground leading-relaxed mb-6\">\n214\t                Hydrologic Innovation provides comprehensive Sewage Treatment Plant engineering\n215\t                services, covering biological treatment process design, environmental compliance,\n216\t                and effluent quality management. From concept through commissioning, our team\n217\t                delivers STP solutions tailored to the unique needs of municipalities, industrial\n218\t                facilities, and government clients, ensuring reliable treatment that protects\n219\t                public health and the environment.\n220\t              </p>\n221\t              <div className=\"flex flex-wrap gap-3\">\n222\t                <Button onClick={handleContact}>Request Consultation</Button>\n223\t                <Button variant=\"outline\" onClick={() => navigate('/projects')}>\n224\t                  View Related Projects\n225\t                </Button>\n226\t              </div>\n227\t            </div>\n228\t            <div className=\"grid grid-cols-2 gap-4\">\n229\t              {[\n230\t                { value: '150+', label: 'STP Projects' },\n231\t                { value: '98%', label: 'Permit Compliance' },\n232\t                { value: '40+', label: 'Years Combined Exp.' },\n233\t                { value: '30+', label: 'Municipal Clients' },\n234\t              ].map((stat) => (\n235\t                <Card key={stat.label} className=\"text-center p-4\">\n236\t                  <div className=\"text-2xl font-bold text-primary mb-1\">{stat.value}</div>\n237\t                  <div className=\"text-sm text-muted-foreground\">{stat.label}</div>\n238\t                </Card>\n239\t              ))}\n240\t            </div>\n241\t          </div>\n242\t        </section>\n243\t\n244\t        <Separator className=\"my-12\" />\n245\t\n246\t        {/* ── Key Strengths ─────────────────────────────────────────────────── */}\n247\t        <section className=\"mb-16\">\n248\t          <h2 className=\"text-2xl md:text-3xl font-semibold mb-8\">\n249\t            Our Approach\n250\t          </h2>\n251\t          <div className=\"grid gap-6 md:grid-cols-2 lg:grid-cols-4\">\n252\t            <div className=\"bg-card rounded-xl border p-6\">\n253\t              <Leaf className=\"h-8 w-8 text-primary mb-4\" />\n254\t              <h3 className=\"font-semibold mb-2\">Environmental Protection</h3>\n255\t              <p className=\"text-sm text-muted-foreground\">\n256\t                Treatment processes designed to meet or exceed all applicable discharge standards\n257\t                and protect receiving water bodies.\n258\t              </p>\n259\t            </div>\n260\t            <div className=\"bg-card rounded-xl border p-6\">\n261\t              <Handshake className=\"h-8 w-8 text-primary mb-4\" />\n262\t              <h3 className=\"font-semibold mb-2\">Infrastructure Integration</h3>\n263\t              <p className=\"text-sm text-muted-foreground\">\n264\t                Seamless connection with existing collection systems and downstream reuse\n265\t                infrastructure.\n266\t              </p>\n267\t            </div>\n268\t            <div className=\"bg-card rounded-xl border p-6\">\n269\t              <Settings className=\"h-8 w-8 text-primary mb-4\" />\n270\t              <h3 className=\"font-semibold mb-2\">Process Reliability</h3>\n271\t              <p className=\"text-sm text-muted-foreground\">\n272\t                Robust designs with redundancy and flexibility to handle variable loads and\n273\t                emergency conditions.\n274\t              </p>\n275\t            </div>\n276\t            <div className=\"bg-card rounded-xl border p-6\">\n277\t              <Award className=\"h-8 w-8 text-primary mb-4\" />\n278\t              <h3 className=\"font-semibold mb-2\">Proven Track Record</h3>\n279\t              <p className=\"text-sm text-muted-foreground\">\n280\t                Decades of STP experience across diverse industries and regulatory environments.\n281\t              </p>\n282\t            </div>\n283\t          </div>\n284\t        </section>\n285\t\n286\t        <Separator className=\"my-12\" />\n287\t\n288\t        {/* ── Treatment Processes ─────────────────────────────────────────── */}\n289\t        <section className=\"mb-16\">\n290\t          <h2 className=\"text-2xl md:text-3xl font-semibold mb-2\">\n291\t            Biological Treatment Processes\n292\t          </h2>\n293\t          <p className=\"text-muted-foreground mb-8 max-w-2xl\">\n294\t            Our engineers specialize in designing treatment processes tailored to your influent\n295\t            characteristics, space constraints, and discharge objectives.\n296\t          </p>\n297\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n298\t            {TREATMENT_PROCESSES.map((process) => (\n299\t              <Card key={process.title} className=\"hover:shadow-md transition-shadow\">\n300\t                <CardHeader>\n301\t                  <CardTitle className=\"text-lg\">{process.title}</CardTitle>\n302\t                </CardHeader>\n303\t                <CardContent>\n304\t                  <CardDescription>{process.description}</CardDescription>\n305\t                </CardContent>\n306\t              </Card>\n307\t            ))}\n308\t          </div>\n309\t        </section>\n310\t\n311\t        <Separator className=\"my-12\" />\n312\t\n313\t        {/* ── Effluent Quality Standards ────────────────────────────────────── */}\n314\t        <section className=\"mb-16\">\n315\t          <div className=\"mb-8\">\n316\t            <div className=\"flex items-center gap-3 mb-4\">\n317\t              <div className=\"flex items-center justify-center w-12 h-12 rounded-full bg-primary/10\">\n318\t                <Droplets className=\"h-6 w-6 text-primary\" />\n319\t              </div>\n320\t              <h2 className=\"text-2xl md:text-3xl font-semibold\">\n321\t                Effluent Quality Standards\n322\t              </h2>\n323\t            </div>\n324\t            <p className=\"text-muted-foreground max-w-2xl\">\n325\t              Our advanced treatment trains are designed to achieve superior effluent quality\n326\t              that meets or exceeds stringent discharge requirements. Typical achieved values:\n327\t            </p>\n328\t          </div>\n329\t          <Card>\n330\t            <CardHeader>\n331\t              <CardTitle className=\"text-lg\">Typical Effluent Parameters</CardTitle>\n332\t              <CardDescription>\n333\t                Designed treatment performance vs. stringent water reuse standards\n334\t              </CardDescription>\n335\t            </CardHeader>\n336\t            <CardContent>\n337\t              <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\">\n338\t                {EFFLUENT_STANDARDS.map((std) => (\n339\t                  <div\n340\t                    key={std.parameter}\n341\t                    className=\"bg-muted/50 rounded-lg p-4 text-center\"\n342\t                  >\n343\t                    <div className=\"text-sm font-medium text-muted-foreground mb-2\">\n344\t                      {std.parameter}\n345\t                    </div>\n346\t                    <div className=\"text-lg font-bold text-primary mb-1\">{std.typical}</div>\n347\t                    <div className=\"text-xs text-muted-foreground\">\n348\t                      Reuse: {std.stringent}\n349\t                    </div>\n350\t                  </div>\n351\t                ))}\n352\t              </div>\n353\t            </CardContent>\n354\t          </Card>\n355\t        </section>\n356\t\n357\t        <Separator className=\"my-12\" />\n358\t\n359\t        {/* ── Environmental Compliance ───────────────────────────────────── */}\n360\t        <section className=\"mb-16\">\n361\t          <h2 className=\"text-2xl md:text-3xl font-semibold mb-8\">\n362\t            Compliance & Standards\n363\t          </h2>\n364\t          <Card className=\"bg-green-50 dark:bg-green-950/20 border-green-200 dark:border-green-900\">\n365\t            <CardContent className=\"p-8\">\n366\t              <div className=\"flex items-center gap-2 mb-6\">\n367\t                <FileCheck className=\"h-6 w-6 text-green-600\" />\n368\t                <h3 className=\"text-lg font-semibold\">International & Local Standards</h3>\n369\t              </div>\n370\t              <p className=\"text-muted-foreground mb-6\">\n371\t                Our STP designs are developed in full compliance with applicable international\n372\t                and local standards:\n373\t              </p>\n374\t              <ul className=\"grid gap-3 md:grid-cols-2 lg:grid-cols-3\">\n375\t                {COMPLIANCE_STANDARDS.map((standard) => (\n376\t                  <li key={standard} className=\"flex items-start gap-3\">\n377\t                    <CheckCircle2 className=\"h-5 w-5 text-green-600 shrink-0 mt-0.5\" />\n378\t                    <span className=\"text-sm\">{standard}</span>\n379\t                  </li>\n380\t                ))}\n381\t              </ul>\n382\t            </CardContent>\n383\t          </Card>\n384\t        </section>\n385\t\n386\t        <Separator className=\"my-12\" />\n387\t\n388\t        {/* ── Project Phases Timeline ─────────────────────────────────────── */}\n389\t        <section className=\"mb-16\">\n390\t          <div className=\"mb-8\">\n391\t            <div className=\"flex items-center gap-3 mb-4\">\n392\t              <div className=\"flex items-center justify-center w-12 h-12 rounded-full bg-primary/10\">\n393\t                <BarChart3 className=\"h-6 w-6 text-primary\" />\n394\t              </div>\n395\t              <h2 className=\"text-2xl md:text-3xl font-semibold\">\n396\t                Project Lifecycle: Concept Through Commissioning\n397\t              </h2>\n398\t            </div>\n399\t            <p className=\"text-muted-foreground max-w-2xl\">\n400\t              From initial feasibility through final commissioning, our structured approach\n401\t              ensures quality and transparency at every stage of your STP project.\n402\t            </p>\n403\t          </div>\n404\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-4\">\n405\t            {PROJECT_PHASES.map((item) => (\n406\t              <Card key={item.phase} className=\"relative overflow-hidden\">\n407\t                <div className=\"absolute top-0 left-0 h-1 w-full bg-primary\" />\n408\t                <CardHeader>\n409\t                  <div className=\"flex items-center justify-between mb-2\">\n410\t                    <Badge variant=\"outline\" className=\"font-mono text-sm\">\n411\t                      Phase {item.phase}\n412\t                    </Badge>\n413\t                    <div className=\"flex items-center gap-1 text-xs text-muted-foreground\">\n414\t                      <Clock className=\"h-3 w-3\" />\n415\t                      {item.duration}\n416\t                    </div>\n417\t                  </div>\n418\t                  <CardTitle className=\"text-base\">{item.title}</CardTitle>\n419\t                </CardHeader>\n420\t              </Card>\n421\t            ))}\n422\t          </div>\n423\t        </section>\n424\t\n425\t        <Separator className=\"my-12\" />\n426\t\n427\t        {/* ── Capabilities List ───────────────────────────────────────────── */}\n428\t        <section className=\"mb-16\">\n429\t          <div className=\"grid lg:grid-cols-2 gap-10\">\n430\t            <div>\n431\t              <h2 className=\"text-2xl md:text-3xl font-semibold mb-2\">\n432\t                Technical Capabilities\n433\t              </h2>\n434\t              <p className=\"text-muted-foreground mb-6\">\n435\t                Our team brings comprehensive expertise across the full spectrum of sewage\n436\t                treatment plant design and related infrastructure.\n437\t              </p>\n438\t              <Button onClick={handleContact}>Discuss Your Project</Button>\n439\t            </div>\n440\t            <div>\n441\t              <ul className=\"grid gap-3\">\n442\t                {CAPABILITIES.map((cap) => (\n443\t                  <li key={cap} className=\"flex items-start gap-3\">\n444\t                    <CheckCircle2 className=\"h-5 w-5 text-primary shrink-0 mt-0.5\" />\n445\t                    <span className=\"text-sm leading-relaxed\">{cap}</span>\n446\t                  </li>\n447\t                ))}\n448\t              </ul>\n449\t            </div>\n450\t          </div>\n451\t        </section>\n452\t\n453\t        <Separator className=\"my-12\" />\n454\t\n455\t        {/* ── Client Types ────────────────────────────────────────────────── */}\n456\t        <section className=\"mb-16\">\n457\t          <h2 className=\"text-2xl md:text-3xl font-semibold mb-8\">Who We Serve</h2>\n458\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n459\t            {CLIENT_TYPES.map((client) => {\n460\t              const Icon = client.icon;\n461\t              return (\n462\t                <Card key={client.title} className=\"hover:shadow-md transition-shadow\">\n463\t                  <CardHeader>\n464\t                    <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-3\">\n465\t                      <Icon className=\"h-6 w-6 text-primary\" />\n466\t                    </div>\n467\t                    <CardTitle>{client.title}</CardTitle>\n468\t                  </CardHeader>\n469\t                  <CardContent>\n470\t                    <CardDescription>{client.description}</CardDescription>\n471\t                  </CardContent>\n472\t                </Card>\n473\t              );\n474\t            })}\n475\t          </div>\n476\t        </section>\n477\t\n478\t        <Separator className=\"my-12\" />\n479\t\n480\t        {/* ── FAQ Section ─────────────────────────────────────────────────── */}\n481\t        <section className=\"mb-16\">\n482\t          <div className=\"mb-8\">\n483\t            <h2 className=\"text-2xl md:text-3xl font-semibold mb-2\">\n484\t              Frequently Asked Questions\n485\t            </h2>\n486\t          </div>\n487\t          <div className=\"grid md:grid-cols-2 gap-6\">\n488\t            {FAQS.map((faq, index) => (\n489\t              <Card key={index}>\n490\t                <CardHeader>\n491\t                  <CardTitle className=\"text-base leading-snug\">{faq.question}</CardTitle>\n492\t                </CardHeader>\n493\t                <CardContent>\n494\t                  <CardDescription className=\"text-sm leading-relaxed\">\n495\t                    {faq.answer}\n496\t                  </CardDescription>\n497\t                </CardContent>\n498\t              </Card>\n499\t            ))}\n500\t          </div>\n501\t        </section>\n502\t\n503\t        <Separator className=\"my-12\" />\n504\t\n505\t        {/* ── CTA Section ─────────────────────────────────────────────────── */}\n506\t        <section className=\"mb-8\">\n507\t          <div className=\"bg-card rounded-2xl border p-8 md:p-12 text-center\">\n508\t            <div className=\"flex items-center justify-center gap-2 mb-4\">\n509\t              <Users className=\"h-6 w-6 text-primary\" />\n510\t              <h2 className=\"text-2xl md:text-3xl font-semibold\">\n511\t                Ready to Start Your STP Project?\n512\t              </h2>\n513\t            </div>\n514\t            <p className=\"text-muted-foreground max-w-2xl mx-auto mb-6\">\n515\t              Our sewage treatment plant engineering team is ready to help you navigate the\n516\t              entire process from feasibility assessment through commissioning. Contact us\n517\t              today to discuss your project requirements.\n518\t            </p>\n519\t            <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n520\t              <Button size=\"lg\" onClick={handleContact}>\n521\t                Request a Consultation\n522\t              </Button>\n523\t              <Button size=\"lg\" variant=\"outline\" asChild>\n524\t                <a href=\"tel:+18005551234\">Call +1 (800) 555-1234</a>\n525\t              </Button>\n526\t            </div>\n527\t          </div>\n528\t        </section>\n529\t      </div>\n530\t    </div>\n531\t  );\n532\t};\n533\t\n534\texport default SewageTreatmentPlantDesign;"}]},"parent_tool_use_id":null,"session_id":"a7acff44-f104-4b18-a19d-824b8719d3af","uuid":"49a2ae07-21c8-4f46-8b5b-2a655b1e7379","timestamp":"2026-04-18T17:19:58.416Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/code/project-code/code_base/app_7a97b333c52f0a2e89b9d85da46ab74b/frontend/src/pages/SewageTreatmentPlantDesign.tsx","content":"import { useNavigate } from 'react-router-dom';\nimport {\n  ArrowLeft,\n  Award,\n  CheckCircle2,\n  Factory,\n  Globe,\n  Handshake,\n  Leaf,\n  Settings,\n  Waves,\n  Droplets,\n  BarChart3,\n  Clock,\n  FileCheck,\n  Users,\n} from 'lucide-react';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport { Separator } from '@/components/ui/separator';\nimport { toast } from '@/lib/toast';\n\n// ── Mock data ─────────────────────────────────────────────────────────────────\n\n// TODO: fetch from backend config API when available\nconst TREATMENT_PROCESSES = [\n  {\n    title: 'Preliminary Treatment',\n    description:\n      'Screening, grit removal, and flow measurement to protect downstream equipment and optimize processing efficiency.',\n  },\n  {\n    title: 'Primary Sedimentation',\n    description:\n      'Physical separation of settleable solids and floating materials in primary clarifiers.',\n  },\n  {\n    title: 'Biological Treatment',\n    description:\n      'Activated sludge, trickling filters, or biofilm reactors for organic matter removal and nutrient reduction.',\n  },\n  {\n    title: 'Nutrient Removal',\n    description:\n      'Nitrification, denitrification, and phosphorus removal to meet stringent effluent standards.',\n  },\n  {\n    title: 'Tertiary Treatment',\n    description:\n      'Advanced filtration, UV disinfection, or chemical polishing for water quality objectives.',\n  },\n  {\n    title: 'Sludge Management',\n    description:\n      'Thickening, digestion, dewatering, and resource recovery including biogas generation.',\n  },\n];\n\n// TODO: fetch from backend config API when available\nconst COMPLIANCE_STANDARDS = [\n  'WHO wastewater reuse guidelines',\n  'USEPA effluent guidelines (40 CFR Part 503)',\n  'EU Urban Wastewater Treatment Directive',\n  'National environmental discharge standards',\n  'Local authority permit requirements',\n  'Receiving water body classification standards',\n];\n\n// TODO: fetch from backend config API when available\nconst EFFLUENT_STANDARDS = [\n  { parameter: 'BOD5', typical: '< 10 mg/L', stringent: '< 5 mg/L' },\n  { parameter: 'TSS', typical: '< 10 mg/L', stringent: '< 5 mg/L' },\n  { parameter: 'Ammonia-N', typical: '< 2 mg/L', stringent: '< 0.5 mg/L' },\n  { parameter: 'Total Phosphorus', typical: '< 1 mg/L', stringent: '< 0.3 mg/L' },\n  { parameter: 'Total Nitrogen', typical: '< 10 mg/L', stringent: '< 5 mg/L' },\n  { parameter: 'E. coli', typical: '< 100 CFU/100mL', stringent: '< 10 CFU/100mL' },\n];\n\n// TODO: fetch from backend config API when available\nconst PROJECT_PHASES = [\n  { phase: '01', title: 'Feasibility & Site Assessment', duration: '2-4 weeks' },\n  { phase: '02', title: 'Process Design & Pilot Studies', duration: '4-8 weeks' },\n  { phase: '03', title: 'Detailed Engineering Design', duration: '8-16 weeks' },\n  { phase: '04', title: 'Procurement Support', duration: 'Ongoing' },\n  { phase: '05', title: 'Construction Oversight', duration: 'Project-dependent' },\n  { phase: '06', title: 'Commissioning & Startup', duration: '4-8 weeks' },\n];\n\n// TODO: fetch from backend config API when available\nconst CLIENT_TYPES = [\n  {\n    title: 'Municipal Utilities',\n    description:\n      'Municipal sewage treatment for towns and cities, designed for current and future population growth.',\n    icon: Factory,\n  },\n  {\n    title: 'Industrial Facilities',\n    description:\n      'Custom industrial wastewater treatment solutions for manufacturing, food processing, and heavy industry.',\n    icon: Settings,\n  },\n  {\n    title: 'Government Bodies',\n    description:\n      'Large-scale infrastructure projects for government agencies with stringent regulatory and environmental requirements.',\n    icon: Globe,\n  },\n  {\n    title: 'Real Estate Developers',\n    description:\n      'On-site sewage treatment for residential and commercial developments in areas without municipal sewer access.',\n    icon: Award,\n  },\n];\n\n// TODO: fetch from backend config API when available\nconst CAPABILITIES = [\n  'Municipal wastewater treatment (5,000 to 500,000+ PE)',\n  'Industrial effluent treatment and pretreatment',\n  'Package treatment plant specifications',\n  'Retrofit and upgrade designs for existing facilities',\n  'Effluent recycling and water reuse systems',\n  'Odor control systems engineering',\n  'Energy-efficient aeration system design',\n  'Sludge-to-energy recovery systems',\n  'Real-time monitoring and SCADA integration',\n  'Operations and maintenance manual development',\n];\n\n// TODO: fetch from backend config API when available\nconst FAQS = [\n  {\n    question: 'What is the typical timeline for STP design?',\n    answer:\n      'Project timelines vary based on complexity and regulatory requirements. A typical municipal STP design project ranges from 6 months to 2 years from feasibility through commissioning. We provide detailed project schedules during the initial assessment phase.',\n  },\n  {\n    question: 'How do you handle variable flow conditions?',\n    answer:\n      'Our designs incorporate flow equalization basins, adjustable aeration rates, and flexible treatment trains that adapt to diurnal, seasonal, and emergency flow variations while maintaining consistent effluent quality.',\n  },\n  {\n    question: 'What effluent standards can be achieved?',\n    answer:\n      'Our advanced treatment trains routinely achieve BOD < 10 mg/L, TSS < 10 mg/L, NH3-N < 2 mg/L, and TP < 1 mg/L, exceeding typical discharge permit limits. We also design for water reuse standards where applicable.',\n  },\n  {\n    question: 'Do you provide operations training?',\n    answer:\n      'Yes, we provide comprehensive operator training, maintenance staff certification programs, and ongoing technical support during the warranty period. Our O&M manuals are tailored to your specific equipment and staffing configuration.',\n  },\n];\n\nconst SewageTreatmentPlantDesign = () => {\n  const navigate = useNavigate();\n\n  const handleContact = () => {\n    toast.success('Redirecting to contact form', {\n      description: 'Our STP engineering team will respond within 24 hours.',\n    });\n    navigate('/contact');\n  };\n\n  return (\n    <div className=\"min-h-screen\">\n      {/* ── Hero Section ────────────────────────────────────────────────────── */}\n      <section className=\"relative w-full\">\n        <div className=\"relative w-full h-64 md:h-72 lg:h-80 rounded-xl overflow-hidden mx-4 mt-4 lg:mx-8\">\n          <img\n            src=\"https://images.unsplash.com/photo-1584432810601-6c7f27d2362b?w=1200&h=600&fit=crop\"\n            alt=\"Sewage Treatment Plant\"\n            className=\"absolute inset-0 w-full h-full object-cover\"\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/30\" />\n          <div className=\"relative z-10 flex flex-col justify-end h-full p-6 md:p-8 lg:p-10\">\n            <Badge\n              variant=\"secondary\"\n              className=\"w-fit mb-3 bg-white/20 text-white border-white/30 backdrop-blur-sm\"\n            >\n              Wastewater Engineering\n            </Badge>\n            <h1 className=\"text-3xl md:text-4xl font-bold text-white mb-2\">\n              Sewage Treatment Plant Design\n            </h1>\n            <p className=\"text-base md:text-lg text-white/80 max-w-3xl\">\n              Comprehensive STP Engineering Solutions\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* ── Back Button & Main Content ─────────────────────────────────────── */}\n      <div className=\"container mx-auto max-w-7xl px-4 lg:px-8 py-8\">\n        {/* Back navigation */}\n        <Button\n          variant=\"ghost\"\n          onClick={() => navigate(-1)}\n          className=\"mb-6 pl-0 hover:bg-transparent hover:pl-2 transition-all duration-200\"\n        >\n          <ArrowLeft className=\"mr-2 h-4 w-4\" />\n          Back to Services\n        </Button>\n\n        {/* Overview Section */}\n        <section className=\"mb-16\">\n          <div className=\"grid lg:grid-cols-2 gap-10 items-start\">\n            <div>\n              <h2 className=\"text-2xl md:text-3xl font-semibold mb-4\">\n                End-to-End Sewage Treatment Plant Engineering\n              </h2>\n              <p className=\"text-muted-foreground leading-relaxed mb-6\">\n                Hydrologic Innovation provides comprehensive Sewage Treatment Plant engineering\n                services, covering biological treatment process design, environmental compliance,\n                and effluent quality management. From concept through commissioning, our team\n                delivers STP solutions tailored to the unique needs of municipalities, industrial\n                facilities, and government clients, ensuring reliable treatment that protects\n                public health and the environment.\n              </p>\n              <div className=\"flex flex-wrap gap-3\">\n                <Button onClick={handleContact}>Request Consultation</Button>\n                <Button variant=\"outline\" onClick={() => navigate('/projects')}>\n                  View Related Projects\n                </Button>\n              </div>\n            </div>\n            <div className=\"grid grid-cols-2 gap-4\">\n              {[\n                { value: '150+', label: 'STP Projects' },\n                { value: '98%', label: 'Permit Compliance' },\n                { value: '40+', label: 'Years Combined Exp.' },\n                { value: '30+', label: 'Municipal Clients' },\n              ].map((stat) => (\n                <Card key={stat.label} className=\"text-center p-4\">\n                  <div className=\"text-2xl font-bold text-primary mb-1\">{stat.value}</div>\n                  <div className=\"text-sm text-muted-foreground\">{stat.label}</div>\n                </Card>\n              ))}\n            </div>\n          </div>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── Key Strengths ─────────────────────────────────────────────────── */}\n        <section className=\"mb-16\">\n          <h2 className=\"text-2xl md:text-3xl font-semibold mb-8\">\n            Our Approach\n          </h2>\n          <div className=\"grid gap-6 md:grid-cols-2 lg:grid-cols-4\">\n            <div className=\"bg-card rounded-xl border p-6\">\n              <Leaf className=\"h-8 w-8 text-primary mb-4\" />\n              <h3 className=\"font-semibold mb-2\">Environmental Protection</h3>\n              <p className=\"text-sm text-muted-foreground\">\n                Treatment processes designed to meet or exceed all applicable discharge standards\n                and protect receiving water bodies.\n              </p>\n            </div>\n            <div className=\"bg-card rounded-xl border p-6\">\n              <Handshake className=\"h-8 w-8 text-primary mb-4\" />\n              <h3 className=\"font-semibold mb-2\">Infrastructure Integration</h3>\n              <p className=\"text-sm text-muted-foreground\">\n                Seamless connection with existing collection systems and downstream reuse\n                infrastructure.\n              </p>\n            </div>\n            <div className=\"bg-card rounded-xl border p-6\">\n              <Settings className=\"h-8 w-8 text-primary mb-4\" />\n              <h3 className=\"font-semibold mb-2\">Process Reliability</h3>\n              <p className=\"text-sm text-muted-foreground\">\n                Robust designs with redundancy and flexibility to handle variable loads and\n                emergency conditions.\n              </p>\n            </div>\n            <div className=\"bg-card rounded-xl border p-6\">\n              <Award className=\"h-8 w-8 text-primary mb-4\" />\n              <h3 className=\"font-semibold mb-2\">Proven Track Record</h3>\n              <p className=\"text-sm text-muted-foreground\">\n                Decades of STP experience across diverse industries and regulatory environments.\n              </p>\n            </div>\n          </div>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── Treatment Processes ─────────────────────────────────────────── */}\n        <section className=\"mb-16\">\n          <h2 className=\"text-2xl md:text-3xl font-semibold mb-2\">\n            Biological Treatment Processes\n          </h2>\n          <p className=\"text-muted-foreground mb-8 max-w-2xl\">\n            Our engineers specialize in designing treatment processes tailored to your influent\n            characteristics, space constraints, and discharge objectives.\n          </p>\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {TREATMENT_PROCESSES.map((process) => (\n              <Card key={process.title} className=\"hover:shadow-md transition-shadow\">\n                <CardHeader>\n                  <CardTitle className=\"text-lg\">{process.title}</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription>{process.description}</CardDescription>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── Effluent Quality Standards ────────────────────────────────────── */}\n        <section className=\"mb-16\">\n          <div className=\"mb-8\">\n            <div className=\"flex items-center gap-3 mb-4\">\n              <div className=\"flex items-center justify-center w-12 h-12 rounded-full bg-primary/10\">\n                <Droplets className=\"h-6 w-6 text-primary\" />\n              </div>\n              <h2 className=\"text-2xl md:text-3xl font-semibold\">\n                Effluent Quality Standards\n              </h2>\n            </div>\n            <p className=\"text-muted-foreground max-w-2xl\">\n              Our advanced treatment trains are designed to achieve superior effluent quality\n              that meets or exceeds stringent discharge requirements. Typical achieved values:\n            </p>\n          </div>\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-lg\">Typical Effluent Parameters</CardTitle>\n              <CardDescription>\n                Designed treatment performance vs. stringent water reuse standards\n              </CardDescription>\n            </CardHeader>\n            <CardContent>\n              <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\">\n                {EFFLUENT_STANDARDS.map((std) => (\n                  <div\n                    key={std.parameter}\n                    className=\"bg-muted/50 rounded-lg p-4 text-center\"\n                  >\n                    <div className=\"text-sm font-medium text-muted-foreground mb-2\">\n                      {std.parameter}\n                    </div>\n                    <div className=\"text-lg font-bold text-primary mb-1\">{std.typical}</div>\n                    <div className=\"text-xs text-muted-foreground\">\n                      Reuse: {std.stringent}\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </CardContent>\n          </Card>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── Environmental Compliance ───────────────────────────────────── */}\n        <section className=\"mb-16\">\n          <h2 className=\"text-2xl md:text-3xl font-semibold mb-8\">\n            Compliance & Standards\n          </h2>\n          <Card className=\"bg-green-50 dark:bg-green-950/20 border-green-200 dark:border-green-900\">\n            <CardContent className=\"p-8\">\n              <div className=\"flex items-center gap-2 mb-6\">\n                <FileCheck className=\"h-6 w-6 text-green-600\" />\n                <h3 className=\"text-lg font-semibold\">International & Local Standards</h3>\n              </div>\n              <p className=\"text-muted-foreground mb-6\">\n                Our STP designs are developed in full compliance with applicable international\n                and local standards:\n              </p>\n              <ul className=\"grid gap-3 md:grid-cols-2 lg:grid-cols-3\">\n                {COMPLIANCE_STANDARDS.map((standard) => (\n                  <li key={standard} className=\"flex items-start gap-3\">\n                    <CheckCircle2 className=\"h-5 w-5 text-green-600 shrink-0 mt-0.5\" />\n                    <span className=\"text-sm\">{standard}</span>\n                  </li>\n                ))}\n              </ul>\n            </CardContent>\n          </Card>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── Project Phases Timeline ─────────────────────────────────────── */}\n        <section className=\"mb-16\">\n          <div className=\"mb-8\">\n            <div className=\"flex items-center gap-3 mb-4\">\n              <div className=\"flex items-center justify-center w-12 h-12 rounded-full bg-primary/10\">\n                <BarChart3 className=\"h-6 w-6 text-primary\" />\n              </div>\n              <h2 className=\"text-2xl md:text-3xl font-semibold\">\n                Project Lifecycle: Concept Through Commissioning\n              </h2>\n            </div>\n            <p className=\"text-muted-foreground max-w-2xl\">\n              From initial feasibility through final commissioning, our structured approach\n              ensures quality and transparency at every stage of your STP project.\n            </p>\n          </div>\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {PROJECT_PHASES.map((item) => (\n              <Card key={item.phase} className=\"relative overflow-hidden\">\n                <div className=\"absolute top-0 left-0 h-1 w-full bg-primary\" />\n                <CardHeader>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <Badge variant=\"outline\" className=\"font-mono text-sm\">\n                      Phase {item.phase}\n                    </Badge>\n                    <div className=\"flex items-center gap-1 text-xs text-muted-foreground\">\n                      <Clock className=\"h-3 w-3\" />\n                      {item.duration}\n                    </div>\n                  </div>\n                  <CardTitle className=\"text-base\">{item.title}</CardTitle>\n                </CardHeader>\n              </Card>\n            ))}\n          </div>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── Capabilities List ───────────────────────────────────────────── */}\n        <section className=\"mb-16\">\n          <div className=\"grid lg:grid-cols-2 gap-10\">\n            <div>\n              <h2 className=\"text-2xl md:text-3xl font-semibold mb-2\">\n                Technical Capabilities\n              </h2>\n              <p className=\"text-muted-foreground mb-6\">\n                Our team brings comprehensive expertise across the full spectrum of sewage\n                treatment plant design and related infrastructure.\n              </p>\n              <Button onClick={handleContact}>Discuss Your Project</Button>\n            </div>\n            <div>\n              <ul className=\"grid gap-3\">\n                {CAPABILITIES.map((cap) => (\n                  <li key={cap} className=\"flex items-start gap-3\">\n                    <CheckCircle2 className=\"h-5 w-5 text-primary shrink-0 mt-0.5\" />\n                    <span className=\"text-sm leading-relaxed\">{cap}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── Client Types ────────────────────────────────────────────────── */}\n        <section className=\"mb-16\">\n          <h2 className=\"text-2xl md:text-3xl font-semibold mb-8\">Who We Serve</h2>\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {CLIENT_TYPES.map((client) => {\n              const Icon = client.icon;\n              return (\n                <Card key={client.title} className=\"hover:shadow-md transition-shadow\">\n                  <CardHeader>\n                    <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-3\">\n                      <Icon className=\"h-6 w-6 text-primary\" />\n                    </div>\n                    <CardTitle>{client.title}</CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <CardDescription>{client.description}</CardDescription>\n                  </CardContent>\n                </Card>\n              );\n            })}\n          </div>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── FAQ Section ─────────────────────────────────────────────────── */}\n        <section className=\"mb-16\">\n          <div className=\"mb-8\">\n            <h2 className=\"text-2xl md:text-3xl font-semibold mb-2\">\n              Frequently Asked Questions\n            </h2>\n          </div>\n          <div className=\"grid md:grid-cols-2 gap-6\">\n            {FAQS.map((faq, index) => (\n              <Card key={index}>\n                <CardHeader>\n                  <CardTitle className=\"text-base leading-snug\">{faq.question}</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription className=\"text-sm leading-relaxed\">\n                    {faq.answer}\n                  </CardDescription>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </section>\n\n        <Separator className=\"my-12\" />\n\n        {/* ── CTA Section ─────────────────────────────────────────────────── */}\n        <section className=\"mb-8\">\n          <div className=\"bg-card rounded-2xl border p-8 md:p-12 text-center\">\n            <div className=\"flex items-center justify-center gap-2 mb-4\">\n              <Users className=\"h-6 w-6 text-primary\" />\n              <h2 className=\"text-2xl md:text-3xl font-semibold\">\n                Ready to Start Your STP Project?\n              </h2>\n            </div>\n            <p className=\"text-muted-foreground max-w-2xl mx-auto mb-6\">\n              Our sewage treatment plant engineering team is ready to help you navigate the\n              entire process from feasibility assessment through commissioning. Contact us\n              today to discuss your project requirements.\n            </p>\n            <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n              <Button size=\"lg\" onClick={handleContact}>\n                Request a Consultation\n              </Button>\n              <Button size=\"lg\" variant=\"outline\" asChild>\n                <a href=\"tel:+18005551234\">Call +1 (800) 555-1234</a>\n              </Button>\n            </div>\n          </div>\n        </section>\n      </div>\n    </div>\n  );\n};\n\nexport default SewageTreatmentPlantDesign;","numLines":534,"startLine":1,"totalLines":534}}}
