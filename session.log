tail'));\n\n// ── Query client ─────────────────────────────────────────────────────────────\n\nconst queryClient = new QueryClient();\n\n// ── Page loading fallback ─────────────────────────────────────────────────────\n\nconst PageLoader = () => (\n  <div className=\"flex min-h-[50vh] items-center justify-center\">\n    <div className=\"h-8 w-8 animate-spin rounded-full border-4 border-primary border-t-transparent\" />\n  </div>\n);\n\n// ── Layout route — wraps all pages inside AppLayout using React Router Outlet ─\n\nconst AppLayoutRoute = () => (\n  <AppLayout>\n    <Suspense fallback={<PageLoader />}>\n      <Outlet />\n    </Suspense>\n  </AppLayout>\n);\n\n// ── App ───────────────────────────────────────────────────────────────────────\n\nconst App = () => (\n  <QueryClientProvider client={queryClient}>\n    <TooltipProvider>\n      <Toaster />\n      <CustomToastProvider>\n        <ThemeProvider>\n          <ErrorBoundary>\n            <BrowserRouter>\n              <Routes>\n                {/* All pages share AppLayout (top nav bar) */}\n                <Route element={<AppLayoutRoute />}>\n\n                  {/* Entry point — Home at root '/' */}\n                  <Route index element={<Home />} />\n\n                  {/* Main nav pages */}\n                  <Route path=\"/about\" element={<About />} />\n                  <Route path=\"/services\" element={<Services />} />\n                  <Route path=\"/projects\" element={<Projects />} />\n                  <Route path=\"/technology\" element={<Technology />} />\n                  <Route path=\"/industries\" element={<Industries />} />\n                  <Route path=\"/contact\" element={<Contact />} />\n\n                  {/* Services sub-pages — not shown in nav */}\n                  <Route\n                    path=\"/services/hydraulic-network-modeling\"\n                    element={<HydraulicNetworkModeling />}\n                  />\n                  <Route\n                    path=\"/services/water-treatment-plant-design\"\n                    element={<WaterTreatmentPlantDesign />}\n                  />\n                  <Route\n                    path=\"/services/sewage-treatment-plant-design\"\n                    element={<SewageTreatmentPlantDesign />}\n                  />\n                  <Route\n                    path=\"/services/gis-integration\"\n                    element={<GISIntegration />}\n                  />\n                  <Route\n                    path=\"/services/environmental-and-irrigation-consulting\"\n                    element={<EnvironmentalAndIrrigationConsulting />}\n                  />\n\n                  {/* Project detail sub-page — dynamic segment, not in nav */}\n                  <Route path=\"/projects/:id\" element={<ProjectDetail />} />\n\n                  {/* Catch-all redirect to home */}\n                  <Route path=\"*\" element={<Navigate to=\"/\" replace />} />\n\n                </Route>\n              </Routes>\n              <BuiltBy />\n            </BrowserRouter>\n          </ErrorBoundary>\n        </ThemeProvider>\n      </CustomToastProvider>\n    </TooltipProvider>\n  </QueryClientProvider>\n);\n\nexport default App;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1519,"cache_read_input_tokens":30294,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1519},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"572f6923-00ff-4cf3-9331-5f53f98a9735","uuid":"523e9608-2b5c-4cd0-b5ad-42eee500cb32"}
