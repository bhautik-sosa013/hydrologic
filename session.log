                 <div className=\"h-12 w-12 rounded-lg bg-green-600/10 flex items-center justify-center mb-4\">\n357\t                    <sector.icon className=\"h-6 w-6 text-green-600\" />\n358\t                  </div>\n359\t                  <CardTitle className=\"text-xl\">{sector.title}</CardTitle>\n360\t                </CardHeader>\n361\t                <CardContent>\n362\t                  <CardDescription className=\"text-base leading-relaxed mb-4\">\n363\t                    {sector.description}\n364\t                  </CardDescription>\n365\t                  <div className=\"space-y-2\">\n366\t                    {sector.metrics.map((metric) => (\n367\t                      <div key={metric} className=\"flex items-center gap-2 text-sm\">\n368\t                        <CheckCircle2 className=\"h-4 w-4 text-green-600 flex-shrink-0\" />\n369\t                        <span>{metric}</span>\n370\t                      </div>\n371\t                    ))}\n372\t                  </div>\n373\t                </CardContent>\n374\t              </Card>\n375\t            ))}\n376\t          </div>\n377\t        </div>\n378\t      </section>\n379\t\n380\t      <Separator />\n381\t\n382\t      {/* ── Methodology Section ────────────────────────────────────────── */}\n383\t      <section className=\"w-full py-16 md:py-24\">\n384\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n385\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n386\t            <Badge variant=\"secondary\" className=\"mb-4\">\n387\t              Our Process\n388\t            </Badge>\n389\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n390\t              Proven Methodology\n391\t            </h2>\n392\t            <p className=\"text-muted-foreground text-lg\">\n393\t              A systematic four-phase approach ensures comprehensive assessments and\n394\t              implementation-ready solutions for every proj