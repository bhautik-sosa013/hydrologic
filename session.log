ps://images.unsplash.com/photo-1449034446853-66c86144b0ad?w=600&h=400&fit=crop',\n279\t    created_at: '2023-04-20T09:30:00Z',\n280\t  },\n281\t  {\n282\t    id: 'proj-019',\n283\t    title: 'Sewer Network Asset Management GIS Platform',\n284\t    client: 'London Borough of Lambeth',\n285\t    sector: 'Urban Infrastructure',\n286\t    project_type: 'GIS Integration',\n287\t    challenge_summary: 'Built an enterprise GIS platform integrating CCTV inspection data, asset condition scores, and failure prediction models to optimize $45M annual capital renewal budget.',\n288\t    location: 'London, United Kingdom',\n289\t    year: '2024',\n290\t    thumbnail_url: 'https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?w=600&h=400&fit=crop',\n291\t    created_at: '2024-01-15T15:00:00Z',\n292\t  },\n293\t  {\n294\t    id: 'proj-020',\n295\t    title: 'Rice Farm Subsurface Drip Irrigation',\n296\t    client: 'Syserco Agricultural Development',\n297\t    sector: 'Agriculture',\n298\t    project_type: 'Irrigation',\n299\t    challenge_summary: 'Designed and commissioned SDI systems for 3,200 hectares of rice cultivation in the Sacramento Valley, achieving 55% water savings versus conventional flood irrigation.',\n300\t    location: 'Willows, California, USA',\n301\t    year: '2023',\n302\t    thumbnail_url: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=600&h=400&fit=crop',\n303\t    created_at: '2023-07-28T12:15:00Z',\n304\t  },\n305\t  {\n306\t    id: 'proj-021',\n307\t    title: 'Water Treatment Plant Residuals Management',\n308\t    client: 'New York City Department of Environmental Protection',\n309\t    sector: 'Government',\n310\t    project_type: 'WTP Design',\n311\t    challenge_summary: 'Designed thickened sludge handling and filter press dewatering facilities for three major WTPs, reducing residuals volume by 70% and lowering disposal costs.',\n312\t    location: 'New York City, New York, USA',\n313\t    year: '2024',\n314\t    thumbnail_url: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&h=400&fit=crop',\n315\t    created_at: '2024-02-05T14:00:00Z',\n316\t  },\n317\t  {\n318\t    id: 'proj-022',\n319\t    title: 'HVAC Condensate Recovery Hydraulic Analysis',\n320\t    client: 'Google Data Centers',\n321\t    sector: 'Industrial',\n322\t    project_type: 'Hydraulic Modeling',\n323\t    challenge_summary: 'Performed hydraulic analysis of rooftop condensate recovery systems across 12 data center facilities, enabling 18 MLD of recovered water for cooling tower makeup.',\n324\t    location: 'The Dalles, Oregon, USA',\n325\t    year: '2023',\n326\t    thumbnail_url: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop',\n327\t    created_at: '2023-11-08T10:45:00Z',\n328\t  },\n329\t  {\n330\t    id: 'proj-023',\n331\t    title: 'Constructed Wetland for Secondary Effluent Polishing',\n332\t    client: 'Town of Queen Creek',\n333\t    sector: 'Government',\n334\t    project_type: 'Environmental Consulting',\n335\t    challenge_summary: 'Designed a 12-hectare surface flow constructed wetland providing tertiary treatment for treated wastewater, creating wildlife habitat and public recreation space.',\n336\t    location: 'Queen Creek, Arizona, USA',\n337\t    year: '2024',\n338\t    thumbnail_url: 'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&h=400&fit=crop',\n339\t    created_at: '2024-03-22T09:00:00Z',\n340\t  },\n341\t  {\n342\t    id: 'proj-024',\n343\t    title: 'Regional Drainage Master Plan',\n344\t    client: 'Ontario Ministry of Infrastructure',\n345\t    sector: 'Government',\n346\t    project_type: 'Hydraulic Modeling',\n347\t    challenge_summary: 'Developed a 50-year drainage master plan using coupled 1D/2D models to evaluate climate change impacts and prioritize $3.8B in infrastructure investments.',\n348\t    location: 'Greater Toronto Area, Ontario, Canada',\n349\t    year: '2023',\n350\t    thumbnail_url: 'https://images.unsplash.com/photo-1518167628171-60c5ef9b4a3c?w=600&h=400&fit=crop',\n351\t    created_at: '2023-09-14T11:30:00Z',\n352\t  },\n353\t  {\n354\t    id: 'proj-025',\n355\t    title: 'Brackish Groundwater Desalination for Agriculture',\n356\t    client: 'Imperial Irrigation District',\n357\t    sector: 'Agriculture',\n358\t    project_type: 'WTP Design',\n359\t    challenge_summary: 'Designed a 3 MLD brackish groundwater RO system providing drought-resilient irrigation water supply, featuring boron-selective membranes for crop safety.',\n360\t    location: 'Imperial Valley, California, USA',\n361\t    year: '2024',\n362\t    thumbnail_url: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=600&h=400&fit=crop',\n363\t    created_at: '2024-04-05T08:00:00Z',\n364\t  },\n365\t  {\n366\t    id: 'proj-026',\n367\t    title: 'Combined Sewer Overflow Long-Term Control Plan',\n368\t    client: 'DC Water',\n369\t    sector: 'Urban Infrastructure',\n370\t    project_type: 'STP Design',\n371\t    challenge_summary: 'Developed a 25-year LTCP using real-time control sensors and storage tunnels to reduce CSO events by 94%, meeting EPA consent decree requirements.',\n372\t    location: 'Washington, D.C., USA',\n373\t    year: '2023',\n374\t    thumbnail_url: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=600&h=400&fit=crop',\n375\t    created_at: '2023-06-22T14:30:00Z',\n376\t  },\n377\t  {\n378\t    id: 'proj-027',\n379\t    title: 'Mobile Water Treatment Unit for Emergency Response',\n380\t    client: 'International Red Cross / Red Crescent',\n381\t    sector: 'Government',\n382\t    project_type: 'WTP Design',\n383\t    challenge_summary: 'Engineered a containerized 500 m³/day mobile WTP with rapid deployment capability for emergency water supply in disaster-affected regions.',\n384\t    location: 'Geneva, Switzerland (Global Deployment)',\n385\t    year: '2024',\n386\t    thumbnail_url: 'https://images.unsplash.com/photo-1552084117-56a987666889?w=600&h=400&fit=crop',\n387\t    created_at: '2024-01-30T10:00:00Z',\n388\t  },\n389\t  {\n390\t    id: 'proj-028',\n391\t    title: 'Vineyard Micro-Irrigation System Upgrade',\n392\t    client: 'Robert Mondavi Winery',\n393\t    sector: 'Agriculture',\n394\t    project_type: 'Irrigation',\n395\t    challenge_summary: 'Retrofit 800 acres of premium vineyard blocks with pressure-compensating drippers and wireless soil moisture monitoring, improving yield uniformity by 35%.',\n396\t    location: 'Napa Valley, California, USA',\n397\t    year: '2023',\n398\t    thumbnail_url: 'https://images.unsplash.com/photo-1474722883778-792e7990302f?w=600&h=400&fit=crop',\n399\t    created_at: '2023-05-12T13:45:00Z',\n400\t  },\n401\t  {\n402\t    id: 'proj-029',\n403\t    title: 'Water Utility SCADA-EMS Integration',\n404\t    client: 'Bay Area Water Supply & Conservation Agency',\n405\t    sector: 'Urban Infrastructure',\n406\t    project_type: 'GIS Integration',\n407\t    challenge_summary: 'Integrated 14 SCADA systems with an enterprise GIS and energy management platform, enabling real-time optimization of pump schedules across 8 member agencies.',\n408\t    location: 'San Francisco Bay Area, California, USA',\n409\t    year: '2024',\n410\t    thumbnail_url: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop',\n411\t    created_at: '2024-03-01T11:00:00Z',\n412\t  },\n413\t  {\n414\t    id: 'proj-030',\n415\t    title: 'Aquifer Storage and Recovery Feasibility Study',\n416\t    client: 'Orange County Water District',\n417\t    sector: 'Government',\n418\t    project_type: 'Environmental Consulting',\n419\t    challenge_summary: 'Conducted field-scale ASR feasibility assessment including water quality compatibility testing, recovered water credit accounting, and monitoring well network design.',\n420\t    location: 'Orange County, California, USA',\n421\t    year: '2023',\n422\t    thumbnail_url: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&h=400&fit=crop',\n423\t    created_at: '2023-10-25T09:30:00Z',\n424\t  },\n425\t];\n426\t\n427\t// ── Helper to fetch paginated/filtered projects ───────────────────────────────\n428\t\n429\tinterface FetchProjectsParams {\n430\t  page: number;\n431\t  limit: number;\n432\t  sector: string;\n433\t  projectType: string;\n434\t}\n435\t\n436\tinterface FetchProjectsResult {\n437\t  message: string;\n438\t  data: Project[];\n439\t  total: number;\n440\t  page: number;\n441\t  limit: number;\n442\t  totalPages: number;\n443\t}\n444\t\n445\t/**\n446\t * Fetches paginated and filtered project list (mock implementation).\n447\t * In production, replace with:\n448\t *\n449\t * TODO: Real API binding\n450\t * import { apiService } from '@/lib/api';\n451\t * const response = await apiService.get({\n452\t *   endpoint: '/projects/list',\n453\t *   params: { page, limit, sector, project_type: projectType },\n454\t * });\n455\t * return response.data;\n456\t */\n457\tconst fetchProjects = async (params: FetchProjectsParams): Promise<FetchProjectsResult> => {\n458\t  // Simulate network delay\n459\t  await new Promise((resolve) => setTimeout(resolve, 300));\n460\t\n461\t  const { page, limit, sector, projectType } = params;\n462\t\n463\t  let filtered = MOCK_PROJECTS;\n464\t\n465\t  // Apply sector filter\n466\t  if (sector) {\n467\t    filtered = filtered.filter((p) => p.sector === sector);\n468\t  }\n469\t\n470\t  // Apply project type filter\n471\t  if (projectType) {\n472\t    filtered = filtered.filter((p) => p.project_type === projectType);\n473\t  }\n474\t\n475\t  const total = filtered.length;\n476\t  const totalPages = Math.ceil(total / limit);\n477\t  const startIndex = (page - 1) * limit;\n478\t  const paginatedData = filtered.slice(startIndex, startIndex + limit);\n479\t\n480\t  return {\n481\t    message: 'Projects retrieved successfully',\n482\t    data: paginatedData,\n483\t    total,\n484\t    page,\n485\t    limit,\n486\t    totalPages,\n487\t  };\n488\t};\n489\t\n490\t// ── Projects Page ─────────────────────────────────────────────────────────────\n491\t\n492\tconst Projects = () => {\n493\t  const navigate = useNavigate();\n494\t\n495\t  // Filter/sort state\n496\t  const [page, setPage] = useState(1);\n497\t  const [sector, setSector] = useState('');\n498\t  const [projectType, setProjectType] = useState('');\n499\t\n500\t  // Data state\n501\t  const [projectsData, setProjectsData] = useState<FetchProjectsResult | null>(null);\n502\t  const [isLoading, setIsLoading] = useState(true);\n503\t\n504\t  // Fetch projects when filters or page change\n505\t  useMemo(() => {\n506\t    setIsLoading(true);\n507\t    fetchProjects({ page, limit: PAGE_SIZE, sector, projectType })\n508\t      .then((result) => {\n509\t        setProjectsData(result);\n510\t        setIsLoading(false);\n511\t      })\n512\t      .catch(() => {\n513\t        toast.error('Failed to load projects');\n514\t        setIsLoading(false);\n515\t      });\n516\t  }, [page, sector, projectType]);\n517\t\n518\t  // Reset to page 1 when filter changes\n519\t  const handleSectorChange = (value: string) => {\n520\t    setSector(value);\n521\t    setPage(1);\n522\t  };\n523\t\n524\t  const handleProjectTypeChange = (value: string) => {\n525\t    setProjectType(value);\n526\t    setPage(1);\n527\t  };\n528\t\n529\t  const handleClearFilters = () => {\n530\t    setSector('');\n531\t    setProjectType('');\n532\t    setPage(1);\n533\t  };\n534\t\n535\t  const hasActiveFilters = sector || projectType;\n536\t\n537\t  // Generate pagination items\n538\t  const getPaginationItems = () => {\n539\t    if (!projectsData) return [];\n540\t    const { totalPages } = projectsData;\n541\t    const items: (number | 'ellipsis' | 'previous' | 'next')[] = [];\n542\t\n543\t    if (totalPages <= 7) {\n544\t      for (let i = 1; i <= totalPages; i++) items.push(i);\n545\t    } else {\n546\t      items.push(1);\n547\t      if (page > 3) items.push('ellipsis');\n548\t      for (let i = Math.max(2, page - 1); i <= Math.min(totalPages - 1, page + 1); i++) {\n549\t        items.push(i);\n550\t      }\n551\t      if (page < totalPages - 2) items.push('ellipsis');\n552\t      items.push(totalPages);\n553\t    }\n554\t\n555\t    return items;\n556\t  };\n557\t\n558\t  return (\n559\t    <div className=\"min-h-screen\">\n560\t      {/* ── Page Header ────────────────────────────────────────────────── */}\n561\t      <section className=\"bg-muted/30 py-16 md:py-24\">\n562\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n563\t          <div className=\"text-center max-w-3xl mx-auto\">\n564\t            <h1 className=\"text-4xl md:text-5xl font-bold tracking-tight mb-4\">\n565\t              Our Projects\n566\t            </h1>\n567\t            <p className=\"text-lg text-muted-foreground\">\n568\t              Explore Hydrologic Innovation's portfolio of completed and ongoing engineering\n569\t              projects. Each case study demonstrates our expertise in solving complex water\n570\t              infrastructure challenges across diverse sectors.\n571\t            </p>\n572\t          </div>\n573\t        </div>\n574\t      </section>\n575\t\n576\t      {/* ── Filters ───────────────────────────────────────────────────── */}\n577\t      <section className=\"border-b bg-card/50\">\n578\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4\">\n579\t          <div className=\"flex flex-wrap items-center gap-4\">\n580\t            {/* Sector Filter */}\n581\t            <div className=\"flex items-center gap-2\">\n582\t              <span className=\"text-sm font-medium text-muted-foreground\">Sector:</span>\n583\t              <Select value={sector} onValueChange={handleSectorChange}>\n584\t                <SelectTrigger className=\"w-[200px]\">\n585\t                  <SelectValue placeholder=\"All Sectors\" />\n586\t                </SelectTrigger>\n587\t                <SelectContent>\n588\t                  {SECTOR_OPTIONS.map((opt) => (\n589\t                    <SelectItem key={opt.value} value={opt.value}>\n590\t                      {opt.label}\n591\t                    </SelectItem>\n592\t                  ))}\n593\t                </SelectContent>\n594\t              </Select>\n595\t            </div>\n596\t\n597\t            {/* Project Type Filter */}\n598\t            <div className=\"flex items-center gap-2\">\n599\t              <span className=\"text-sm font-medium text-muted-foreground\">Type:</span>\n600\t              <Select value={projectType} onValueChange={handleProjectTypeChange}>\n601\t                <SelectTrigger className=\"w-[220px]\">\n602\t                  <SelectValue placeholder=\"All Project Types\" />\n603\t                </SelectTrigger>\n604\t                <SelectContent>\n605\t                  {PROJECT_TYPE_OPTIONS.map((opt) => (\n606\t                    <SelectItem key={opt.value} value={opt.value}>\n607\t                      {opt.label}\n608\t                    </SelectItem>\n609\t                  ))}\n610\t                </SelectContent>\n611\t              </Select>\n612\t            </div>\n613\t\n614\t            {/* Clear Filters */}\n615\t            {hasActiveFilters && (\n616\t              <Button\n617\t                variant=\"ghost\"\n618\t                size=\"sm\"\n619\t                onClick={handleClearFilters}\n620\t                className=\"text-muted-foreground hover:text-foreground\"\n621\t              >\n622\t                <X className=\"h-4 w-4 mr-1\" />\n623\t                Clear filters\n624\t              </Button>\n625\t            )}\n626\t\n627\t            {/* Results count */}\n628\t            {projectsData && (\n629\t              <div className=\"ml-auto text-sm text-muted-foreground\">\n630\t                {projectsData.total} project{projectsData.total !== 1 ? 's' : ''} found\n631\t              </div>\n632\t            )}\n633\t          </div>\n634\t        </div>\n635\t      </section>\n636\t\n637\t      {/* ── Projects Grid ───────────────────────────────────────────────── */}\n638\t      <section className=\"py-12 md:py-16\">\n639\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n640\t          {isLoading ? (\n641\t            // Loading skeleton\n642\t            <div className=\"grid gap-6 md:grid-cols-2 lg:grid-cols-3\">\n643\t              {Array.from({ length: PAGE_SIZE }).map((_, i) => (\n644\t                <Card key={i} className=\"overflow-hidden\">\n645\t                  <div className=\"h-48 bg-muted animate-pulse\" />\n646\t                  <CardHeader>\n647\t                    <div className=\"h-6 bg-muted animate-pulse rounded w-3/4 mb-2\" />\n648\t                    <div className=\"h-4 bg-muted animate-pulse rounded w-1/2\" />\n649\t                  </CardHeader>\n650\t                  <CardContent>\n651\t                    <div className=\"h-4 bg-muted animate-pulse rounded w-full mb-2\" />\n652\t                    <div className=\"h-4 bg-muted animate-pulse rounded w-2/3\" />\n653\t                  </CardContent>\n654\t                </Card>\n655\t              ))}\n656\t            </div>\n657\t          ) : projectsData?.data.length === 0 ? (\n658\t            // Empty state\n659\t            <div className=\"text-center py-16\">\n660\t              <Filter className=\"h-12 w-12 text-muted-foreground mx-auto mb-4\" />\n661\t              <h3 className=\"text-lg font-semibold mb-2\">No projects found</h3>\n662\t              <p className=\"text-muted-foreground mb-4\">\n663\t                Try adjusting your filters to see more results.\n664\t              </p>\n665\t              {hasActiveFilters && (\n666\t                <Button variant=\"outline\" onClick={handleClearFilters}>\n667\t                  Clear all filters\n668\t                </Button>\n669\t              )}\n670\t            </div>\n671\t          ) : (\n672\t            // Project cards grid\n673\t            <div className=\"grid gap-6 md:grid-cols-2 lg:grid-cols-3\">\n674\t              {projectsData?.data.map((project) => (\n675\t                <Card\n676\t                  key={project.id}\n677\t                  className=\"group cursor-pointer overflow-hidden hover:shadow-lg transition-all duration-300 hover:-translate-y-1\"\n678\t                  onClick={() => navigate(`/projects/${project.id}`)}\n679\t                >\n680\t                  {/* Thumbnail */}\n681\t                  <div className=\"relative h-48 overflow-hidden\">\n682\t                    <img\n683\t                      src={project.thumbnail_url}\n684\t                      alt={project.title}\n685\t                      className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n686\t                    />\n687\t                    <div className=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent\" />\n688\t                    <Badge className=\"absolute top-3 left-3 bg-background/90 backdrop-blur-sm hover:bg-background/90\">\n689\t                      {project.project_type}\n690\t                    </Badge>\n691\t                  </div>\n692\t\n693\t                  {/* Content */}\n694\t                  <CardHeader>\n695\t                    <div className=\"flex items-start justify-between gap-2\">\n696\t                      <CardTitle className=\"text-lg leading-tight line-clamp-2\">\n697\t                        {project.title}\n698\t                      </CardTitle>\n699\t                      <ArrowRight className=\"h-5 w-5 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity shrink-0 -mt-1\" />\n700\t                    </div>\n701\t                    <CardDescription className=\"flex items-center gap-1\">\n702\t                      <Building2 className=\"h-3.5 w-3.5\" />\n703\t                      {project.client}\n704\t                    </CardDescription>\n705\t                  </CardHeader>\n706\t\n707\t                  <CardContent>\n708\t                    <p className=\"text-sm text-muted-foreground line-clamp-3 mb-4\">\n709\t                      {project.challenge_summary}\n710\t                    </p>\n711\t\n712\t                    {/* Meta info */}\n713\t                    <div className=\"flex flex-wrap gap-3 text-xs text-muted-foreground\">\n714\t                      <div className=\"flex items-center gap-1\">\n715\t                        <MapPin className=\"h-3.5 w-3.5\" />\n716\t                        {project.location}\n717\t                      </div>\n718\t                      <div className=\"flex items-center gap-1\">\n719\t                        <Calendar className=\"h-3.5 w-3.5\" />\n720\t                        {project.year}\n721\t                      </div>\n722\t                    </div>\n723\t\n724\t                    {/* Sector badge */}\n725\t                    <div className=\"mt-3 pt-3 border-t\">\n726\t                      <Badge variant=\"secondary\" className=\"text-xs\">\n727\t                        {project.sector}\n728\t                      </Badge>\n729\t                    </div>\n730\t                  </CardContent>\n731\t                </Card>\n732\t              ))}\n733\t            </div>\n734\t          )}\n735\t\n736\t          {/* ── Pagination ───────────────────────────────────────────────── */}\n737\t          {projectsData && projectsData.totalPages > 1 && (\n738\t            <div className=\"mt-12\">\n739\t              <Pagination>\n740\t                <PaginationContent>\n741\t                  <PaginationItem>\n742\t                    <PaginationPrevious\n743\t                      onClick={() => setPage((p) => Math.max(1, p - 1))}\n744\t                      className={cn(\n745\t                        page === 1 && 'pointer-events-none opacity-50'\n746\t                      )}\n747\t                    />\n748\t                  </PaginationItem>\n749\t\n750\t                  {getPaginationItems().map((item, idx) =>\n751\t                    item === 'ellipsis' ? (\n752\t                      <PaginationItem key={`ellipsis-${idx}`}>\n753\t                        <PaginationEllipsis />\n754\t                      </PaginationItem>\n755\t                    ) : (\n756\t                      <PaginationItem key={item}>\n757\t                        <PaginationLink\n758\t                          isActive={page === item}\n759\t                          onClick={() => setPage(item)}\n760\t                        >\n761\t                          {item}\n762\t                        </PaginationLink>\n763\t                      </PaginationItem>\n764\t                    )\n765\t                  )}\n766\t\n767\t                  <PaginationItem>\n768\t                    <PaginationNext\n769\t                      onClick={() => setPage((p) => Math.min(projectsData.totalPages, p + 1))}\n770\t                      className={cn(\n771\t                        page === projectsData.totalPages && 'pointer-events-none opacity-50'\n772\t                      )}\n773\t                    />\n774\t                  </PaginationItem>\n775\t                </PaginationContent>\n776\t              </Pagination>\n777\t            </div>\n778\t          )}\n779\t        </div>\n780\t      </section>\n781\t\n782\t      {/* ── CTA Section ────────────────────────────────────────────────── */}\n783\t      <section className=\"bg-muted/30 py-12\">\n784\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center\">\n785\t          <h2 className=\"text-2xl font-semibold mb-3\">\n786\t            Have a project in mind?\n787\t          </h2>\n788\t          <p className=\"text-muted-foreground max-w-2xl mx-auto mb-6\">\n789\t            Our engineering team is ready to help you tackle your most complex water infrastructure\n790\t            challenges. Schedule a free consultation to discuss your needs.\n791\t          </p>\n792\t          <Button onClick={() => navigate('/contact')} size=\"lg\">\n793\t            Get in Touch\n794\t            <ArrowRight className=\"ml-2 h-4 w-4\" />\n795\t          </Button>\n796\t        </div>\n797\t      </section>\n798\t    </div>\n799\t  );\n800\t};\n801\t\n802\texport default Projects;"}]},"parent_tool_use_id":null,"session_id":"a7acff44-f104-4b18-a19d-824b8719d3af","uuid":"b4098847-8eaf-4a50-b39c-54bb0c35f6be","timestamp":"2026-04-18T17:20:01.571Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/code/project-code/code_base/app_7a97b333c52f0a2e89b9d85da46ab74b/frontend/src/pages/Projects.tsx","content":"import { useState, useMemo } from 'react';\nimport { useNavigate } from 'react-router-dom';\nimport { ArrowRight, MapPin, Calendar, Building2, Filter, X } from 'lucide-react';\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from '@/components/ui/card';\nimport { Button } from '@/components/ui/button';\nimport { Badge } from '@/components/ui/badge';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport {\n  Pagination,\n  PaginationContent,\n  PaginationEllipsis,\n  PaginationItem,\n  PaginationLink,\n  PaginationNext,\n  PaginationPrevious,\n} from '@/components/ui/pagination';\nimport { toast } from '@/lib/toast';\nimport { cn } from '@/lib/utils';\n\n// TODO: fetch from backend config API when available\nconst SECTOR_OPTIONS = [\n  { value: '', label: 'All Sectors' },\n  { value: 'Urban Infrastructure', label: 'Urban Infrastructure' },\n  { value: 'Government', label: 'Government' },\n  { value: 'Real Estate', label: 'Real Estate' },\n  { value: 'Industrial', label: 'Industrial' },\n  { value: 'Agriculture', label: 'Agriculture' },\n];\n\n// TODO: fetch from backend config API when available\nconst PROJECT_TYPE_OPTIONS = [\n  { value: '', label: 'All Project Types' },\n  { value: 'Hydraulic Modeling', l