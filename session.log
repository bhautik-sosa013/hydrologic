{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_xg6w6znepitv_13","type":"tool_result","content":"1\timport { useState } from 'react';\n2\timport {\n3\t  Mail,\n4\t  Phone,\n5\t  MapPin,\n6\t  Calendar,\n7\t  ArrowRight,\n8\t  Droplets,\n9\t  Clock,\n10\t  Send,\n11\t  CheckCircle2,\n12\t} from 'lucide-react';\n13\timport { Button } from '@/components/ui/button';\n14\timport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n15\timport { Input } from '@/components/ui/input';\n16\timport { Textarea } from '@/components/ui/textarea';\n17\timport { Label } from '@/components/ui/label';\n18\timport { Badge } from '@/components/ui/badge';\n19\timport { Separator } from '@/components/ui/separator';\n20\timport {\n21\t  Dialog,\n22\t  DialogContent,\n23\t  DialogDescription,\n24\t  DialogFooter,\n25\t  DialogHeader,\n26\t  DialogTitle,\n27\t  DialogTrigger,\n28\t} from '@/components/ui/dialog';\n29\timport { toast } from '@/lib/toast';\n30\t\n31\t// RFC 5322 email validation regex\n32\tconst EMAIL_REGEX = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;\n33\t\n34\t// International phone validation (e.g., +91-XXXXXXXXXX)\n35\tconst PHONE_REGEX = /^\\+?[1-9]\\d{1,14}$|^\\+\\d{2}-\\d{10}$/;\n36\t\n37\t// Contact form payload type\n38\tinterface ContactFormData {\n39\t  name: string;\n40\t  email: string;\n41\t  phone: string;\n42\t  project_details: string;\n43\t}\n44\t\n45\t// Mock response type\n46\tinterface ContactResponse {\n47\t  message: string;\n48\t  data: {\n49\t    id: string;\n50\t  };\n51\t}\n52\t\n53\t// Mock office contact information\n54\tconst OFFICE_INFO = {\n55\t  address: 'Hydrologic Innovation Pvt. Ltd.',\n56\t  street: 'Plot No. 45, IT Park Road',\n57\t  area: 'Sector 62, Industrial Area',\n58\t  city: 'Noida',\n59\t  state: 'Uttar Pradesh',\n60\t  pincode: '201301',\n61\t  country: 'India',\n62\t  email: 'contact@hydrologicinnovation.com',\n63\t  phone: '+91-9876543210',\n64\t  alternatePhone: '+91-120-4567890',\n65\t  workingHours: 'Monday - Saturday: 9:00 AM - 6:00 PM',\n66\t};\n67\t\n68\t// Mock data for form submission response\n69\tconst MOCK_SUBMISSION_RESPONSE: ContactResponse = {\n70\t  message: 'Thank you for your inquiry. Our team will get back to you within 24 hours.',\n71\t  data: {\n72\t    id: 'inq-' + Date.now(),\n73\t  },\n74\t};\n75\t\n76\tconst Contact = () => {\n77\t  const [isDialogOpen, setIsDialogOpen] = useState(false);\n78\t  const [isSubmitting, setIsSubmitting] = useState(false);\n79\t  const [formData, setFormData] = useState<ContactFormData>({\n80\t    name: '',\n81\t    email: '',\n82\t    phone: '',\n83\t    project_details: '',\n84\t  });\n85\t  const [errors, setErrors] = useState<Partial<Record<keyof ContactFormData, string>>>({});\n86\t\n87\t  const validateForm = (): boolean => {\n88\t    const newErrors: Partial<Record<keyof ContactFormData, string>> = {};\n89\t\n90\t    // Name validation\n91\t    if (!formData.name.trim()) {\n92\t      newErrors.name = 'Name is required';\n93\t    } else if (formData.name.length > 100) {\n94\t      newErrors.name = 'Name must be 100 characters or less';\n95\t    }\n96\t\n97\t    // Email validation\n98\t    if (!formData.email.trim()) {\n99\t      newErrors.email = 'Email is required';\n100\t    } else if (!EMAIL_REGEX.test(formData.email)) {\n101\t      newErrors.email = 'Please enter a valid email address';\n102\t    }\n103\t\n104\t    // Phone validation\n105\t    if (!formData.phone.trim()) {\n106\t      newErrors.phone = 'Phone number is required';\n107\t    } else if (!PHONE_REGEX.test(formData.phone.replace(/\\s/g, ''))) {\n108\t      newErrors.phone = 'Please enter a valid phone number (e.g., +91-9876543210)';\n109\t    }\n110\t\n111\t    // Project details validation\n112\t    if (!formData.project_details.trim()) {\n113\t      newErrors.project_details = 'Project details are required';\n114\t    } else if (formData.project_details.length > 2000) {\n115\t      newErrors.project_details = 'Project details must be 2000 characters or less';\n116\t    }\n117\t\n118\t    setErrors(newErrors);\n119\t    return Object.keys(newErrors).length === 0;\n120\t  };\n121\t\n122\t  const handleInputChange = (\n123\t    e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>\n124\t  ) => {\n125\t    const { name, value } = e.target;\n126\t    setFormData((prev) => ({ ...prev, [name]: value }));\n127\t    // Clear error when user starts typing\n128\t    if (errors[name as keyof ContactFormData]) {\n129\t      setErrors((prev) => ({ ...prev, [name]: undefined }));\n130\t    }\n131\t  };\n132\t\n133\t  const handleSubmit = async (e: React.FormEvent) => {\n134\t    e.preventDefault();\n135\t\n136\t    if (!validateForm()) {\n137\t      return;\n138\t    }\n139\t\n140\t    setIsSubmitting(true);\n141\t\n142\t    /*\n143\t     * TODO: Real API binding\n144\t     * import { apiService } from '@/lib/api';\n145\t     * const response = await apiService.post({\n146\t     *   endpoint: '/contact/submit',\n147\t     *   body: formData,\n148\t     * });\n149\t     * const result: ContactResponse = response.data;\n150\t     * toast.success(result.message);\n151\t     * setIsDialogOpen(false);\n152\t     * setFormData({ name: '', email: '', phone: '', project_details: '' });\n153\t     */\n154\t\n155\t    // Mock submission delay\n156\t    await new Promise((resolve) => setTimeout(resolve, 1000));\n157\t\n158\t    // Mock success response\n159\t    toast.success(MOCK_SUBMISSION_RESPONSE.message, {\n160\t      description: `Reference ID: ${MOCK_SUBMISSION_RESPONSE.data.id}`,\n161\t    });\n162\t\n163\t    setIsDialogOpen(false);\n164\t    setFormData({ name: '', email: '', phone: '', project_details: '' });\n165\t    setIsSubmitting(false);\n166\t  };\n167\t\n168\t  const handleOpenDialog = () => {\n169\t    setFormData({ name: '', email: '', phone: '', project_details: '' });\n170\t    setErrors({});\n171\t    setIsDialogOpen(true);\n172\t  };\n173\t\n174\t  return (\n175\t    <div className=\"min-h-screen\">\n176\t      {/* Hero Section */}\n177\t      <section className=\"relative w-full bg-gradient-to-br from-primary/10 via-background to-primary/5 py-16 md:py-24\">\n178\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n179\t          <div className=\"flex flex-col items-center text-center max-w-3xl mx-auto\">\n180\t            <Badge variant=\"secondary\" className=\"mb-4 bg-primary/10 text-primary border-primary/20\">\n181\t              <Droplets className=\"mr-1 h-3 w-3\" />\n182\t              Get in Touch\n183\t            </Badge>\n184\t            <h1 className=\"text-3xl md:text-5xl font-bold tracking-tight text-foreground\">\n185\t              Contact Hydrologic Innovation\n186\t            </h1>\n187\t            <p className=\"mt-4 text-lg text-muted-foreground leading-relaxed\">\n188\t              Ready to transform your water infrastructure? Schedule a consultation with our\n189\t              engineering team to discuss your project requirements and discover how we can help.\n190\t            </p>\n191\t          </div>\n192\t        </div>\n193\t      </section>\n194\t\n195\t      {/* Contact Info Cards Section */}\n196\t      <section className=\"py-16 md:py-20\">\n197\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n198\t          <div className=\"grid md:grid-cols-3 gap-6\">\n199\t            {/* Email Card */}\n200\t            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5 hover:shadow-lg transition-shadow\">\n201\t              <CardHeader className=\"pb-2\">\n202\t                <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n203\t                  <Mail className=\"h-6 w-6 text-primary\" />\n204\t                </div>\n205\t                <CardTitle className=\"text-xl\">Email Us</CardTitle>\n206\t                <CardDescription>For general inquiries and support</CardDescription>\n207\t              </CardHeader>\n208\t              <CardContent>\n209\t                <div className=\"space-y-2\">\n210\t                  <p className=\"text-sm font-medium\">{OFFICE_INFO.email}</p>\n211\t                  <p className=\"text-sm text-muted-foreground\">\n212\t                    We respond within 24 business hours\n213\t                  </p>\n214\t                </div>\n215\t              </CardContent>\n216\t            </Card>\n217\t\n218\t            {/* Phone Card */}\n219\t            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5 hover:shadow-lg transition-shadow\">\n220\t              <CardHeader className=\"pb-2\">\n221\t                <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n222\t                  <Phone className=\"h-6 w-6 text-primary\" />\n223\t                </div>\n224\t                <CardTitle className=\"text-xl\">Call Us</CardTitle>\n225\t                <CardDescription>Speak with our team directly</CardDescription>\n226\t              </CardHeader>\n227\t              <CardContent>\n228\t                <div className=\"space-y-2\">\n229\t                  <p className=\"text-sm font-medium\">{OFFICE_INFO.phone}</p>\n230\t                  <p className=\"text-sm font-medium text-muted-foreground\">\n231\t                    {OFFICE_INFO.alternatePhone}\n232\t                  </p>\n233\t                </div>\n234\t              </CardContent>\n235\t            </Card>\n236\t\n237\t            {/* Office Location Card */}\n238\t            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5 hover:shadow-lg transition-shadow\">\n239\t              <CardHeader className=\"pb-2\">\n240\t                <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n241\t                  <MapPin className=\"h-6 w-6 text-primary\" />\n242\t                </div>\n243\t                <CardTitle className=\"text-xl\">Visit Us</CardTitle>\n244\t                <CardDescription>Our headquarters location</CardDescription>\n245\t              </CardHeader>\n246\t              <CardContent>\n247\t                <div className=\"space-y-1\">\n248\t                  <p className=\"text-sm font-medium\">{OFFICE_INFO.address}</p>\n249\t                  <p className=\"text-sm text-muted-foreground\">\n250\t                    {OFFICE_INFO.street}\n251\t                  </p>\n252\t                  <p className=\"text-sm text-muted-foreground\">\n253\t                    {OFFICE_INFO.area}\n254\t                  </p>\n255\t                  <p className=\"text-sm text-muted-foreground\">\n256\t                    {OFFICE_INFO.city}, {OFFICE_INFO.state} {OFFICE_INFO.pincode}\n257\t                  </p>\n258\t                </div>\n259\t              </CardContent>\n260\t            </Card>\n261\t          </div>\n262\t        </div>\n263\t      </section>\n264\t\n265\t      <Separator className=\"max-w-4xl mx-auto\" />\n266\t\n267\t      {/* Book Consultation CTA Section */}\n268\t      <section className=\"py-16 md:py-20\">\n269\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n270\t          <div className=\"grid lg:grid-cols-2 gap-12 items-center\">\n271\t            {/* Left: CTA Content */}\n272\t            <div className=\"space-y-6\">\n273\t              <div>\n274\t                <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n275\t                  <Calendar className=\"mr-1 h-3 w-3\" />\n276\t                  Book a Consultation\n277\t                </Badge>\n278\t                <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight\">\n279\t                  Schedule Your Free Initial Assessment\n280\t                </h2>\n281\t              </div>\n282\t\n283\t              <p className=\"text-muted-foreground text-lg leading-relaxed\">\n284\t                Take the first step toward smarter water infrastructure. Book a free 30-minute\n285\t                consultation with our engineering team to discuss your project scope, challenges,\n286\t                and goals.\n287\t              </p>\n288\t\n289\t              <div className=\"space-y-3\">\n290\t                <div className=\"flex items-center gap-3\">\n291\t                  <CheckCircle2 className=\"h-5 w-5 text-primary flex-shrink-0\" />\n292\t                  <span className=\"text-sm\">Discuss your project requirements with experts</span>\n293\t                </div>\n294\t                <div className=\"flex items-center gap-3\">\n295\t                  <CheckCircle2 className=\"h-5 w-5 text-primary flex-shrink-0\" />\n296\t                  <span className=\"text-sm\">Receive preliminary recommendations</span>\n297\t                </div>\n298\t                <div className=\"flex items-center gap-3\">\n299\t                  <CheckCircle2 className=\"h-5 w-5 text-primary flex-shrink-0\" />\n300\t                  <span className=\"text-sm\">No obligation, completely free consultation</span>\n301\t                </div>\n302\t              </div>\n303\t\n304\t              <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n305\t                <Clock className=\"h-4 w-4\" />\n306\t                <span>{OFFICE_INFO.workingHours}</span>\n307\t              </div>\n308\t            </div>\n309\t\n310\t            {/* Right: CTA Card with Dialog Trigger */}\n311\t            <div className=\"flex justify-center lg:justify-end\">\n312\t              <Card className=\"w-full max-w-md border-primary/20 bg-gradient-to-br from-card to-primary/5\">\n313\t                <CardHeader>\n314\t                  <CardTitle className=\"text-2xl\">Ready to Get Started?</CardTitle>\n315\t                  <CardDescription>\n316\t                    Fill out the inquiry form and our team will reach out within 24 hours to\n317\t                    schedule your consultation.\n318\t                  </CardDescription>\n319\t                </CardHeader>\n320\t                <CardContent className=\"space-y-4\">\n321\t                  <div className=\"grid grid-cols-2 gap-4 text-sm\">\n322\t                    <div className=\"flex items-center gap-2\">\n323\t                      <Mail className=\"h-4 w-4 text-muted-foreground\" />\n324\t                      <span className=\"text-muted-foreground\">Response in 24h</span>\n325\t                    </div>\n326\t                    <div className=\"flex items-center gap-2\">\n327\t                      <Clock className=\"h-4 w-4 text-muted-foreground\" />\n328\t                      <span className=\"text-muted-foreground\">30 min call</span>\n329\t                    </div>\n330\t                  </div>\n331\t\n332\t                  <Dialog open={isDialogOpen} onOpenChange={setIsDialogOpen}>\n333\t                    <DialogTrigger asChild>\n334\t                      <Button size=\"lg\" className=\"w-full\" onClick={handleOpenDialog}>\n335\t                        Book a Consultation\n336\t                        <ArrowRight className=\"ml-2 h-5 w-5\" />\n337\t                      </Button>\n338\t                    </DialogTrigger>\n339\t                    <DialogContent className=\"sm:max-w-[500px]\">\n340\t                      <DialogHeader>\n341\t                        <DialogTitle>Book a Consultation</DialogTitle>\n342\t                        <DialogDescription>\n343\t                          Fill out the form below and our team will get back to you within 24 hours\n344\t                          to schedule your consultation.\n345\t                        </DialogDescription>\n346\t                      </DialogHeader>\n347\t\n348\t                      <form onSubmit={handleSubmit} className=\"space-y-4\">\n349\t                        {/* Name Field */}\n350\t                        <div className=\"space-y-2\">\n351\t                          <Label htmlFor=\"name\">\n352\t                            Full Name <span className=\"text-destructive\">*</span>\n353\t                          </Label>\n354\t                          <Input\n355\t                            id=\"name\"\n356\t                            name=\"name\"\n357\t                            type=\"text\"\n358\t                            placeholder=\"Enter your full name\"\n359\t                            value={formData.name}\n360\t                            onChange={handleInputChange}\n361\t                            maxLength={100}\n362\t                            required\n363\t                            aria-invalid={!!errors.name}\n364\t                            aria-describedby={errors.name ? 'name-error' : undefined}\n365\t                          />\n366\t                          {errors.name && (\n367\t                            <p id=\"name-error\" className=\"text-sm text-destructive\">\n368\t                              {errors.name}\n369\t                            </p>\n370\t                          )}\n371\t                          <p className=\"text-xs text-muted-foreground\">\n372\t                            {formData.name.length}/100 characters\n373\t                          </p>\n374\t                        </div>\n375\t\n376\t                        {/* Email Field */}\n377\t                        <div className=\"space-y-2\">\n378\t                          <Label htmlFor=\"email\">\n379\t                            Email Address <span className=\"text-destructive\">*</span>\n380\t                          </Label>\n381\t                          <Input\n382\t                            id=\"email\"\n383\t                            name=\"email\"\n384\t                            type=\"email\"\n385\t                            placeholder=\"your.email@company.com\"\n386\t                            value={formData.email}\n387\t                            onChange={handleInputChange}\n388\t                            required\n389\t                            aria-invalid={!!errors.email}\n390\t                            aria-describedby={errors.email ? 'email-error' : undefined}\n391\t                          />\n392\t                          {errors.email && (\n393\t                            <p id=\"email-error\" className=\"text-sm text-destructive\">\n394\t                              {errors.email}\n395\t                            </p>\n396\t                          )}\n397\t                        </div>\n398\t\n399\t                        {/* Phone Field */}\n400\t                        <div className=\"space-y-2\">\n401\t                          <Label htmlFor=\"phone\">\n402\t                            Phone Number <span className=\"text-destructive\">*</span>\n403\t                          </Label>\n404\t                          <Input\n405\t                            id=\"phone\"\n406\t                            name=\"phone\"\n407\t                            type=\"tel\"\n408\t                            placeholder=\"+91-9876543210\"\n409\t                            value={formData.phone}\n410\t                            onChange={handleInputChange}\n411\t                            required\n412\t                            aria-invalid={!!errors.phone}\n413\t                            aria-describedby={errors.phone ? 'phone-error' : undefined}\n414\t                          />\n415\t                          {errors.phone && (\n416\t                            <p id=\"phone-error\" className=\"text-sm text-destructive\">\n417\t                              {errors.phone}\n418\t                            </p>\n419\t                          )}\n420\t                        </div>\n421\t\n422\t                        {/* Project Details Field */}\n423\t                        <div className=\"space-y-2\">\n424\t                          <Label htmlFor=\"project_details\">\n425\t                            Project Details <span className=\"text-destructive\">*</span>\n426\t                          </Label>\n427\t                          <Textarea\n428\t                            id=\"project_details\"\n429\t                            name=\"project_details\"\n430\t                            placeholder=\"Describe your project scope, requirements, and any specific challenges you are facing...\"\n431\t                            value={formData.project_details}\n432\t                            onChange={handleInputChange}\n433\t                            maxLength={2000}\n434\t                            required\n435\t                            className=\"min-h-[120px]\"\n436\t                            aria-invalid={!!errors.project_details}\n437\t                            aria-describedby={\n438\t                              errors.project_details ? 'project_details-error' : undefined\n439\t                            }\n440\t                          />\n441\t                          {errors.project_details && (\n442\t                            <p id=\"project_details-error\" className=\"text-sm text-destructive\">\n443\t                              {errors.project_details}\n444\t                            </p>\n445\t                          )}\n446\t                          <p className=\"text-xs text-muted-foreground\">\n447\t                            {formData.project_details.length}/2000 characters\n448\t                          </p>\n449\t                        </div>\n450\t\n451\t                        <DialogFooter>\n452\t                          <Button\n453\t                            type=\"submit\"\n454\t                            disabled={isSubmitting}\n455\t                            className=\"w-full sm:w-auto\"\n456\t                          >\n457\t                            {isSubmitting ? (\n458\t                              <>\n459\t                                <span className=\"mr-2\">Submitting...</span>\n460\t                              </>\n461\t                            ) : (\n462\t                              <>\n463\t                                <Send className=\"mr-2 h-4 w-4\" />\n464\t                                Submit Inquiry\n465\t                              </>\n466\t                            )}\n467\t                          </Button>\n468\t                        </DialogFooter>\n469\t                      </form>\n470\t                    </DialogContent>\n471\t                  </Dialog>\n472\t                </CardContent>\n473\t              </Card>\n474\t            </div>\n475\t          </div>\n476\t        </div>\n477\t      </section>\n478\t\n479\t      <Separator className=\"max-w-4xl mx-auto\" />\n480\t\n481\t      {/* Map / Office Location Section */}\n482\t      <section className=\"py-16 md:py-20 bg-muted/30\">\n483\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n484\t          <div className=\"text-center mb-12\">\n485\t            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n486\t              Our Location\n487\t            </Badge>\n488\t            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">\n489\t              Find Us at Our Headquarters\n490\t            </h2>\n491\t            <p className=\"mt-3 text-muted-foreground max-w-2xl mx-auto\">\n492\t              Located in the heart of Noida's IT hub, our office is easily accessible and\n493\t              equipped to host client meetings and consultations.\n494\t            </p>\n495\t          </div>\n496\t\n497\t          <div className=\"grid md:grid-cols-2 gap-8 items-center\">\n498\t            {/* Address Details */}\n499\t            <Card className=\"border-primary/20\">\n500\t              <CardHeader>\n501\t                <CardTitle className=\"text-xl\">Office Address</CardTitle>\n502\t              </CardHeader>\n503\t              <CardContent className=\"space-y-4\">\n504\t                <div className=\"flex items-start gap-3\">\n505\t                  <MapPin className=\"h-5 w-5 text-primary flex-shrink-0 mt-0.5\" />\n506\t                  <div>\n507\t                    <p className=\"font-medium\">{OFFICE_INFO.address}</p>\n508\t                    <p className=\"text-sm text-muted-foreground\">\n509\t                      {OFFICE_INFO.street}\n510\t                    </p>\n511\t                    <p className=\"text-sm text-muted-foreground\">\n512\t                      {OFFICE_INFO.area}\n513\t                    </p>\n514\t                    <p className=\"text-sm text-muted-foreground\">\n515\t                      {OFFICE_INFO.city}, {OFFICE_INFO.state} {OFFICE_INFO.pincode}\n516\t                    </p>\n517\t                    <p className=\"text-sm text-muted-foreground\">{OFFICE_INFO.country}</p>\n518\t                  </div>\n519\t                </div>\n520\t\n521\t                <Separator />\n522\t\n523\t                <div className=\"space-y-3\">\n524\t                  <div className=\"flex items-center gap-3\">\n525\t                    <Mail className=\"h-5 w-5 text-muted-foreground\" />\n526\t                    <a\n527\t                      href={`mailto:${OFFICE_INFO.email}`}\n528\t                      className=\"text-sm text-primary hover:underline\"\n529\t                    >\n530\t                      {OFFICE_INFO.email}\n531\t                    </a>\n532\t                  </div>\n533\t                  <div className=\"flex items-center gap-3\">\n534\t                    <Phone className=\"h-5 w-5 text-muted-foreground\" />\n535\t                    <a\n536\t                      href={`tel:${OFFICE_INFO.phone.replace(/-/g, '')}`}\n537\t                      className=\"text-sm text-primary hover:underline\"\n538\t                    >\n539\t                      {OFFICE_INFO.phone}\n540\t                    </a>\n541\t                  </div>\n542\t                  <div className=\"flex items-center gap-3\">\n543\t                    <Clock className=\"h-5 w-5 text-muted-foreground\" />\n544\t                    <span className=\"text-sm text-muted-foreground\">\n545\t                      {OFFICE_INFO.workingHours}\n546\t                    </span>\n547\t                  </div>\n548\t                </div>\n549\t              </CardContent>\n550\t            </Card>\n551\t\n552\t            {/* Map Placeholder */}\n553\t            <div className=\"relative h-[300px] md:h-[400px] rounded-xl overflow-hidden bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20\">\n554\t              <div className=\"absolute inset-0 flex items-center justify-center\">\n555\t                <div className=\"text-center space-y-4\">\n556\t                  <div className=\"h-16 w-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto\">\n557\t                    <MapPin className=\"h-8 w-8 text-primary\" />\n558\t                  </div>\n559\t                  <div>\n560\t                    <p className=\"font-medium text-lg\">Noida, Uttar Pradesh</p>\n561\t                    <p className=\"text-sm text-muted-foreground\">India</p>\n562\t                  </div>\n563\t                  <Button variant=\"outline\" asChild>\n564\t                    <a\n565\t                      href=\"https://maps.google.com/?q=Noida,Uttar+Pradesh,India\"\n566\t                      target=\"_blank\"\n567\t                      rel=\"noopener noreferrer\"\n568\t                    >\n569\t                      Open in Google Maps\n570\t                      <ArrowRight className=\"ml-2 h-4 w-4\" />\n571\t                    </a>\n572\t                  </Button>\n573\t                </div>\n574\t              </div>\n575\t            </div>\n576\t          </div>\n577\t        </div>\n578\t      </section>\n579\t    </div>\n580\t  );\n581\t};\n582\t\n583\texport default Contact;\n584\t"}]},"parent_tool_use_id":null,"session_id":"a7acff44-f104-4b18-a19d-824b8719d3af","uuid":"26a3ea21-a810-46ad-9bfb-1f280310f3b7","timestamp":"2026-04-18T17:20:01.201Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/code/project-code/code_base/app_7a97b333c52f0a2e89b9d85da46ab74b/frontend/src/pages/Contact.tsx","content":"import { useState } from 'react';\nimport {\n  Mail,\n  Phone,\n  MapPin,\n  Calendar,\n  ArrowRight,\n  Droplets,\n  Clock,\n  Send,\n  CheckCircle2,\n} from 'lucide-react';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Textarea } from '@/components/ui/textarea';\nimport { Label } from '@/components/ui/label';\nimport { Badge } from '@/components/ui/badge';\nimport { Separator } from '@/components/ui/separator';\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from '@/components/ui/dialog';\nimport { toast } from '@/lib/toast';\n\n// RFC 5322 email validation regex\nconst EMAIL_REGEX = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;\n\n// International phone validation (e.g., +91-XXXXXXXXXX)\nconst PHONE_REGEX = /^\\+?[1-9]\\d{1,14}$|^\\+\\d{2}-\\d{10}$/;\n\n// Contact form payload type\ninterface ContactFormData {\n  name: string;\n  email: string;\n  phone: string;\n  project_details: string;\n}\n\n// Mock response type\ninterface ContactResponse {\n  message: string;\n  data: {\n    id: string;\n  };\n}\n\n// Mock office contact information\nconst OFFICE_INFO = {\n  address: 'Hydrologic Innovation Pvt. Ltd.',\n  street: 'Plot No. 45, IT Park Road',\n  area: 'Sector 62, Industrial Area',\n  city: 'Noida',\n  state: 'Uttar Pradesh',\n  pincode: '201301',\n  country: 'India',\n  email: 'contact@hydrologicinnovation.com',\n  phone: '+91-9876543210',\n  alternatePhone: '+91-120-4567890',\n  workingHours: 'Monday - Saturday: 9:00 AM - 6:00 PM',\n};\n\n// Mock data for form submission response\nconst MOCK_SUBMISSION_RESPONSE: ContactResponse = {\n  message: 'Thank you for your inquiry. Our team will get back to you within 24 hours.',\n  data: {\n    id: 'inq-' + Date.now(),\n  },\n};\n\nconst Contact = () => {\n  const [isDialogOpen, setIsDialogOpen] = useState(false);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [formData, setFormData] = useState<ContactFormData>({\n    name: '',\n    email: '',\n    phone: '',\n    project_details: '',\n  });\n  const [errors, setErrors] = useState<Partial<Record<keyof ContactFormData, string>>>({});\n\n  const validateForm = (): boolean => {\n    const newErrors: Partial<Record<keyof ContactFormData, string>> = {};\n\n    // Name validation\n    if (!formData.name.trim()) {\n      newErrors.name = 'Name is required';\n    } else if (formData.name.length > 100) {\n      newErrors.name = 'Name must be 100 characters or less';\n    }\n\n    // Email validation\n    if (!formData.email.trim()) {\n      newErrors.email = 'Email is required';\n    } else if (!EMAIL_REGEX.test(formData.email)) {\n      newErrors.email = 'Please enter a valid email address';\n    }\n\n    // Phone validation\n    if (!formData.phone.trim()) {\n      newErrors.phone = 'Phone number is required';\n    } else if (!PHONE_REGEX.test(formData.phone.replace(/\\s/g, ''))) {\n      newErrors.phone = 'Please enter a valid phone number (e.g., +91-9876543210)';\n    }\n\n    // Project details validation\n    if (!formData.project_details.trim()) {\n      newErrors.project_details = 'Project details are required';\n    } else if (formData.project_details.length > 2000) {\n      newErrors.project_details = 'Project details must be 2000 characters or less';\n    }\n\n    setErrors(newErrors);\n    return Object.keys(newErrors).length === 0;\n  };\n\n  const handleInputChange = (\n    e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>\n  ) => {\n    const { name, value } = e.target;\n    setFormData((prev) => ({ ...prev, [name]: value }));\n    // Clear error when user starts typing\n    if (errors[name as keyof ContactFormData]) {\n      setErrors((prev) => ({ ...prev, [name]: undefined }));\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!validateForm()) {\n      return;\n    }\n\n    setIsSubmitting(true);\n\n    /*\n     * TODO: Real API binding\n     * import { apiService } from '@/lib/api';\n     * const response = await apiService.post({\n     *   endpoint: '/contact/submit',\n     *   body: formData,\n     * });\n     * const result: ContactResponse = response.data;\n     * toast.success(result.message);\n     * setIsDialogOpen(false);\n     * setFormData({ name: '', email: '', phone: '', project_details: '' });\n     */\n\n    // Mock submission delay\n    await new Promise((resolve) => setTimeout(resolve, 1000));\n\n    // Mock success response\n    toast.success(MOCK_SUBMISSION_RESPONSE.message, {\n      description: `Reference ID: ${MOCK_SUBMISSION_RESPONSE.data.id}`,\n    });\n\n    setIsDialogOpen(false);\n    setFormData({ name: '', email: '', phone: '', project_details: '' });\n    setIsSubmitting(false);\n  };\n\n  const handleOpenDialog = () => {\n    setFormData({ name: '', email: '', phone: '', project_details: '' });\n    setErrors({});\n    setIsDialogOpen(true);\n  };\n\n  return (\n    <div className=\"min-h-screen\">\n      {/* Hero Section */}\n      <section className=\"relative w-full bg-gradient-to-br from-primary/10 via-background to-primary/5 py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"flex flex-col items-center text-center max-w-3xl mx-auto\">\n            <Badge variant=\"secondary\" className=\"mb-4 bg-primary/10 text-primary border-primary/20\">\n              <Droplets className=\"mr-1 h-3 w-3\" />\n              Get in Touch\n            </Badge>\n            <h1 className=\"text-3xl md:text-5xl font-bold tracking-tight text-foreground\">\n              Contact Hydrologic Innovation\n            </h1>\n            <p className=\"mt-4 text-lg text-muted-foreground leading-relaxed\">\n              Ready to transform your water infrastructure? Schedule a consultation with our\n              engineering team to discuss your project requirements and discover how we can help.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Contact Info Cards Section */}\n      <section className=\"py-16 md:py-20\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid md:grid-cols-3 gap-6\">\n            {/* Email Card */}\n            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5 hover:shadow-lg transition-shadow\">\n              <CardHeader className=\"pb-2\">\n                <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n                  <Mail className=\"h-6 w-6 text-primary\" />\n                </div>\n                <CardTitle className=\"text-xl\">Email Us</CardTitle>\n                <CardDescription>For general inquiries and support</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-2\">\n                  <p className=\"text-sm font-medium\">{OFFICE_INFO.email}</p>\n                  <p className=\"text-sm text-muted-foreground\">\n                    We respond within 24 business hours\n                  </p>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Phone Card */}\n            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5 hover:shadow-lg transition-shadow\">\n              <CardHeader className=\"pb-2\">\n                <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n                  <Phone className=\"h-6 w-6 text-primary\" />\n                </div>\n                <CardTitle className=\"text-xl\">Call Us</CardTitle>\n                <CardDescription>Speak with our team directly</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-2\">\n                  <p className=\"text-sm font-medium\">{OFFICE_INFO.phone}</p>\n                  <p className=\"text-sm font-medium text-muted-foreground\">\n                    {OFFICE_INFO.alternatePhone}\n                  </p>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Office Location Card */}\n            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5 hover:shadow-lg transition-shadow\">\n              <CardHeader className=\"pb-2\">\n                <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n                  <MapPin className=\"h-6 w-6 text-primary\" />\n                </div>\n                <CardTitle className=\"text-xl\">Visit Us</CardTitle>\n                <CardDescription>Our headquarters location</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-1\">\n                  <p className=\"text-sm font-medium\">{OFFICE_INFO.address}</p>\n                  <p className=\"text-sm text-muted-foreground\">\n                    {OFFICE_INFO.street}\n                  </p>\n                  <p className=\"text-sm text-muted-foreground\">\n                    {OFFICE_INFO.area}\n                  </p>\n                  <p className=\"text-sm text-muted-foreground\">\n                    {OFFICE_INFO.city}, {OFFICE_INFO.state} {OFFICE_INFO.pincode}\n                  </p>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n      </section>\n\n      <Separator className=\"max-w-4xl mx-auto\" />\n\n      {/* Book Consultation CTA Section */}\n      <section className=\"py-16 md:py-20\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid lg:grid-cols-2 gap-12 items-center\">\n            {/* Left: CTA Content */}\n            <div className=\"space-y-6\">\n              <div>\n                <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n                  <Calendar className=\"mr-1 h-3 w-3\" />\n                  Book a Consultation\n                </Badge>\n                <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight\">\n                  Schedule Your Free Initial Assessment\n                </h2>\n              </div>\n\n              <p className=\"text-muted-foreground text-lg leading-relaxed\">\n                Take the first step toward smarter water infrastructure. Book a free 30-minute\n                consultation with our engineering team to discuss your project scope, challenges,\n                and goals.\n              </p>\n\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center gap-3\">\n                  <CheckCircle2 className=\"h-5 w-5 text-primary flex-shrink-0\" />\n                  <span className=\"text-sm\">Discuss your project requirements with experts</span>\n                </div>\n                <div className=\"flex items-center gap-3\">\n                  <CheckCircle2 className=\"h-5 w-5 text-primary flex-shrink-0\" />\n                  <span className=\"text-sm\">Receive preliminary recommendations</span>\n                </div>\n                <div className=\"flex items-center gap-3\">\n                  <CheckCircle2 className=\"h-5 w-5 text-primary flex-shrink-0\" />\n                  <span className=\"text-sm\">No obligation, completely free consultation</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                <Clock className=\"h-4 w-4\" />\n                <span>{OFFICE_INFO.workingHours}</span>\n              </div>\n            </div>\n\n            {/* Right: CTA Card with Dialog Trigger */}\n            <div className=\"flex justify-center lg:justify-end\">\n              <Card className=\"w-full max-w-md border-primary/20 bg-gradient-to-br from-card to-primary/5\">\n                <CardHeader>\n                  <CardTitle className=\"text-2xl\">Ready to Get Started?</CardTitle>\n                  <CardDescription>\n                    Fill out the inquiry form and our team will reach out within 24 hours to\n                    schedule your consultation.\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"space-y-4\">\n                  <div className=\"grid grid-cols-2 gap-4 text-sm\">\n                    <div className=\"flex items-center gap-2\">\n                      <Mail className=\"h-4 w-4 text-muted-foreground\" />\n                      <span className=\"text-muted-foreground\">Response in 24h</span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <Clock className=\"h-4 w-4 text-muted-foreground\" />\n                      <span className=\"text-muted-foreground\">30 min call</span>\n                    </div>\n                  </div>\n\n                  <Dialog open={isDialogOpen} onOpenChange={setIsDialogOpen}>\n                    <DialogTrigger asChild>\n                      <Button size=\"lg\" className=\"w-full\" onClick={handleOpenDialog}>\n                        Book a Consultation\n                        <ArrowRight className=\"ml-2 h-5 w-5\" />\n                      </Button>\n                    </DialogTrigger>\n                    <DialogContent className=\"sm:max-w-[500px]\">\n                      <DialogHeader>\n                        <DialogTitle>Book a Consultation</DialogTitle>\n                        <DialogDescription>\n                          Fill out the form below and our team will get back to you within 24 hours\n                          to schedule your consultation.\n                        </DialogDescription>\n                      </DialogHeader>\n\n                      <form onSubmit={handleSubmit} className=\"space-y-4\">\n                        {/* Name Field */}\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"name\">\n                            Full Name <span className=\"text-destructive\">*</span>\n                          </Label>\n                          <Input\n                            id=\"name\"\n                            name=\"name\"\n                            type=\"text\"\n                            placeholder=\"Enter your full name\"\n                            value={formData.name}\n                            onChange={handleInputChange}\n                            maxLength={100}\n                            required\n                            aria-invalid={!!errors.name}\n                            aria-describedby={errors.name ? 'name-error' : undefined}\n                          />\n                          {errors.name && (\n                            <p id=\"name-error\" className=\"text-sm text-destructive\">\n                              {errors.name}\n                            </p>\n                          )}\n                          <p className=\"text-xs text-muted-foreground\">\n                            {formData.name.length}/100 characters\n                          </p>\n                        </div>\n\n                        {/* Email Field */}\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"email\">\n                            Email Address <span className=\"text-destructive\">*</span>\n                          </Label>\n                          <Input\n                            id=\"email\"\n                            name=\"email\"\n                            type=\"email\"\n                            placeholder=\"your.email@company.com\"\n                            value={formData.email}\n                            onChange={handleInputChange}\n                            required\n                            aria-invalid={!!errors.email}\n                            aria-describedby={errors.email ? 'email-error' : undefined}\n                          />\n                          {errors.email && (\n                            <p id=\"email-error\" className=\"text-sm text-destructive\">\n                              {errors.email}\n                            </p>\n                          )}\n                        </div>\n\n                        {/* Phone Field */}\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"phone\">\n                            Phone Number <span className=\"text-destructive\">*</span>\n                          </Label>\n                          <Input\n                            id=\"phone\"\n                            name=\"phone\"\n                            type=\"tel\"\n                            placeholder=\"+91-9876543210\"\n                            value={formData.phone}\n                            onChange={handleInputChange}\n                            required\n                            aria-invalid={!!errors.phone}\n                            aria-describedby={errors.phone ? 'phone-error' : undefined}\n                          />\n                          {errors.phone && (\n                            <p id=\"phone-error\" className=\"text-sm text-destructive\">\n                              {errors.phone}\n                            </p>\n                          )}\n                        </div>\n\n                        {/* Project Details Field */}\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"project_details\">\n                            Project Details <span className=\"text-destructive\">*</span>\n                          </Label>\n                          <Textarea\n                            id=\"project_details\"\n                            name=\"project_details\"\n                            placeholder=\"Describe your project scope, requirements, and any specific challenges you are facing...\"\n                            value={formData.project_details}\n                            onChange={handleInputChange}\n                            maxLength={2000}\n                            required\n                            className=\"min-h-[120px]\"\n                            aria-invalid={!!errors.project_details}\n                            aria-describedby={\n                              errors.project_details ? 'project_details-error' : undefined\n                            }\n                          />\n                          {errors.project_details && (\n                            <p id=\"project_details-error\" className=\"text-sm text-destructive\">\n                              {errors.project_details}\n                            </p>\n                          )}\n                          <p className=\"text-xs text-muted-foreground\">\n                            {formData.project_details.length}/2000 characters\n                          </p>\n                        </div>\n\n                        <DialogFooter>\n                          <Button\n                            type=\"submit\"\n                            disabled={isSubmitting}\n                            className=\"w-full sm:w-auto\"\n                          >\n                            {isSubmitting ? (\n                              <>\n                                <span className=\"mr-2\">Submitting...</span>\n                              </>\n                            ) : (\n                              <>\n                                <Send className=\"mr-2 h-4 w-4\" />\n                                Submit Inquiry\n                              </>\n                            )}\n                          </Button>\n                        </DialogFooter>\n                      </form>\n                    </DialogContent>\n                  </Dialog>\n                </CardContent>\n              </Card>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <Separator className=\"max-w-4xl mx-auto\" />\n\n      {/* Map / Office Location Section */}\n      <section className=\"py-16 md:py-20 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-12\">\n            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n              Our Location\n            </Badge>\n            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">\n              Find Us at Our Headquarters\n            </h2>\n            <p className=\"mt-3 text-muted-foreground max-w-2xl mx-auto\">\n              Located in the heart of Noida's IT hub, our office is easily accessible and\n              equipped to host client meetings and consultations.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 gap-8 items-center\">\n            {/* Address Details */}\n            <Card className=\"border-primary/20\">\n              <CardHeader>\n                <CardTitle className=\"text-xl\">Office Address</CardTitle>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <div className=\"flex items-start gap-3\">\n                  <MapPin className=\"h-5 w-5 text-primary flex-shrink-0 mt-0.5\" />\n                  <div>\n                    <p className=\"font-medium\">{OFFICE_INFO.address}</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      {OFFICE_INFO.street}\n                    </p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      {OFFICE_INFO.area}\n                    </p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      {OFFICE_INFO.city}, {OFFICE_INFO.state} {OFFICE_INFO.pincode}\n                    </p>\n                    <p className=\"text-sm text-muted-foreground\">{OFFICE_INFO.country}</p>\n                  </div>\n                </div>\n\n                <Separator />\n\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <Mail className=\"h-5 w-5 text-muted-foreground\" />\n                    <a\n                      href={`mailto:${OFFICE_INFO.email}`}\n                      className=\"text-sm text-primary hover:underline\"\n                    >\n                      {OFFICE_INFO.email}\n                    </a>\n                  </div>\n                  <div className=\"flex items-center gap-3\">\n                    <Phone className=\"h-5 w-5 text-muted-foreground\" />\n                    <a\n                      href={`tel:${OFFICE_INFO.phone.replace(/-/g, '')}`}\n                      className=\"text-sm text-primary hover:underline\"\n                    >\n                      {OFFICE_INFO.phone}\n                    </a>\n                  </div>\n                  <div className=\"flex items-center gap-3\">\n                    <Clock className=\"h-5 w-5 text-muted-foreground\" />\n                    <span className=\"text-sm text-muted-foreground\">\n                      {OFFICE_INFO.workingHours}\n                    </spa