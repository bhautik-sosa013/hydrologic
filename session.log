w-6\" />\n                  </div>\n                  <ArrowRight className=\"h-5 w-5 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300 -mt-1 -mr-1\" />\n                </div>\n                <CardTitle className=\"text-xl\">{service.title}</CardTitle>\n                <CardDescription className=\"mt-2\">\n                  {service.shortDescription}\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <ul className=\"space-y-2\">\n                  {service.features.map((feature) => (\n                    <li\n                      key={feature}\n                      className=\"flex items-center gap-2 text-sm text-muted-foreground\"\n                    >\n                      <CheckCircle2 className=\"h-4 w-4 text-primary shrink-0\" />\n                      {feature}\n                    </li>\n                  ))}\n                </ul>\n                <Button\n                  variant=\"link\"\n                  className=\"mt-6 p-0 h-auto text-primary\"\n                  onClick={(e) => {\n                    e.stopPropagation();\n                    navigate(service.path);\n                  }}\n                >\n                  Learn more\n                  <ArrowRight className=\"ml-1 h-4 w-4\" />\n                </Button>\n              </CardContent>\n            </Card>\n          );\n        })}\n      </div>\n\n      {/* Bottom CTA Section */}\n      <div className=\"mt-20 text-center\">\n        <div className=\"bg-card rounded-xl border p-8 md:p-12\">\n          <h2 className=\"text-2xl font-semibold mb-4\">\n            Need a Custom Engineering Solution?\n          </h2>\n          <p className=\"text-muted-foreground max-w-2xl mx-auto mb-6\">\n            Our team of experts combines decades of field experience with\n            industry-leading tools to deliver tailored solutions for complex\n            water infrastructure challenges.\n          </p>\n          <Button onClick={() => navigate('/contact')}>\n            Contact Our Team\n            <ArrowRight className=\"ml-2 h-4 w-4\" />\n          </Button>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Services;","numLines":184,"startLine":1,"totalLines":184}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_xg6w6znepitv_4","type":"tool_result","content":"1\timport { useNavigate } from 'react-router-dom';\n2\timport {\n3\t  ArrowLeft,\n4\t  Droplets,\n5\t  Activity,\n6\t  Gauge,\n7\t  AlertTriangle,\n8\t  CheckCircle2,\n9\t  Settings2,\n10\t  Map,\n11\t  BarChart3,\n12\t  Target,\n13\t  Zap,\n14\t  Shield,\n15\t  Wrench,\n16\t  Users,\n17\t  FileText,\n18\t  TrendingUp,\n19\t} from 'lucide-react';\n20\timport { Button } from '@/components/ui/button';\n21\timport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n22\timport { Badge } from '@/components/ui/badge';\n23\timport { Separator } from '@/components/ui/separator';\n24\t\n25\t// ── Mock data ─────────────────────────────────────────────────────────────────\n26\t\n27\tconst METHODOLOGY_STEPS = [\n28\t  {\n29\t    step: 1,\n30\t    title: 'Data Collection & Network Mapping',\n31\t    description:\n32\t      'We gather existing infrastructure data including pipe diameters, materials, elevations, and demand zones. GIS integration ensures sub-meter accuracy in spatial positioning.',\n33\t    icon: Map,\n34\t  },\n35\t  {\n36\t    step: 2,\n37\t    title: 'Model Construction & Calibration',\n38\t    description:\n39\t      'Using WaterGems and SewerGems, we build a detailed hydraulic model that replicates real-world conditions. The model is calibrated against field measurements for accuracy.',\n40\t    icon: Settings2,\n41\t  },\n42\t  {\n43\t    step: 3,\n44\t    title: 'Scenario Analysis & Simulation',\n45\t    description:\n46\t      'Multiple operational scenarios are simulated including peak demand, fire flow conditions, emergency shutdowns, and future growth projections.',\n47\t    icon: Activity,\n48\t  },\n49\t  {\n50\t    step: 4,\n51\t    title: 'Optimization & Recommendations',\n52\t    description:\n53\t      'Based on simulation results, we identify pressure zones, suggest pipe replacements, and recommend booster stations or valve adjustments for optimal performance.',\n54\t    icon: TrendingUp,\n55\t  },\n56\t];\n57\t\n58\tconst USE_CASES = [\n59\t  {\n60\t    title: 'Urban Water Distribution',\n61\t    description:\n62\t      'Comprehensive analysis of municipal water networks to ensure adequate pressure and flow across all service areas, from high-rise districts to suburban developments.',\n63\t    icon: Droplets,\n64\t    metrics: ['Pressure Zone Optimization', 'Fire Flow Capacity', 'Demand Forecasting'],\n65\t  },\n66\t  {\n67\t    title: 'Sewer Collection Systems',\n68\t    description:\n69\t      'Sanitary sewer and stormwater modeling to prevent overflows, identify infiltration sources, and plan rehabilitation investments for aging infrastructure.',\n70\t    icon: Gauge,\n71\t    metrics: ['Capacity Analysis', 'I&I Reduction', 'Overflow Mitigation'],\n72\t  },\n73\t  {\n74\t    title: 'Industrial Process Water',\n75\t    description:\n76\t      'Specialized hydraulic modeling for manufacturing facilities requiring precise pressure and flow control for production processes.',\n77\t    icon: Settings2,\n78\t    metrics: ['Process Optimization', 'Energy Reduction', 'Reliability Improvement'],\n79\t  },\n80\t];\n81\t\n82\tconst TOOLS = [\n83\t  {\n84\t    name: 'WaterGems',\n85\t    description:\n86\t      'Industry-leading hydraulic modeling software for water distribution network analysis. Supports steady-state and extended-period simulation, fire flow analysis, and infrastructure planning.',\n87\t    capabilities: [\n88\t      'Steady-state and EPS modeling',\n89\t      'Fire flow and capacity analysis',\n90\t      'Capital planning and rehabilitation',\n91\t      'Tank mixing and water age analysis',\n92\t      'SCADA integration for real-time modeling',\n93\t    ],\n94\t    badge: 'Water Distribution',\n95\t    icon: Droplets,\n96\t  },\n97\t  {\n98\t    name: 'SewerGems',\n99\t    description:\n100\t      'Comprehensive sewer and stormwater modeling solution for collection system design, rehabilitation planning, and overflow analysis. Handles both sanitary and combined sewer systems.',\n101\t    capabilities: [\n102\t      'Hydraulic profile analysis',\n103\t      'Rainfall-dependent infiltration analysis',\n104\t      'Wet weather flow management',\n105\t      'Sewer system design',\n106\t      'Regulatory compliance reporting',\n107\t    ],\n108\t    badge: 'Sewer Systems',\n109\t    icon: Gauge,\n110\t  },\n111\t];\n112\t\n113\tconst DELIVERABLES = [\n114\t  {\n115\t    title: 'Executive Summary Report',\n116\t    description: 'High-level findings and recommendations for stakeholder presentation',\n117\t    icon: FileText,\n118\t  },\n119\t  {\n120\t    title: 'Technical Model Documentation',\n121\t    description: 'Detailed model construction, calibration, and methodology documentation',\n122\t    icon: BarChart3,\n123\t  },\n124\t  {\n125\t    title: 'GIS-Compatible Output',\n126\t    description: 'Spatial data exports compatible with enterprise GIS platforms',\n127\t    icon: Map,\n128\t  },\n129\t  {\n130\t    title: 'Scenario Comparison Matrix',\n131\t    description: 'Side-by-side analysis of proposed improvements vs. current conditions',\n132\t    icon: Target,\n133\t  },\n134\t  {\n135\t    title: 'Implementation Roadmap',\n136\t    description: 'Prioritized capital improvement schedule with cost estimates',\n137\t    icon: TrendingUp,\n138\t  },\n139\t  {\n140\t    title: 'Training & Handover',\n141\t    description: 'Model transfer, documentation review, and staff training sessions',\n142\t    icon: Users,\n143\t  },\n144\t];\n145\t\n146\tconst BENEFITS = [\n147\t  {\n148\t    icon: Gauge,\n149\t    title: 'Pressure Optimization',\n150\t    description:\n151\t      'Identify and resolve pressure extremes that cause pipe bursts, leaks, and customer complaints. Our models achieve uniform pressure distribution across all zones.',\n152\t    metric: 'Up to 30% reduction in pipe failures',\n153\t  },\n154\t  {\n155\t    icon: AlertTriangle,\n156\t    title: 'Leak Detection Support',\n157\t    description:\n158\t      'Combine hydraulic modeling with zone metering and transient analysis to pinpoint likely leak locations, reducing survey time and repair costs.',\n159\t    metric: '50% faster leak location identification',\n160\t  },\n161\t  {\n162\t    icon: Shield,\n163\t    title: 'Regulatory Compliance',\n164\t    description:\n165\t      'Ensure your network meets EPA, state, and local water quality standards. We provide documentation for environmental permits and regulatory submissions.',\n166\t    metric: '100% audit-ready documentation',\n167\t  },\n168\t  {\n169\t    icon: Zap,\n170\t    title: 'Energy Efficiency',\n171\t    description:\n172\t      'Optimize pump schedules and tank levels to minimize electricity costs while maintaining service quality. Typical energy savings of 15-25%.',\n173\t    metric: '15-25% pumping cost reduction',\n174\t  },\n175\t  {\n176\t    icon: Target,\n177\t    title: 'Capital Planning',\n178\t    description:\n179\t      'Prioritize infrastructure investments with data-driven analysis showing which projects deliver the most benefit per dollar spent.',\n180\t    metric: 'Optimal ROI on $1M+ projects',\n181\t  },\n182\t  {\n183\t    icon: CheckCircle2,\n184\t    title: 'Operational Reliability',\n185\t    description:\n186\t      'Build system resilience through scenario planning for emergencies, equipment failures, and unexpected demand shifts.',\n187\t    metric: '24/7 operational confidence',\n188\t  },\n189\t];\n190\t\n191\t// ── Page ─────────────────────────────────────────────────────────────────────\n192\t\n193\tconst HydraulicNetworkModeling = () => {\n194\t  const navigate = useNavigate();\n195\t\n196\t  return (\n197\t    <div className=\"flex flex-col min-h-screen\">\n198\t      {/* ── Back Navigation ────────────────────────────────────────────── */}\n199\t      <section className=\"w-full py-6 border-b\">\n200\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n201\t          <Button\n202\t            variant=\"ghost\"\n203\t            size=\"sm\"\n204\t            onClick={() => navigate(-1)}\n205\t            className=\"pl-0 hover:pl-2 transition-all\"\n206\t          >\n207\t            <ArrowLeft className=\"mr-2 h-4 w-4\" />\n208\t            Back to Services\n209\t          </Button>\n210\t        </div>\n211\t      </section>\n212\t\n213\t      {/* ── Hero Section ───────────────────────────────────────────────── */}\n214\t      <section className=\"relative w-full py-16 md:py-24 overflow-hidden\">\n215\t        <div className=\"container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n216\t          <div className=\"max-w-4xl\">\n217\t            <Badge variant=\"outline\" className=\"mb-4 text-primary border-primary/50\">\n218\t              <Activity className=\"mr-1 h-3 w-3\" />\n219\t              Engineering Service\n220\t            </Badge>\n221\t\n222\t            <h1 className=\"text-4xl md:text-5xl font-bold tracking-tight mb-6\">\n223\t              Hydraulic Network Modeling\n224\t            </h1>\n225\t\n226\t            <p className=\"text-xl text-muted-foreground leading-relaxed mb-8\">\n227\t              Hydrologic Innovation leverages industry-leading WaterGems and SewerGems platforms to\n228\t              deliver precise hydraulic modeling for water distribution and sewer collection\n229\t              systems. Our methodology transforms complex infrastructure data into actionable\n230\t              insights for pressure optimization, leak detection, and capital planning.\n231\t            </p>\n232\t\n233\t            <div className=\"flex flex-wrap gap-4\">\n234\t              <Button size=\"lg\" asChild>\n235\t                <a href=\"/contact\">\n236\t                  Request Consultation\n237\t                  <TrendingUp className=\"ml-2 h-5 w-5\" />\n238\t                </a>\n239\t              </Button>\n240\t              <Button size=\"lg\" variant=\"outline\" asChild>\n241\t                <a href=\"/projects\">\n242\t                  View Related Projects\n243\t                  <Map className=\"ml-2 h-5 w-5\" />\n244\t                </a>\n245\t              </Button>\n246\t            </div>\n247\t          </div>\n248\t        </div>\n249\t      </section>\n250\t\n251\t      <Separator />\n252\t\n253\t      {/* ── Use Cases Section ──────────────────────────────────────────── */}\n254\t      <section className=\"w-full py-16 md:py-24\">\n255\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n256\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n257\t            <Badge variant=\"secondary\" className=\"mb-4\">\n258\t              Applications\n259\t            </Badge>\n260\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n261\t              What We Model\n262\t            </h2>\n263\t            <p className=\"text-muted-foreground text-lg\">\n264\t              From municipal water mains to industrial process networks, our hydraulic modeling\n265\t              expertise covers the full spectrum of water infrastructure systems.\n266\t            </p>\n267\t          </div>\n268\t\n269\t          <div className=\"grid md:grid-cols-3 gap-8\">\n270\t            {USE_CASES.map((useCase) => (\n271\t              <Card key={useCase.title} className=\"overflow-hidden hover:shadow-lg transition-all\">\n272\t                <div className=\"h-1.5 bg-primary\" />\n273\t                <CardHeader>\n274\t                  <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n275\t                    <useCase.icon className=\"h-6 w-6 text-primary\" />\n276\t                  </div>\n277\t                  <CardTitle className=\"text-xl\">{useCase.title}</CardTitle>\n278\t                </CardHeader>\n279\t                <CardContent>\n280\t                  <CardDescription className=\"text-base leading-relaxed mb-4\">\n281\t                    {useCase.description}\n282\t                  </CardDescription>\n283\t                  <div className=\"space-y-2\">\n284\t                    {useCase.metrics.map((metric) => (\n285\t                      <div key={metric} className=\"flex items-center gap-2 text-sm\">\n286\t                        <CheckCircle2 className=\"h-4 w-4 text-primary flex-shrink-0\" />\n287\t                        <span>{metric}</span>\n288\t                      </div>\n289\t                    ))}\n290\t                  </div>\n291\t                </CardContent>\n292\t              </Card>\n293\t            ))}\n294\t          </div>\n295\t        </div>\n296\t      </section>\n297\t\n298\t      <Separator />\n299\t\n300\t      {/* ── Methodology Section ────────────────────────────────────────── */}\n301\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n302\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n303\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n304\t            <Badge variant=\"secondary\" className=\"mb-4\">\n305\t              Our Process\n306\t            </Badge>\n307\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n308\t              Proven Methodology\n309\t            </h2>\n310\t            <p className=\"text-muted-foreground text-lg\">\n311\t              A systematic four-phase approach ensures accurate models and actionable\n312\t              recommendations for every project.\n313\t            </p>\n314\t          </div>\n315\t\n316\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n317\t            {METHODOLOGY_STEPS.map((step) => (\n318\t              <div key={step.step} className=\"relative\">\n319\t                {/* Step number indicator */}\n320\t                <div className=\"flex items-center gap-3 mb-4\">\n321\t                  <div className=\"h-10 w-10 rounded-full bg-primary text-primary-foreground flex items-center justify-center font-bold text-lg\">\n322\t                    {step.step}\n323\t                  </div>\n324\t                  {step.step < METHODOLOGY_STEPS.length && (\n325\t                    <div className=\"hidden lg:block flex-1 h-px bg-border\" />\n326\t                  )}\n327\t                </div>\n328\t\n329\t                <Card className=\"hover:shadow-md transition-shadow\">\n330\t                  <CardHeader>\n331\t                    <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3\">\n332\t                      <step.icon className=\"h-5 w-5 text-primary\" />\n333\t                    </div>\n334\t                    <CardTitle className=\"text-lg\">{step.title}</CardTitle>\n335\t                  </CardHeader>\n336\t                  <CardContent>\n337\t                    <CardDescription className=\"text-sm leading-relaxed\">\n338\t                      {step.description}\n339\t                    </CardDescription>\n340\t                  </CardContent>\n341\t                </Card>\n342\t              </div>\n343\t            ))}\n344\t          </div>\n345\t        </div>\n346\t      </section>\n347\t\n348\t      <Separator />\n349\t\n350\t      {/* ── Tools Section ──────────────────────────────────────────────── */}\n351\t      <section className=\"w-full py-16 md:py-24\">\n352\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n353\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n354\t            <Badge variant=\"secondary\" className=\"mb-4\">\n355\t              Industry Tools\n356\t            </Badge>\n357\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n358\t              Best-in-Class Software\n359\t            </h2>\n360\t            <p className=\"text-muted-foreground text-lg\">\n361\t              We leverage WaterGems and SewerGems, the most trusted names in hydraulic modeling,\n362\t              to deliver precise and reliable results.\n363\t            </p>\n364\t          </div>\n365\t\n366\t          <div className=\"grid md:grid-cols-2 gap-8 max-w-5xl mx-auto\">\n367\t            {TOOLS.map((tool) => (\n368\t              <Card key={tool.name} className=\"overflow-hidden hover:shadow-lg transition-all\">\n369\t                <div className=\"h-2 bg-primary\" />\n370\t                <CardHeader>\n371\t                  <div className=\"flex items-start justify-between\">\n372\t                    <div className=\"flex items-center gap-4\">\n373\t                      <div className=\"h-14 w-14 rounded-lg bg-primary/10 flex items-center justify-center\">\n374\t                        <tool.icon className=\"h-7 w-7 text-primary\" />\n375\t                      </div>\n376\t                      <div>\n377\t                        <CardTitle className=\"text-2xl mb-1\">{tool.name}</CardTitle>\n378\t                        <Badge variant=\"secondary\">{tool.badge}</Badge>\n379\t                      </div>\n380\t                    </div>\n381\t                  </div>\n382\t                </CardHeader>\n383\t                <CardContent>\n384\t                  <CardDescription className=\"text-base leading-relaxed mb-4\">\n385\t                    {tool.description}\n386\t                  </CardDescription>\n387\t                  <div className=\"space-y-2\">\n388\t                    <p className=\"text-sm font-semibold text-foreground\">Capabilities:</p>\n389\t                    {tool.capabilities.map((cap) => (\n390\t                      <div key={cap} className=\"flex items-center gap-2 text-sm\">\n391\t                        <CheckCircle2 className=\"h-4 w-4 text-primary flex-shrink-0\" />\n392\t                        <span>{cap}</span>\n393\t                      </div>\n394\t                    ))}\n395\t                  </div>\n396\t                </CardContent>\n397\t              </Card>\n398\t            ))}\n399\t          </div>\n400\t        </div>\n401\t      </section>\n402\t\n403\t      <Separator />\n404\t\n405\t      {/* ── Deliverables Section ───────────────────────────────────────── */}\n406\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n407\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n408\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n409\t            <Badge variant=\"secondary\" className=\"mb-4\">\n410\t              Project Output\n411\t            </Badge>\n412\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n413\t              What You Receive\n414\t            </h2>\n415\t            <p className=\"text-muted-foreground text-lg\">\n416\t              Every modeling engagement concludes with comprehensive documentation and\n417\t              actionable deliverables tailored to your team's needs.\n418\t            </p>\n419\t          </div>\n420\t\n421\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n422\t            {DELIVERABLES.map((item) => (\n423\t              <Card key={item.title} className=\"hover:shadow-md transition-shadow\">\n424\t                <CardHeader className=\"flex flex-row items-start gap-4\">\n425\t                  <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n426\t                    <item.icon className=\"h-5 w-5 text-primary\" />\n427\t                  </div>\n428\t                  <div>\n429\t                    <CardTitle className=\"text-lg mb-1\">{item.title}</CardTitle>\n430\t                    <CardDescription>{item.description}</CardDescription>\n431\t                  </div>\n432\t                </CardHeader>\n433\t              </Card>\n434\t            ))}\n435\t          </div>\n436\t        </div>\n437\t      </section>\n438\t\n439\t      <Separator />\n440\t\n441\t      {/* ── Benefits Section ───────────────────────────────────────────── */}\n442\t      <section className=\"w-full py-16 md:py-24\">\n443\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n444\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n445\t            <Badge variant=\"secondary\" className=\"mb-4\">\n446\t              Client Value\n447\t            </Badge>\n448\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n449\t              Measurable Benefits\n450\t            </h2>\n451\t            <p className=\"text-muted-foreground text-lg\">\n452\t              Our hydraulic modeling engagements consistently deliver quantifiable improvements\n453\t              across operational, financial, and compliance dimensions.\n454\t            </p>\n455\t          </div>\n456\t\n457\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n458\t            {BENEFITS.map((benefit) => (\n459\t              <div key={benefit.title} className=\"space-y-4\">\n460\t                <div className=\"flex items-start gap-4\">\n461\t                  <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n462\t                    <benefit.icon className=\"h-6 w-6 text-primary\" />\n463\t                  </div>\n464\t                  <div>\n465\t                    <h3 className=\"font-semibold text-lg\">{benefit.title}</h3>\n466\t                    <p className=\"text-sm text-muted-foreground leading-relaxed\">\n467\t                      {benefit.description}\n468\t                    </p>\n469\t                  </div>\n470\t                </div>\n471\t                <div className=\"pl-16\">\n472\t                  <Badge variant=\"outline\" className=\"text-primary border-primary/30 bg-primary/5\">\n473\t                    {benefit.metric}\n474\t                  </Badge>\n475\t                </div>\n476\t              </div>\n477\t            ))}\n478\t          </div>\n479\t        </div>\n480\t      </section>\n481\t\n482\t      <Separator />\n483\t\n484\t      {/* ── CTA Section ─────────────────────────────────────────────────── */}\n485\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n486\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n487\t          <div className=\"relative rounded-2xl bg-primary text-primary-foreground overflow-hidden\">\n488\t            {/* Background pattern */}\n489\t            <div className=\"absolute inset-0 opacity-10\">\n490\t              <svg\n491\t                viewBox=\"0 0 100 100\"\n492\t                className=\"w-full h-full\"\n493\t                xmlns=\"http://www.w3.org/2000/svg\"\n494\t              >\n495\t                <pattern id=\"dots\" x=\"0\" y=\"0\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n496\t                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"currentColor\" />\n497\t                </pattern>\n498\t                <rect width=\"100%\" height=\"100%\" fill=\"url(#dots)\" />\n499\t              </svg>\n500\t            </div>\n501\t\n502\t            <div className=\"relative z-10 text-center py-16 px-6\">\n503\t              <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n504\t                Ready to Optimize Your Water Network?\n505\t              </h2>\n506\t              <p className=\"text-primary-foreground/80 text-lg max-w-2xl mx-auto mb-8\">\n507\t                Schedule a free assessment with our hydraulic modeling team to discuss your\n508\t                infrastructure challenges and discover how modeling can transform your operations.\n509\t              </p>\n510\t\n511\t              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n512\t                <Button\n513\t                  size=\"lg\"\n514\t                  variant=\"secondary\"\n515\t                  className=\"text-primary\"\n516\t                  asChild\n517\t                >\n518\t                  <a href=\"/contact\">\n519\t                    Get Free Assessment\n520\t                    <TrendingUp className=\"ml-2 h-5 w-5\" />\n521\t                  </a>\n522\t                </Button>\n523\t                <Button\n524\t                  size=\"lg\"\n525\t                  variant=\"outline\"\n526\t                  className=\"border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10\"\n527\t                  asChild\n528\t                >\n529\t                  <a href=\"/projects\">\n530\t                    View Our Projects\n531\t                    <Wrench className=\"ml-2 h-5 w-5\" />\n532\t                  </a>\n533\t                </Button>\n534\t              </div>\n535\t\n536\t              {/* Trust indicators */}\n537\t              <div className=\"flex flex-wrap justify-center gap-6 mt-12 text-sm text-primary-foreground/60\">\n538\t                {[\n539\t                  'No Obligation Quote',\n540\t                  'Expert Engineering Team',\n541\t                  'Proven Results',\n542\t                ].map((item) => (\n543\t                  <div key={item} className=\"flex items-center gap-2\">\n544\t                    <CheckCircle2 className=\"h-4 w-4\" />\n545\t                    {item}\n546\t                  </div>\n547\t                ))}\n548\t              </div>\n549\t            </div>\n550\t          </div>\n551\t        </div>\n552\t      </section>\n553\t    </div>\n554\t  );\n555\t};\n556\t\n557\texport default HydraulicNetworkModeling;\n558\t"}]},"parent_tool_use_id":null,"session_id":"a7acff44-f104-4b18-a19d-824b8719d3af","uuid":"6a4b8dbd-90f8-499a-9f90-5cf21823f049","timestamp":"2026-04-18T17:19:57.479Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/code/project-code/code_base/app_7a97b333c52f0a2e89b9d85da46ab74b/frontend/src/pages/HydraulicNetworkModeling.tsx","content":"import { useNavigate } from 'react-router-dom';\nimport {\n  ArrowLeft,\n  Droplets,\n  Activity,\n  Gauge,\n  AlertTriangle,\n  CheckCircle2,\n  Settings2,\n  Map,\n  BarChart3,\n  Target,\n  Zap,\n  Shield,\n  Wrench,\n  Users,\n  FileText,\n  TrendingUp,\n} from 'lucide-react';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport { Separator } from '@/components/ui/separator';\n\n// ── Mock data ─────────────────────────────────────────────────────────────────\n\nconst METHODOLOGY_STEPS = [\n  {\n    step: 1,\n    title: 'Data Collection & Network Mapping',\n    description:\n      'We gather existing infrastructure data including pipe diameters, materials, elevations, and demand zones. GIS integration ensures sub-meter accuracy in spatial positioning.',\n    icon: Map,\n  },\n  {\n    step: 2,\n    title: 'Model Construction & Calibration',\n    description:\n      'Using WaterGems and SewerGems, we build a detailed hydraulic model that replicates real-world conditions. The model is calibrated against field measurements for accuracy.',\n    icon: Settings2,\n  },\n  {\n    step: 3,\n    title: 'Scenario Analysis & Simulation',\n    description:\n      'Multiple operational scenarios are simulated including peak demand, fire flow conditions, emergency shutdowns, and future growth projections.',\n    icon: Activity,\n  },\n  {\n    step: 4,\n    title: 'Optimization & Recommendations',\n    description:\n      'Based on simulation results, we identify pressure zones, suggest pipe replacements, and recommend booster stations or valve adjustments for optimal performance.',\n    icon: TrendingUp,\n  },\n];\n\nconst USE_CASES = [\n  {\n    title: 'Urban Water Distribution',\n    description:\n      'Comprehensive analysis of municipal water networks to ensure adequate pressure and flow across all service areas, from high-rise districts to suburban developments.',\n    icon: Droplets,\n    metrics: ['Pressure Zone Optimization', 'Fire Flow Capacity', 'Demand Forecasting'],\n  },\n  {\n    title: 'Sewer Collection Systems',\n    description:\n      'Sanitary sewer and stormwater modeling to prevent overflows, identify infiltration sources, and plan rehabilitation investments for aging infrastructure.',\n    icon: Gauge,\n    metrics: ['Capacity Analysis', 'I&I Reduction', 'Overflow Mitigation'],\n  },\n  {\n    title: 'Industrial Process Water',\n    description:\n      'Specialized hydraulic modeling for manufacturing facilities requiring precise pressure and flow control for production processes.',\n    icon: Settings2,\n    metrics: ['Process Optimization', 'Energy Reduction', 'Reliability Improvement'],\n  },\n];\n\nconst TOOLS = [\n  {\n    name: 'WaterGems',\n    description:\n      'Industry-leading hydraulic modeling software for water distribution network analysis. Supports steady-state and extended-period simulation, fire flow analysis, and infrastructure planning.',\n    capabilities: [\n      'Steady-state and EPS modeling',\n      'Fire flow and capacity analysis',\n      'Capital planning and rehabilitation',\n      'Tank mixing and water age analysis',\n      'SCADA integration for real-time modeling',\n    ],\n    badge: 'Water Distribution',\n    icon: Droplets,\n  },\n  {\n    name: 'SewerGems',\n    description:\n      'Comprehensive sewer and stormwater modeling solution for collection system design, rehabilitation planning, and overflow analysis. Handles both sanitary and combined sewer systems.',\n    capabilities: [\n      'Hydraulic profile analysis',\n      'Rainfall-dependent infiltration analysis',\n      'Wet weather flow management',\n      'Sewer system design',\n      'Regulatory compliance reporting',\n    ],\n    badge: 'Sewer Systems',\n    icon: Gauge,\n  },\n];\n\nconst DELIVERABLES = [\n  {\n    title: 'Executive Summary Report',\n    description: 'High-level findings and recommendations for stakeholder presentation',\n    icon: FileText,\n  },\n  {\n    title: 'Technical Model Documentation',\n    description: 'Detailed model construction, calibration, and methodology documentation',\n    icon: BarChart3,\n  },\n  {\n    title: 'GIS-Compatible Output',\n    description: 'Spatial data exports compatible with enterprise GIS platforms',\n    icon: Map,\n  },\n  {\n    title: 'Scenario Comparison Matrix',\n    description: 'Side-by-side analysis of proposed improvements vs. current conditions',\n    icon: Target,\n  },\n  {\n    title: 'Implementation Roadmap',\n    description: 'Prioritized capital improvement schedule with cost estimates',\n    icon: TrendingUp,\n  },\n  {\n    title: 'Training & Handover',\n    description: 'Model transfer, documentation review, and staff training sessions',\n    icon: Users,\n  },\n];\n\nconst BENEFITS = [\n  {\n    icon: Gauge,\n    title: 'Pressure Optimization',\n    description:\n      'Identify and resolve pressure extremes that cause pipe bursts, leaks, and customer complaints. Our models achieve uniform pressure distribution across all zones.',\n    metric: 'Up to 30% reduction in pipe failures',\n  },\n  {\n    icon: AlertTriangle,\n    title: 'Leak Detection Support',\n    description:\n      'Combine hydraulic modeling with zone metering and transient analysis to pinpoint likely leak locations, reducing survey time and repair costs.',\n    metric: '50% faster leak location identification',\n  },\n  {\n    icon: Shield,\n    title: 'Regulatory Compliance',\n    description:\n      'Ensure your network meets EPA, state, and local water quality standards. We provide documentation for environmental permits and regulatory submissions.',\n    metric: '100% audit-ready documentation',\n  },\n  {\n    icon: Zap,\n    title: 'Energy Efficiency',\n    description:\n      'Optimize pump schedules and tank levels to minimize electricity costs while maintaining service quality. Typical energy savings of 15-25%.',\n    metric: '15-25% pumping cost reduction',\n  },\n  {\n    icon: Target,\n    title: 'Capital Planning',\n    description:\n      'Prioritize infrastructure investments with data-driven analysis showing which projects deliver the most benefit per dollar spent.',\n    metric: 'Optimal ROI on $1M+ projects',\n  },\n  {\n    icon: CheckCircle2,\n    title: 'Operational Reliability',\n    description:\n      'Build system resilience through scenario planning for emergencies, equipment failures, and unexpected demand shifts.',\n    metric: '24/7 operational confidence',\n  },\n];\n\n// ── Page ─────────────────────────────────────────────────────────────────────\n\nconst HydraulicNetworkModeling = () => {\n  const navigate = useNavigate();\n\n  return (\n    <div className=\"flex flex-col min-h-screen\">\n      {/* ── Back Navigation ────────────────────────────────────────────── */}\n      <section className=\"w-full py-6 border-b\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            onClick={() => navigate(-1)}\n            className=\"pl-0 hover:pl-2 transition-all\"\n          >\n            <ArrowLeft className=\"mr-2 h-4 w-4\" />\n            Back to Services\n          </Button>\n        </div>\n      </section>\n\n      {/* ── Hero Section ───────────────────────────────────────────────── */}\n      <section className=\"relative w-full py-16 md:py-24 overflow-hidden\">\n        <div className=\"container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"max-w-4xl\">\n            <Badge variant=\"outline\" className=\"mb-4 text-primary border-primary/50\">\n              <Activity className=\"mr-1 h-3 w-3\" />\n              Engineering Service\n            </Badge>\n\n            <h1 className=\"text-4xl md:text-5xl font-bold tracking-tight mb-6\">\n              Hydraulic Network Modeling\n            </h1>\n\n            <p className=\"text-xl text-muted-foreground leading-relaxed mb-8\">\n              Hydrologic Innovation leverages industry-leading WaterGems and SewerGems platforms to\n              deliver precise hydraulic modeling for water distribution and sewer collection\n              systems. Our methodology transforms complex infrastructure data into actionable\n              insights for pressure optimization, leak detection, and capital planning.\n            </p>\n\n            <div className=\"flex flex-wrap gap-4\">\n              <Button size=\"lg\" asChild>\n                <a href=\"/contact\">\n                  Request Consultation\n                  <TrendingUp className=\"ml-2 h-5 w-5\" />\n                </a>\n              </Button>\n              <Button size=\"lg\" variant=\"outline\" asChild>\n                <a href=\"/projects\">\n                  View Related Projects\n                  <Map className=\"ml-2 h-5 w-5\" />\n                </a>\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Use Cases Section ──────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Applications\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              What We Model\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              From municipal water mains to industrial process networks, our hydraulic modeling\n              expertise covers the full spectrum of water infrastructure systems.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-3 gap-8\">\n            {USE_CASES.map((useCase) => (\n              <Card key={useCase.title} className=\"overflow-hidden hover:shadow-lg transition-all\">\n                <div className=\"h-1.5 bg-primary\" />\n                <CardHeader>\n                  <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n                    <useCase.icon className=\"h-6 w-6 text-primary\" />\n                  </div>\n                  <CardTitle className=\"text-xl\">{useCase.title}</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription className=\"text-base leading-relaxed mb-4\">\n                    {useCase.description}\n                  </CardDescription>\n                  <div className=\"space-y-2\">\n                    {useCase.metrics.map((metric) => (\n                      <div key={metric} className=\"flex items-center gap-2 text-sm\">\n                        <CheckCircle2 className=\"h-4 w-4 text-primary flex-shrink-0\" />\n                        <span>{metric}</span>\n                      </div>\n                    ))}\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Methodology Section ────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Our Process\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Proven Methodology\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              A systematic four-phase approach ensures accurate models and actionable\n              recommendations for every project.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {METHODOLOGY_STEPS.map((step) => (\n              <div key={step.step} className=\"relative\">\n                {/* Step number indicator */}\n                <div className=\"flex items-center gap-3 mb-4\">\n                  <div className=\"h-10 w-10 rounded-full bg-primary text-primary-foreground flex items-center justify-center font-bold text-lg\">\n                    {step.step}\n                  </div>\n                  {step.step < METHODOLOGY_STEPS.length && (\n                    <div className=\"hidden lg:block flex-1 h-px bg-border\" />\n                  )}\n                </div>\n\n                <Card className=\"hover:shadow-md transition-shadow\">\n                  <CardHeader>\n                    <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3\">\n                      <step.icon className=\"h-5 w-5 text-primary\" />\n                    </div>\n                    <CardTitle className=\"text-lg\">{step.title}</CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <CardDescription className=\"text-sm leading-relaxed\">\n                      {step.description}\n                    </CardDescription>\n                  </CardContent>\n                </Card>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Tools Section ──────────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Industry Tools\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Best-in-Class Software\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              We leverage WaterGems and SewerGems, the most trusted names in hydraulic modeling,\n              to deliver precise and reliable results.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 gap-8 max-w-5xl mx-auto\">\n            {TOOLS.map((tool) => (\n              <Card key={tool.name} className=\"overflow-hidden hover:shadow-lg transition-all\">\n                <div className=\"h-2 bg-primary\" />\n                <CardHeader>\n                  <div className=\"flex items-start justify-between\">\n                    <div className=\"flex items-center gap-4\">\n                      <div className=\"h-14 w-14 rounded-lg bg-primary/10 flex items-center justify-center\">\n                        <tool.icon className=\"h-7 w-7 text-primary\" />\n                      </div>\n                      <div>\n                        <CardTitle className=\"text-2xl mb-1\">{tool.name}</CardTitle>\n                        <Badge variant=\"secondary\">{tool.badge}</Badge>\n                      </div>\n                    </div>\n                  </div>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription className=\"text-base leading-relaxed mb-4\">\n                    {tool.description}\n                  </CardDescription>\n                  <div className=\"space-y-2\">\n                    <p className=\"text-sm font-semibold text-foreground\">Capabilities:</p>\n                    {tool.capabilities.map((cap) => (\n                      <div key={cap} className=\"flex items-center gap-2 text-sm\">\n                        <CheckCircle2 className=\"h-4 w-4 text-primary flex-shrink-0\" />\n                        <span>{cap}</span>\n                      </div>\n                    ))}\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Deliverables Section ───────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Project Output\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              What You Receive\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              Every modeling engagement concludes with comprehensive documentation and\n              actionable deliverables tailored to your team's needs.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {DELIVERABLES.map((item) => (\n              <Card key={item.title} className=\"hover:shadow-md transition-shadow\">\n                <CardHeader className=\"flex flex-row items-start gap-4\">\n                  <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n                    <item.icon className=\"h-5 w-5 text-primary\" />\n                  </div>\n                  <div>\n                    <CardTitle className=\"text-lg mb-1\">{item.title}</CardTitle>\n                    <CardDescription>{item.description}</CardDescription>\n                  </div>\n                </CardHeader>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Benefits Section ───────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Client Value\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Measurable Benefits\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              Our hydraulic modeling engagements consistently deliver quantifiable improvements\n              across operational, financial, and compliance dimensions.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n            {BENEFITS.map((benefit) => (\n              <div key={benefit.title} className=\"space-y-4\">\n                <div className=\"flex items-start gap-4\">\n                  <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n                    <benefit.icon className=\"h-6 w-6 text-primary\" />\n                  </div>\n                  <div>\n                    <h3 className=\"font-semibold text-lg\">{benefit.title}</h3>\n                    <p className=\"text-sm text-muted-foreground leading-relaxed\">\n                      {benefit.description}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"pl-16\">\n                  <Badge variant=\"outline\" className=\"text-primary border-primary/30 bg-primary/5\">\n                    {benefit.metric}\n                  </Badge>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── CTA Section ─────────────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"relative rounded-2xl bg-primary text-primary-foreground overflow-hidden\">\n            {/* Background pattern */}\n            <div className=\"absolute inset-0 opacity-10\">\n              <svg\n                viewBox=\"0 0 100 100\"\n                className=\"w-full h-full\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n              >\n                <pattern id=\"dots\" x=\"0\" y=\"0\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"currentColor\" />\n                </pattern>\n                <rect width=\"100%\" height=\"100%\" fill=\"url(#dots)\" />\n              </svg>\n            </div>\n\n            <div className=\"relative z-10 text-center py-16 px-6\">\n              <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n                Ready to Optimize Your Water Network?\n              </h2>\n              <p className=\"text-primary-foreground/80 text-lg max-w-2xl mx-auto mb-8\">\n                Schedule a free assessment with our hydraulic modeling team to discuss your\n                infrastructure challenges and discover how modeling can transform your operations.\n              </p>\n\n              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                <Button\n                  size=\"lg\"\n                  variant=\"secondary\"\n                  className=\"text-primary\"\n                  asChild\n                >\n                  <a href=\"/contact\">\n                    Get Free Assessment\n                    <TrendingUp className=\"ml-2 h-5 w-5\" />\n                  </a>\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  className=\"border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10\"\n                  asChild\n                >\n                  <a href=\"/projects\">\n                    View Our Projects\n                    <Wrench className=\"ml-2 h-5 w-5\" />\n                  </a>\n                </Button>\n              </div>\n\n              {/* Trust indicators */}\n              <div className=\"flex flex-wrap justify-center gap-6 mt-12 text-sm text-primary-foreground/60\">\n                {[\n                  'No Obligation Quote',\n                  'Expert Engineering Team',\n                  'Proven Results',\n                ].map((item) => (\n                  <div key={item} className=\"flex items-center gap-2\">\n                    <CheckCircle2 className=\"h-4 w-4\" />\n                    {item}\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n\nexport default HydraulicNetworkModeling;\n","numLines":558,"startLine":1,"totalLines":558}}}
