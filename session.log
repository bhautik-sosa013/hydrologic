{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WrmU3BMhNakVN5c9WcJPCd","type":"tool_result","content":"1\timport { useState } from 'react';\n2\timport { Link, NavLink, useNavigate } from 'react-router-dom';\n3\timport { Menu, X, Droplets } from 'lucide-react';\n4\timport { cn } from '@/lib/utils';\n5\timport { useIsMobile } from '@/hooks/use-mobile';\n6\timport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\n7\timport { Button } from '@/components/ui/button';\n8\t\n9\t/*\n10\t * TODO: Real API binding — fetch current authenticated user if auth is added\n11\t * import { apiService } from '@/lib/api';\n12\t * const response = await apiService.get({ endpoint: '/auth/me' });\n13\t * setUser(response.data);\n14\t */\n15\t\n16\tconst NAV_ITEMS = [\n17\t  { label: 'Home', path: '/' },\n18\t  { label: 'About Us', path: '/about' },\n19\t  { label: 'Services', path: '/services' },\n20\t  { label: 'Projects', path: '/projects' },\n21\t  { label: 'Technology', path: '/technology' },\n22\t  { label: 'Industries', path: '/industries' },\n23\t  { label: 'Contact', path: '/contact' },\n24\t];\n25\t\n26\tconst navLinkClass = ({ isActive }: { isActive: boolean }) =>\n27\t  cn(\n28\t    'text-sm font-medium transition-colors hover:text-primary',\n29\t    isActive ? 'text-primary' : 'text-foreground/80'\n30\t  );\n31\t\n32\tconst mobileNavLinkClass = ({ isActive }: { isActive: boolean }) =>\n33\t  cn(\n34\t    'block px-3 py-2 rounded-md text-base font-medium transition-colors hover:bg-accent hover:text-accent-foreground',\n35\t    isActive ? 'bg-accent text-accent-foreground' : 'text-foreground/80'\n36\t  );\n37\t\n38\tconst Header = () => {\n39\t  const isMobile = useIsMobile();\n40\t  const [drawerOpen, setDrawerOpen] = useState(false);\n41\t  const navigate = useNavigate();\n42\t\n43\t  const handleLogoClick = () => {\n44\t    navigate('/');\n45\t  };\n46\t\n47\t  return (\n48\t    <header className=\"sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60\">\n49\t      <div className=\"container mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8\">\n50\t        {/* Logo */}\n51\t        <button\n52\t          onClick={handleLogoClick}\n53\t          className=\"flex items-center gap-2 focus:outline-none\"\n54\t          aria-label=\"Go to homepage\"\n55\t        >\n56\t          <Droplets className=\"h-7 w-7 text-primary\" />\n57\t          <span className=\"text-lg font-bold tracking-tight text-foreground\">\n58\t            Hydrologic Innovation\n59\t          </span>\n60\t        </button>\n61\t\n62\t        {/* Desktop nav */}\n63\t        {!isMobile && (\n64\t          <nav className=\"hidden md:flex items-center gap-6\">\n65\t            {NAV_ITEMS.map((item) => (\n66\t              <NavLink\n67\t                key={item.path}\n68\t                to={item.path}\n69\t                end={item.path === '/'}\n70\t                className={navLinkClass}\n71\t              >\n72\t                {item.label}\n73\t              </NavLink>\n74\t            ))}\n75\t          </nav>\n76\t        )}\n77\t\n78\t        {/* Desktop CTA */}\n79\t        {!isMobile && (\n80\t          <div className=\"hidden md:flex items-center gap-3\">\n81\t            <Button asChild size=\"sm\">\n82\t              <Link to=\"/contact\">Get Consultation</Link>\n83\t            </Button>\n84\t          </div>\n85\t        )}\n86\t\n87\t        {/* Mobile hamburger */}\n88\t        {isMobile && (\n89\t          <Sheet open={drawerOpen} onOpenChange={setDrawerOpen}>\n90\t            <SheetTrigger asChild>\n91\t              <Button variant=\"ghost\" size=\"icon\" aria-label=\"Open navigation menu\">\n92\t                {drawerOpen ? <X className=\"h-5 w-5\" /> : <Menu className=\"h-5 w-5\" />}\n93\t              </Button>\n94\t            </SheetTrigger>\n95\t            <SheetContent side=\"right\" className=\"w-72 pt-10\">\n96\t              <div className=\"flex flex-col gap-1 mt-4\">\n97\t                {NAV_ITEMS.map((item) => (\n98\t                  <NavLink\n99\t                    key={item.path}\n100\t                    to={item.path}\n101\t                    end={item.path === '/'}\n102\t                    className={mobileNavLinkClass}\n103\t                    onClick={() => setDrawerOpen(false)}\n104\t                  >\n105\t                    {item.label}\n106\t                  </NavLink>\n107\t                ))}\n108\t                <div className=\"mt-4 px-3\">\n109\t                  <Button asChild className=\"w-full\" onClick={() => setDrawerOpen(false)}>\n110\t                    <Link to=\"/contact\">Get Consultation</Link>\n111\t                  </Button>\n112\t                </div>\n113\t              </div>\n114\t            </SheetContent>\n115\t          </Sheet>\n116\t        )}\n117\t      </div>\n118\t    </header>\n119\t  );\n120\t};\n121\t\n122\texport default Header;\n123\t"}]},"parent_tool_use_id":null,"session_id":"572f6923-00ff-4cf3-9331-5f53f98a9735","uuid":"3cc3ecb6-a200-4e84-96b5-d2057b8402dd","timestamp":"2026-04-18T17:10:30.617Z","tool_use_result":{"type":"text","file":{"filePath":"frontend/src/components/Header.tsx","content":"import { useState } from 'react';\nimport { Link, NavLink, useNavigate } from 'react-router-dom';\nimport { Menu, X, Droplets } from 'lucide-react';\nimport { cn } from '@/lib/utils';\nimport { useIsMobile } from '@/hooks/use-mobile';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport { Button } from '@/components/ui/button';\n\n/*\n * TODO: Real API binding — fetch current authenticated user if auth is added\n * import { apiService } from '@/lib/api';\n * const response = await apiService.get({ endpoint: '/auth/me' });\n * setUser(response.data);\n */\n\nconst NAV_ITEMS = [\n  { label: 'Home', path: '/' },\n  { label: 'About Us', path: '/about' },\n  { label: 'Services', path: '/services' },\n  { label: 'Projects', path: '/projects' },\n  { label: 'Technology', path: '/technology' },\n  { label: 'Industries', path: '/industries' },\n  { label: 'Contact', path: '/contact' },\n];\n\nconst navLinkClass = ({ isActive }: { isActive: boolean }) =>\n  cn(\n    'text-sm font-medium transition-colors hover:text-primary',\n    isActive ? 'text-primary' : 'text-foreground/80'\n  );\n\nconst mobileNavLinkClass = ({ isActive }: { isActive: boolean }) =>\n  cn(\n    'block px-3 py-2 rounded-md text-base font-medium transition-colors hover:bg-accent hover:text-accent-foreground',\n    isActive ? 'bg-accent text-accent-foreground' : 'text-foreground/80'\n  );\n\nconst Header = () => {\n  const isMobile = useIsMobile();\n  const [drawerOpen, setDrawerOpen] = useState(false);\n  const navigate = useNavigate();\n\n  const handleLogoClick = () => {\n    navigate('/');\n  };\n\n  return (\n    <header className=\"sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60\">\n      <div className=\"container mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8\">\n        {/* Logo */}\n        <button\n          onClick={handleLogoClick}\n          className=\"flex items-center gap-2 focus:outline-none\"\n          aria-label=\"Go to homepage\"\n        >\n          <Droplets className=\"h-7 w-7 text-primary\" />\n          <span className=\"text-lg font-bold tracking-tight text-foreground\">\n            Hydrologic Innovation\n          </span>\n        </button>\n\n        {/* Desktop nav */}\n        {!isMobile && (\n          <nav className=\"hidden md:flex items-center gap-6\">\n            {NAV_ITEMS.map((item) => (\n              <NavLink\n                key={item.path}\n                to={item.path}\n                end={item.path === '/'}\n                className={navLinkClass}\n              >\n                {item.label}\n              </NavLink>\n            ))}\n          </nav>\n        )}\n\n        {/* Desktop CTA */}\n        {!isMobile && (\n          <div className=\"hidden md:flex items-center gap-3\">\n            <Button asChild size=\"sm\">\n              <Link to=\"/contact\">Get Consultation</Link>\n            </Button>\n          </div>\n        )}\n\n        {/* Mobile hamburger */}\n        {isMobile && (\n          <Sheet open={drawerOpen} onOpenChange={setDrawerOpen}>\n            <SheetTrigger asChild>\n              <Button variant=\"ghost\" size=\"icon\" aria-label=\"Open navigation menu\">\n                {drawerOpen ? <X className=\"h-5 w-5\" /> : <Menu className=\"h-5 w-5\" />}\n              </Button>\n            </SheetTrigger>\n            <SheetContent side=\"right\" className=\"w-72 pt-10\">\n              <div className=\"flex flex-col gap-1 mt-4\">\n                {NAV_ITEMS.map((item) => (\n                  <NavLink\n                    key={item.path}\n                    to={item.path}\n                    end={item.path === '/'}\n                    className={mobileNavLinkClass}\n                    onClick={() => setDrawerOpen(false)}\n                  >\n                    {item.label}\n                  </NavLink>\n                ))}\n                <div className=\"mt-4 px-3\">\n                  <Button asChild className=\"w-full\" onClick={() => setDrawerOpen(false)}>\n                    <Link to=\"/contact\">Get Consultation</Link>\n                  </Button>\n                </div>\n              </div>\n            </SheetContent>\n          </Sheet>\n        )}\n      </div>\n    </header>\n  );\n};\n\nexport default Header;\n","numLines":123,"startLine":1,"totalLines":123}}}
