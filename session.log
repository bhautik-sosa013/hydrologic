{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_xg6w6znepitv_2","type":"tool_result","content":"1\timport { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';\n2\timport { Badge } from '@/components/ui/badge';\n3\timport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n4\timport { Separator } from '@/components/ui/separator';\n5\timport { getInitials } from '@/lib/utils';\n6\timport {\n7\t  Droplets,\n8\t  Target,\n9\t  Eye,\n10\t  Heart,\n11\t  Award,\n12\t  Users,\n13\t  TrendingUp,\n14\t  Leaf,\n15\t  Lightbulb,\n16\t  Shield,\n17\t} from 'lucide-react';\n18\t\n19\tconst CORE_VALUES = [\n20\t  {\n21\t    icon: Lightbulb,\n22\t    title: 'Innovation',\n23\t    description:\n24\t      'We continuously push the boundaries of hydraulic engineering, adopting cutting-edge tools and methodologies to deliver solutions that were once thought impossible.',\n25\t  },\n26\t  {\n27\t    icon: Leaf,\n28\t    title: 'Sustainability',\n29\t    description:\n30\t      'Environmental stewardship is at the heart of everything we do. We design systems that preserve natural resources and support long-term ecological balance.',\n31\t  },\n32\t  {\n33\t    icon: Shield,\n34\t    title: 'Precision',\n35\t    description:\n36\t      'Our engineering rigor ensures every calculation, every model, and every design meets the highest standards of accuracy and reliability.',\n37\t  },\n38\t  {\n39\t    icon: Users,\n40\t    title: 'Collaboration',\n41\t    description:\n42\t      'We believe the best solutions emerge from partnership. Working closely with clients and communities, we co-create infrastructure that truly serves its people.',\n43\t  },\n44\t];\n45\t\n46\tconst COMPANY_HISTORY = [\n47\t  {\n48\t    year: '2015',\n49\t    milestone: 'Company Founded',\n50\t    description:\n51\t      'Hydrologic Innovation was established with a vision to transform water infrastructure engineering through advanced computational tools.',\n52\t  },\n53\t  {\n54\t    year: '2018',\n55\t    milestone: 'First Major Project',\n56\t    description:\n57\t      'Completed our first large-scale municipal water distribution network modeling project, serving a city of 500,000 residents.',\n58\t  },\n59\t  {\n60\t    year: '2020',\n61\t    milestone: 'Technology Expansion',\n62\t    description:\n63\t      'Integrated GIS platforms and real-time sensor data into our modeling workflow, enabling smarter, more responsive infrastructure designs.',\n64\t  },\n65\t  {\n66\t    year: '2023',\n67\t    milestone: 'Sustainability Focus',\n68\t    description:\n69\t      'Launched dedicated practice areas for stormwater management and water reuse systems, reinforcing our commitment to sustainable engineering.',\n70\t  },\n71\t  {\n72\t    year: '2026',\n73\t    milestone: 'Industry Leadership',\n74\t    description:\n75\t      'Recognized as a regional leader in precision hydraulic modeling, serving clients across municipal, industrial, and agricultural sectors.',\n76\t  },\n77\t];\n78\t\n79\tconst TEAM_CREDENTIALS = [\n80\t  {\n81\t    name: 'Priya Sharma',\n82\t    role: 'Senior Hydraulic Engineer',\n83\t    credential: 'M.Tech Water Resources, IIT Roorkee',\n84\t    experience: '12 years in hydraulic modeling',\n85\t  },\n86\t  {\n87\t    name: 'Rajesh Kumar',\n88\t    role: 'GIS Specialist',\n89\t    credential: 'M.Sc Geoinformatics, University of Hyderabad',\n90\t    experience: '8 years in GIS-integrated water systems',\n91\t  },\n92\t  {\n93\t    name: 'Anita Desai',\n94\t    role: 'Environmental Consultant',\n95\t    credential: 'Ph.D Environmental Engineering, TU Munich',\n96\t    experience: '15 years in sustainable infrastructure',\n97\t  },\n98\t  {\n99\t    name: 'Vikram Patel',\n100\t    role: 'Project Manager',\n101\t    credential: 'MBA Infrastructure Management, IIM Ahmedabad',\n102\t    experience: '10 years in water sector project delivery',\n103\t  },\n104\t];\n105\t\n106\tconst About = () => {\n107\t  return (\n108\t    <div className=\"min-h-screen\">\n109\t      {/* Hero Section */}\n110\t      <section className=\"relative w-full bg-gradient-to-br from-primary/10 via-background to-primary/5 py-16 md:py-24\">\n111\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n112\t          <div className=\"flex flex-col items-center text-center max-w-3xl mx-auto\">\n113\t            <Badge variant=\"secondary\" className=\"mb-4 bg-primary/10 text-primary border-primary/20\">\n114\t              <Droplets className=\"mr-1 h-3 w-3\" />\n115\t              Engineering the Future of Water\n116\t            </Badge>\n117\t            <h1 className=\"text-3xl md:text-5xl font-bold tracking-tight text-foreground\">\n118\t              Hydrologic Innovation\n119\t            </h1>\n120\t            <p className=\"mt-4 text-lg text-muted-foreground leading-relaxed\">\n121\t              Pioneering sustainable water infrastructure through precision engineering and\n122\t              advanced computational tools. We transform complex hydraulic challenges into\n123\t              reliable, eco-conscious solutions that serve communities for generations.\n124\t            </p>\n125\t          </div>\n126\t        </div>\n127\t      </section>\n128\t\n129\t      {/* Vision & Mission Section */}\n130\t      <section className=\"py-16 md:py-20\">\n131\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n132\t          <div className=\"grid md:grid-cols-2 gap-8\">\n133\t            {/* Vision */}\n134\t            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5\">\n135\t              <CardHeader>\n136\t                <div className=\"flex items-center gap-3\">\n137\t                  <div className=\"p-2 rounded-lg bg-primary/10\">\n138\t                    <Eye className=\"h-6 w-6 text-primary\" />\n139\t                  </div>\n140\t                  <CardTitle className=\"text-2xl\">Our Vision</CardTitle>\n141\t                </div>\n142\t              </CardHeader>\n143\t              <CardContent>\n144\t                <p className=\"text-muted-foreground leading-relaxed\">\n145\t                  A world where every community has access to resilient, sustainable water\n146\t                  infrastructure — systems designed with precision, built for longevity, and\n147\t                 Harmonized with the natural water cycle. We envision cities and farms alike\n148\t                  equipped with smart water networks that can adapt to climate variability while\n149\t                  minimizing environmental impact.\n150\t                </p>\n151\t              </CardContent>\n152\t            </Card>\n153\t\n154\t            {/* Mission */}\n155\t            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5\">\n156\t              <CardHeader>\n157\t                <div className=\"flex items-center gap-3\">\n158\t                  <div className=\"p-2 rounded-lg bg-primary/10\">\n159\t                    <Target className=\"h-6 w-6 text-primary\" />\n160\t                  </div>\n161\t                  <CardTitle className=\"text-2xl\">Our Mission</CardTitle>\n162\t                </div>\n163\t              </CardHeader>\n164\t              <CardContent>\n165\t                <p className=\"text-muted-foreground leading-relaxed\">\n166\t                  To deliver precision hydraulic engineering by leveraging advanced simulation\n167\t                  tools, GIS integration, and data-driven modeling. We transform intricate\n168\t                  water infrastructure challenges into practical, cost-effective solutions that\n169\t                  empower municipalities, industries, and agricultural operations to manage\n170\t                  their water resources with confidence and clarity.\n171\t                </p>\n172\t              </CardContent>\n173\t            </Card>\n174\t          </div>\n175\t        </div>\n176\t      </section>\n177\t\n178\t      <Separator className=\"max-w-4xl mx-auto\" />\n179\t\n180\t      {/* Founder Section */}\n181\t      <section className=\"py-16 md:py-20\">\n182\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n183\t          <div className=\"text-center mb-12\">\n184\t            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n185\t              Meet Our Founder\n186\t            </Badge>\n187\t            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">The Mind Behind the Mission</h2>\n188\t          </div>\n189\t\n190\t          <Card className=\"max-w-3xl mx-auto overflow-hidden\">\n191\t            <div className=\"md:flex\">\n192\t              {/* Founder Image */}\n193\t              <div className=\"md:w-2/5 bg-gradient-to-br from-primary/20 to-primary/5 p-8 flex items-center justify-center\">\n194\t                <Avatar className=\"h-48 w-48 md:h-56 md:w-56 border-4 border-background shadow-xl\">\n195\t                  <AvatarImage src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face\" />\n196\t                  <AvatarFallback className=\"bg-primary/20 text-primary text-4xl\">\n197\t                    {getInitials('Jaydeep Lakhlani')}\n198\t                  </AvatarFallback>\n199\t                </Avatar>\n200\t              </div>\n201\t\n202\t              {/* Founder Info */}\n203\t              <div className=\"md:w-3/5 p-6 md:p-8\">\n204\t                <div className=\"flex items-center gap-3 mb-2\">\n205\t                  <h3 className=\"text-2xl font-bold\">Jaydeep Lakhlani</h3>\n206\t                  <Badge variant=\"secondary\" className=\"bg-primary/10 text-primary border-primary/20\">\n207\t                    Founder & Principal Engineer\n208\t                  </Badge>\n209\t                </div>\n210\t                <p className=\"text-sm text-muted-foreground mb-4\">\n211\t                  B.Tech Civil Engineering, IIT Bombay | M.S. Environmental Engineering, Stanford University\n212\t                </p>\n213\t                <p className=\"text-muted-foreground leading-relaxed mb-4\">\n214\t                  With over two decades of experience in hydraulic infrastructure, Jaydeep founded\n215\t                  Hydrologic Innovation with a singular purpose: to bring the precision of modern\n216\t                  computational engineering to water systems that serve communities. His work spans\n217\t                  municipal distribution networks, industrial wastewater systems, and agricultural\n218\t                  irrigation networks across South Asia and beyond.\n219\t                </p>\n220\t                <p className=\"text-muted-foreground leading-relaxed\">\n221\t                  Jaydeep's philosophy centers on the belief that sustainable water infrastructure\n222\t                  is not just an engineering challenge — it is a moral imperative. He leads a team\n223\t                  that treats every project as an opportunity to protect both communities and the\n224\t                  ecosystems they depend on.\n225\t                </p>\n226\t              </div>\n227\t            </div>\n228\t          </Card>\n229\t        </div>\n230\t      </section>\n231\t\n232\t      <Separator className=\"max-w-4xl mx-auto\" />\n233\t\n234\t      {/* Core Values Section */}\n235\t      <section className=\"py-16 md:py-20 bg-gradient-to-br from-background via-primary/5 to-background\">\n236\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n237\t          <div className=\"text-center mb-12\">\n238\t            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n239\t              What Drives Us\n240\t            </Badge>\n241\t            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">Our Core Values</h2>\n242\t            <p className=\"mt-3 text-muted-foreground max-w-2xl mx-auto\">\n243\t              Every decision we make and every system we design is guided by principles that\n244\t              ensure we deliver lasting value to our clients and the environment.\n245\t            </p>\n246\t          </div>\n247\t\n248\t          <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n249\t            {CORE_VALUES.map((value) => (\n250\t              <Card key={value.title} className=\"text-center hover:shadow-lg transition-shadow duration-300\">\n251\t                <CardHeader className=\"pb-2\">\n252\t                  <div className=\"mx-auto p-3 rounded-full bg-primary/10 w-fit mb-4\">\n253\t                    <value.icon className=\"h-6 w-6 text-primary\" />\n254\t                  </div>\n255\t                  <CardTitle className=\"text-lg\">{value.title}</CardTitle>\n256\t                </CardHeader>\n257\t                <CardContent>\n258\t                  <p className=\"text-sm text-muted-foreground\">{value.description}</p>\n259\t                </CardContent>\n260\t              </Card>\n261\t            ))}\n262\t          </div>\n263\t        </div>\n264\t      </section>\n265\t\n266\t      <Separator className=\"max-w-4xl mx-auto\" />\n267\t\n268\t      {/* Company History Section */}\n269\t      <section className=\"py-16 md:py-20\">\n270\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n271\t          <div className=\"text-center mb-12\">\n272\t            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n273\t              Our Journey\n274\t            </Badge>\n275\t            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">Company History</h2>\n276\t            <p className=\"mt-3 text-muted-foreground max-w-2xl mx-auto\">\n277\t              From a small consultancy to a regional leader — a timeline of growth driven by\n278\t              innovation, trust, and an unwavering commitment to water engineering excellence.\n279\t            </p>\n280\t          </div>\n281\t\n282\t          <div className=\"max-w-3xl mx-auto\">\n283\t            {COMPANY_HISTORY.map((item, index) => (\n284\t              <div key={item.year} className=\"relative pl-8 pb-8 last:pb-0\">\n285\t                {/* Timeline line */}\n286\t                {index !== COMPANY_HISTORY.length - 1 && (\n287\t                  <div className=\"absolute left-3 top-3 h-full w-px bg-border\" />\n288\t                )}\n289\t\n290\t                {/* Timeline dot */}\n291\t                <div className=\"absolute left-0 top-1 h-6 w-6 rounded-full bg-primary border-4 border-background shadow\" />\n292\t\n293\t                {/* Content */}\n294\t                <div className=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4\">\n295\t                  <span className=\"text-lg font-bold text-primary\">{item.year}</span>\n296\t                  <div>\n297\t                    <h4 className=\"font-semibold text-foreground\">{item.milestone}</h4>\n298\t                    <p className=\"text-sm text-muted-foreground mt-1\">{item.description}</p>\n299\t                  </div>\n300\t                </div>\n301\t              </div>\n302\t            ))}\n303\t          </div>\n304\t        </div>\n305\t      </section>\n306\t\n307\t      <Separator className=\"max-w-4xl mx-auto\" />\n308\t\n309\t      {/* Team Credentials Section */}\n310\t      <section className=\"py-16 md:py-20 bg-gradient-to-br from-background via-primary/5 to-background\">\n311\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n312\t          <div className=\"text-center mb-12\">\n313\t            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n314\t              Expert Team\n315\t            </Badge>\n316\t            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">Team Credentials</h2>\n317\t            <p className=\"mt-3 text-muted-foreground max-w-2xl mx-auto\">\n318\t              Our multidisciplinary team brings together expertise in hydraulic engineering,\n319\t              environmental science, GIS analytics, and project management to deliver\n320\t              comprehensive water infrastructure solutions.\n321\t            </p>\n322\t          </div>\n323\t\n324\t          <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n325\t            {TEAM_CREDENTIALS.map((member) => (\n326\t              <Card key={member.name} className=\"hover:shadow-lg transition-shadow duration-300\">\n327\t                <CardHeader className=\"pb-2\">\n328\t                  <Avatar className=\"h-16 w-16 mx-auto mb-4\">\n329\t                    <AvatarFallback className=\"bg-primary/10 text-primary text-lg\">\n330\t                      {getInitials(member.name)}\n331\t                    </AvatarFallback>\n332\t                  </Avatar>\n333\t                  <CardTitle className=\"text-center text-base\">{member.name}</CardTitle>\n334\t                  <CardDescription className=\"text-center text-primary font-medium\">\n335\t                    {member.role}\n336\t                  </CardDescription>\n337\t                </CardHeader>\n338\t                <CardContent className=\"text-center\">\n339\t                  <p className=\"text-xs text-muted-foreground mb-1\">{member.credential}</p>\n340\t                  <p className=\"text-xs text-muted-foreground\">{member.experience}</p>\n341\t                </CardContent>\n342\t              </Card>\n343\t            ))}\n344\t          </div>\n345\t        </div>\n346\t      </section>\n347\t\n348\t      {/* Stats/Impact Section */}\n349\t      <section className=\"py-16 md:py-20 border-t border-border\">\n350\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n351\t          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-8 text-center\">\n352\t            <div>\n353\t              <div className=\"flex items-center justify-center gap-2 mb-2\">\n354\t                <TrendingUp className=\"h-6 w-6 text-primary\" />\n355\t                <span className=\"text-3xl md:text-4xl font-bold text-foreground\">10+</span>\n356\t              </div>\n357\t              <p className=\"text-sm text-muted-foreground\">Years of Excellence</p>\n358\t            </div>\n359\t            <div>\n360\t              <div className=\"flex items-center justify-center gap-2 mb-2\">\n361\t                <Droplets className=\"h-6 w-6 text-primary\" />\n362\t                <span className=\"text-3xl md:text-4xl font-bold text-foreground\">50+</span>\n363\t              </div>\n364\t              <p className=\"text-sm text-muted-foreground\">Projects Delivered</p>\n365\t            </div>\n366\t            <div>\n367\t              <div className=\"flex items-center justify-center gap-2 mb-2\">\n368\t                <Users className=\"h-6 w-6 text-primary\" />\n369\t                <span className=\"text-3xl md:text-4xl font-bold text-foreground\">20+</span>\n370\t              </div>\n371\t              <p className=\"text-sm text-muted-foreground\">Team Members</p>\n372\t            </div>\n373\t            <div>\n374\t              <div className=\"flex items-center justify-center gap-2 mb-2\">\n375\t                <Award className=\"h-6 w-6 text-primary\" />\n376\t                <span className=\"text-3xl md:text-4xl font-bold text-foreground\">5</span>\n377\t              </div>\n378\t              <p className=\"text-sm text-muted-foreground\">Industry Awards</p>\n379\t            </div>\n380\t          </div>\n381\t        </div>\n382\t      </section>\n383\t    </div>\n384\t  );\n385\t};\n386\t\n387\texport default About;"}]},"parent_tool_use_id":null,"session_id":"a7acff44-f104-4b18-a19d-824b8719d3af","uuid":"392b9da3-455c-45d4-8dd2-a2cebb3ce0fc","timestamp":"2026-04-18T17:19:56.527Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/code/project-code/code_base/app_7a97b333c52f0a2e89b9d85da46ab74b/frontend/src/pages/About.tsx","content":"import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';\nimport { Badge } from '@/components/ui/badge';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Separator } from '@/components/ui/separator';\nimport { getInitials } from '@/lib/utils';\nimport {\n  Droplets,\n  Target,\n  Eye,\n  Heart,\n  Award,\n  Users,\n  TrendingUp,\n  Leaf,\n  Lightbulb,\n  Shield,\n} from 'lucide-react';\n\nconst CORE_VALUES = [\n  {\n    icon: Lightbulb,\n    title: 'Innovation',\n    description:\n      'We continuously push the boundaries of hydraulic engineering, adopting cutting-edge tools and methodologies to deliver solutions that were once thought impossible.',\n  },\n  {\n    icon: Leaf,\n    title: 'Sustainability',\n    description:\n      'Environmental stewardship is at the heart of everything we do. We design systems that preserve natural resources and support long-term ecological balance.',\n  },\n  {\n    icon: Shield,\n    title: 'Precision',\n    description:\n      'Our engineering rigor ensures every calculation, every model, and every design meets the highest standards of accuracy and reliability.',\n  },\n  {\n    icon: Users,\n    title: 'Collaboration',\n    description:\n      'We believe the best solutions emerge from partnership. Working closely with clients and communities, we co-create infrastructure that truly serves its people.',\n  },\n];\n\nconst COMPANY_HISTORY = [\n  {\n    year: '2015',\n    milestone: 'Company Founded',\n    description:\n      'Hydrologic Innovation was established with a vision to transform water infrastructure engineering through advanced computational tools.',\n  },\n  {\n    year: '2018',\n    milestone: 'First Major Project',\n    description:\n      'Completed our first large-scale municipal water distribution network modeling project, serving a city of 500,000 residents.',\n  },\n  {\n    year: '2020',\n    milestone: 'Technology Expansion',\n    description:\n      'Integrated GIS platforms and real-time sensor data into our modeling workflow, enabling smarter, more responsive infrastructure designs.',\n  },\n  {\n    year: '2023',\n    milestone: 'Sustainability Focus',\n    description:\n      'Launched dedicated practice areas for stormwater management and water reuse systems, reinforcing our commitment to sustainable engineering.',\n  },\n  {\n    year: '2026',\n    milestone: 'Industry Leadership',\n    description:\n      'Recognized as a regional leader in precision hydraulic modeling, serving clients across municipal, industrial, and agricultural sectors.',\n  },\n];\n\nconst TEAM_CREDENTIALS = [\n  {\n    name: 'Priya Sharma',\n    role: 'Senior Hydraulic Engineer',\n    credential: 'M.Tech Water Resources, IIT Roorkee',\n    experience: '12 years in hydraulic modeling',\n  },\n  {\n    name: 'Rajesh Kumar',\n    role: 'GIS Specialist',\n    credential: 'M.Sc Geoinformatics, University of Hyderabad',\n    experience: '8 years in GIS-integrated water systems',\n  },\n  {\n    name: 'Anita Desai',\n    role: 'Environmental Consultant',\n    credential: 'Ph.D Environmental Engineering, TU Munich',\n    experience: '15 years in sustainable infrastructure',\n  },\n  {\n    name: 'Vikram Patel',\n    role: 'Project Manager',\n    credential: 'MBA Infrastructure Management, IIM Ahmedabad',\n    experience: '10 years in water sector project delivery',\n  },\n];\n\nconst About = () => {\n  return (\n    <div className=\"min-h-screen\">\n      {/* Hero Section */}\n      <section className=\"relative w-full bg-gradient-to-br from-primary/10 via-background to-primary/5 py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"flex flex-col items-center text-center max-w-3xl mx-auto\">\n            <Badge variant=\"secondary\" className=\"mb-4 bg-primary/10 text-primary border-primary/20\">\n              <Droplets className=\"mr-1 h-3 w-3\" />\n              Engineering the Future of Water\n            </Badge>\n            <h1 className=\"text-3xl md:text-5xl font-bold tracking-tight text-foreground\">\n              Hydrologic Innovation\n            </h1>\n            <p className=\"mt-4 text-lg text-muted-foreground leading-relaxed\">\n              Pioneering sustainable water infrastructure through precision engineering and\n              advanced computational tools. We transform complex hydraulic challenges into\n              reliable, eco-conscious solutions that serve communities for generations.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Vision & Mission Section */}\n      <section className=\"py-16 md:py-20\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid md:grid-cols-2 gap-8\">\n            {/* Vision */}\n            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5\">\n              <CardHeader>\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"p-2 rounded-lg bg-primary/10\">\n                    <Eye className=\"h-6 w-6 text-primary\" />\n                  </div>\n                  <CardTitle className=\"text-2xl\">Our Vision</CardTitle>\n                </div>\n              </CardHeader>\n              <CardContent>\n                <p className=\"text-muted-foreground leading-relaxed\">\n                  A world where every community has access to resilient, sustainable water\n                  infrastructure — systems designed with precision, built for longevity, and\n                 Harmonized with the natural water cycle. We envision cities and farms alike\n                  equipped with smart water networks that can adapt to climate variability while\n                  minimizing environmental impact.\n                </p>\n              </CardContent>\n            </Card>\n\n            {/* Mission */}\n            <Card className=\"border-primary/20 bg-gradient-to-br from-card to-primary/5\">\n              <CardHeader>\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"p-2 rounded-lg bg-primary/10\">\n                    <Target className=\"h-6 w-6 text-primary\" />\n                  </div>\n                  <CardTitle className=\"text-2xl\">Our Mission</CardTitle>\n                </div>\n              </CardHeader>\n              <CardContent>\n                <p className=\"text-muted-foreground leading-relaxed\">\n                  To deliver precision hydraulic engineering by leveraging advanced simulation\n                  tools, GIS integration, and data-driven modeling. We transform intricate\n                  water infrastructure challenges into practical, cost-effective solutions that\n                  empower municipalities, industries, and agricultural operations to manage\n                  their water resources with confidence and clarity.\n                </p>\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n      </section>\n\n      <Separator className=\"max-w-4xl mx-auto\" />\n\n      {/* Founder Section */}\n      <section className=\"py-16 md:py-20\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-12\">\n            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n              Meet Our Founder\n            </Badge>\n            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">The Mind Behind the Mission</h2>\n          </div>\n\n          <Card className=\"max-w-3xl mx-auto overflow-hidden\">\n            <div className=\"md:flex\">\n              {/* Founder Image */}\n              <div className=\"md:w-2/5 bg-gradient-to-br from-primary/20 to-primary/5 p-8 flex items-center justify-center\">\n                <Avatar className=\"h-48 w-48 md:h-56 md:w-56 border-4 border-background shadow-xl\">\n                  <AvatarImage src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face\" />\n                  <AvatarFallback className=\"bg-primary/20 text-primary text-4xl\">\n                    {getInitials('Jaydeep Lakhlani')}\n                  </AvatarFallback>\n                </Avatar>\n              </div>\n\n              {/* Founder Info */}\n              <div className=\"md:w-3/5 p-6 md:p-8\">\n                <div className=\"flex items-center gap-3 mb-2\">\n                  <h3 className=\"text-2xl font-bold\">Jaydeep Lakhlani</h3>\n                  <Badge variant=\"secondary\" className=\"bg-primary/10 text-primary border-primary/20\">\n                    Founder & Principal Engineer\n                  </Badge>\n                </div>\n                <p className=\"text-sm text-muted-foreground mb-4\">\n                  B.Tech Civil Engineering, IIT Bombay | M.S. Environmental Engineering, Stanford University\n                </p>\n                <p className=\"text-muted-foreground leading-relaxed mb-4\">\n                  With over two decades of experience in hydraulic infrastructure, Jaydeep founded\n                  Hydrologic Innovation with a singular purpose: to bring the precision of modern\n                  computational engineering to water systems that serve communities. His work spans\n                  municipal distribution networks, industrial wastewater systems, and agricultural\n                  irrigation networks across South Asia and beyond.\n                </p>\n                <p className=\"text-muted-foreground leading-relaxed\">\n                  Jaydeep's philosophy centers on the belief that sustainable water infrastructure\n                  is not just an engineering challenge — it is a moral imperative. He leads a team\n                  that treats every project as an opportunity to protect both communities and the\n                  ecosystems they depend on.\n                </p>\n              </div>\n            </div>\n          </Card>\n        </div>\n      </section>\n\n      <Separator className=\"max-w-4xl mx-auto\" />\n\n      {/* Core Values Section */}\n      <section className=\"py-16 md:py-20 bg-gradient-to-br from-background via-primary/5 to-background\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-12\">\n            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n              What Drives Us\n            </Badge>\n            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">Our Core Values</h2>\n            <p className=\"mt-3 text-muted-foreground max-w-2xl mx-auto\">\n              Every decision we make and every system we design is guided by principles that\n              ensure we deliver lasting value to our clients and the environment.\n            </p>\n          </div>\n\n          <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {CORE_VALUES.map((value) => (\n              <Card key={value.title} className=\"text-center hover:shadow-lg transition-shadow duration-300\">\n                <CardHeader className=\"pb-2\">\n                  <div className=\"mx-auto p-3 rounded-full bg-primary/10 w-fit mb-4\">\n                    <value.icon className=\"h-6 w-6 text-primary\" />\n                  </div>\n                  <CardTitle className=\"text-lg\">{value.title}</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <p className=\"text-sm text-muted-foreground\">{value.description}</p>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator className=\"max-w-4xl mx-auto\" />\n\n      {/* Company History Section */}\n      <section className=\"py-16 md:py-20\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-12\">\n            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n              Our Journey\n            </Badge>\n            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">Company History</h2>\n            <p className=\"mt-3 text-muted-foreground max-w-2xl mx-auto\">\n              From a small consultancy to a regional leader — a timeline of growth driven by\n              innovation, trust, and an unwavering commitment to water engineering excellence.\n            </p>\n          </div>\n\n          <div className=\"max-w-3xl mx-auto\">\n            {COMPANY_HISTORY.map((item, index) => (\n              <div key={item.year} className=\"relative pl-8 pb-8 last:pb-0\">\n                {/* Timeline line */}\n                {index !== COMPANY_HISTORY.length - 1 && (\n                  <div className=\"absolute left-3 top-3 h-full w-px bg-border\" />\n                )}\n\n                {/* Timeline dot */}\n                <div className=\"absolute left-0 top-1 h-6 w-6 rounded-full bg-primary border-4 border-background shadow\" />\n\n                {/* Content */}\n                <div className=\"flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4\">\n                  <span className=\"text-lg font-bold text-primary\">{item.year}</span>\n                  <div>\n                    <h4 className=\"font-semibold text-foreground\">{item.milestone}</h4>\n                    <p className=\"text-sm text-muted-foreground mt-1\">{item.description}</p>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator className=\"max-w-4xl mx-auto\" />\n\n      {/* Team Credentials Section */}\n      <section className=\"py-16 md:py-20 bg-gradient-to-br from-background via-primary/5 to-background\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-12\">\n            <Badge variant=\"outline\" className=\"mb-4 border-primary/30 text-primary\">\n              Expert Team\n            </Badge>\n            <h2 className=\"text-2xl md:text-3xl font-bold tracking-tight\">Team Credentials</h2>\n            <p className=\"mt-3 text-muted-foreground max-w-2xl mx-auto\">\n              Our multidisciplinary team brings together expertise in hydraulic engineering,\n              environmental science, GIS analytics, and project management to deliver\n              comprehensive water infrastructure solutions.\n            </p>\n          </div>\n\n          <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {TEAM_CREDENTIALS.map((member) => (\n              <Card key={member.name} className=\"hover:shadow-lg transition-shadow duration-300\">\n                <CardHeader className=\"pb-2\">\n                  <Avatar className=\"h-16 w-16 mx-auto mb-4\">\n                    <AvatarFallback className=\"bg-primary/10 text-primary text-lg\">\n                      {getInitials(member.name)}\n                    </AvatarFallback>\n                  </Avatar>\n                  <CardTitle className=\"text-center text-base\">{member.name}</CardTitle>\n                  <CardDescription className=\"text-center text-primary font-medium\">\n                    {member.role}\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"text-center\">\n                  <p className=\"text-xs text-muted-foreground mb-1\">{member.credential}</p>\n                  <p className=\"text-xs text-muted-foreground\">{member.experience}</p>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Stats/Impact Section */}\n      <section className=\"py-16 md:py-20 border-t border-border\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-8 text-center\">\n            <div>\n              <div className=\"flex items-center justify-center gap-2 mb-2\">\n                <TrendingUp className=\"h-6 w-6 text-primary\" />\n                <span className=\"text-3xl md:text-4xl font-bold text-foreground\">10+</span>\n              </div>\n              <p className=\"text-sm text-muted-foreground\">Years of Excellence</p>\n            </div>\n            <div>\n              <div className=\"flex items-center justify-center gap-2 mb-2\">\n                <Droplets className=\"h-6 w-6 text-primary\" />\n                <span className=\"text-3xl md:text-4xl font-bold text-foreground\">50+</span>\n              </div>\n              <p className=\"text-sm text-muted-foreground\">Projects Delivered</p>\n            </div>\n            <div>\n              <div className=\"flex items-center justify-center gap-2 mb-2\">\n                <Users className=\"h-6 w-6 text-primary\" />\n                <span className=\"text-3xl md:text-4xl font-bold text-foreground\">20+</span>\n              </div>\n              <p className=\"text-sm text-muted-foreground\">Team Members</p>\n            </div>\n            <div>\n              <div className=\"flex items-center justify-center gap-2 mb-2\">\n                <Award className=\"h-6 w-6 text-primary\" />\n                <span className=\"text-3xl md:text-4xl font-bold text-foreground\">5</span>\n              </div>\n              <p className=\"text-sm text-muted-foreground\">Industry Awards</p>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n\nexport default About;","numLines":387,"startLine":1,"totalLines":387}}}
