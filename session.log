{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_xg6w6znepitv_1","type":"tool_result","content":"1\timport { Link } from 'react-router-dom';\n2\timport {\n3\t  Droplets,\n4\t  Cpu,\n5\t  Globe,\n6\t  Shield,\n7\t  Zap,\n8\t  Users,\n9\t  ArrowRight,\n10\t  CheckCircle2,\n11\t  ChevronRight,\n12\t  Activity,\n13\t  BarChart3,\n14\t  MapPin,\n15\t  Wrench,\n16\t  Droplet,\n17\t} from 'lucide-react';\n18\timport { Button } from '@/components/ui/button';\n19\timport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n20\timport { Badge } from '@/components/ui/badge';\n21\timport { Separator } from '@/components/ui/separator';\n22\timport { toast } from '@/lib/toast';\n23\t\n24\t// ── Mock data for Services section ─────────────────────────────────────────\n25\t\n26\tconst SERVICES = [\n27\t  {\n28\t    icon: Activity,\n29\t    title: 'Hydraulic Network Modeling',\n30\t    description:\n31\t      'Advanced simulation and modeling of water distribution networks to optimize performance and identify potential issues before they occur.',\n32\t    path: '/services/hydraulic-network-modeling',\n33\t  },\n34\t  {\n35\t    icon: Droplet,\n36\t    title: 'Water Treatment Plant Design',\n37\t    description:\n38\t      'Comprehensive design services for modern water treatment facilities, ensuring compliance with environmental standards and public health requirements.',\n39\t    path: '/services/water-treatment-plant-design',\n40\t  },\n41\t  {\n42\t    icon: Wrench,\n43\t    title: 'Sewage Treatment Plant Design',\n44\t    description:\n45\t      'Innovative sewage treatment solutions that protect communities and ecosystems while meeting regulatory requirements.',\n46\t    path: '/services/sewage-treatment-plant-design',\n47\t  },\n48\t  {\n49\t    icon: Globe,\n50\t    title: 'GIS Integration',\n51\t    description:\n52\t      'Geographic Information System integration for spatial analysis, asset management, and informed decision-making across water infrastructure.',\n53\t    path: '/services/gis-integration',\n54\t  },\n55\t  {\n56\t    icon: Shield,\n57\t    title: 'Environmental & Irrigation Consulting',\n58\t    description:\n59\t      'Expert guidance on sustainable water usage, irrigation optimization, and environmental impact assessments.',\n60\t    path: '/services/environmental-and-irrigation-consulting',\n61\t  },\n62\t];\n63\t\n64\t// ── Mock data for Why Choose Us section ─────────────────────────────────────\n65\t\n66\tconst DIFFERENTIATORS = [\n67\t  {\n68\t    icon: Cpu,\n69\t    title: 'AI-Powered Analytics',\n70\t    description:\n71\t      'Leveraging machine learning algorithms to predict system failures and optimize water distribution efficiency.',\n72\t  },\n73\t  {\n74\t    icon: BarChart3,\n75\t    title: 'Real-Time Monitoring',\n76\t    description:\n77\t      '24/7 dashboard visibility into network performance, pressure zones, and flow rates across your entire infrastructure.',\n78\t  },\n79\t  {\n80\t    icon: MapPin,\n81\t    title: 'Precision Mapping',\n82\t    description:\n83\t      'Sub-meter accurate GIS data integrated with hydraulic models for unmatched spatial intelligence.',\n84\t  },\n85\t  {\n86\t    icon: Users,\n87\t    title: 'Expert Team',\n88\t    description:\n89\t      'Decades of combined experience in hydrology, environmental engineering, and water resource management.',\n90\t  },\n91\t];\n92\t\n93\t// ── Mock data for Technology section ───────────────────────────────────────\n94\t\n95\tconst TECHNOLOGIES = [\n96\t  {\n97\t    name: 'WaterGems',\n98\t    description:\n99\t      'Industry-leading hydraulic modeling software for water distribution network analysis, fire flow testing, and infrastructure planning.',\n100\t    badge: 'Water Distribution',\n101\t  },\n102\t  {\n103\t    name: 'SewerGems',\n104\t    description:\n105\t      'Comprehensive sewer and stormwater modeling solution for collection system design, rehabilitation planning, and overflow analysis.',\n106\t    badge: 'Sewer Systems',\n107\t  },\n108\t];\n109\t\n110\t// ── Animated Water Flow SVG ──────────────────────────────────────────────────\n111\t\n112\tconst WaterFlowAnimation = () => (\n113\t  <div className=\"absolute inset-0 overflow-hidden rounded-xl\">\n114\t    <svg\n115\t      viewBox=\"0 0 800 400\"\n116\t      className=\"w-full h-full\"\n117\t      xmlns=\"http://www.w3.org/2000/svg\"\n118\t      preserveAspectRatio=\"xMidYMid slice\"\n119\t    >\n120\t      <defs>\n121\t        <linearGradient id=\"waterGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n122\t          <stop offset=\"0%\" stopColor=\"rgba(59, 130, 246, 0.3)\" />\n123\t          <stop offset=\"50%\" stopColor=\"rgba(14, 165, 233, 0.5)\" />\n124\t          <stop offset=\"100%\" stopColor=\"rgba(59, 130, 246, 0.3)\" />\n125\t        </linearGradient>\n126\t        <filter id=\"glow\">\n127\t          <feGaussianBlur stdDeviation=\"3\" result=\"coloredBlur\" />\n128\t          <feMerge>\n129\t            <feMergeNode in=\"coloredBlur\" />\n130\t            <feMergeNode in=\"SourceGraphic\" />\n131\t          </feMerge>\n132\t        </filter>\n133\t      </defs>\n134\t\n135\t      {/* Animated wave layers */}\n136\t      <g className=\"animate-[wave_8s_ease-in-out_infinite]\">\n137\t        <path\n138\t          d=\"M0,200 Q200,150 400,200 T800,200 L800,400 L0,400 Z\"\n139\t          fill=\"url(#waterGradient)\"\n140\t          opacity=\"0.4\"\n141\t        />\n142\t      </g>\n143\t      <g className=\"animate-[wave_6s_ease-in-out_infinite_reverse]\">\n144\t        <path\n145\t          d=\"M0,220 Q200,180 400,220 T800,220 L800,400 L0,400 Z\"\n146\t          fill=\"url(#waterGradient)\"\n147\t          opacity=\"0.3\"\n148\t        />\n149\t      </g>\n150\t      <g className=\"animate-[wave_10s_ease-in-out_infinite]\">\n151\t        <path\n152\t          d=\"M0,250 Q200,220 400,250 T800,250 L800,400 L0,400 Z\"\n153\t          fill=\"url(#waterGradient)\"\n154\t          opacity=\"0.2\"\n155\t        />\n156\t      </g>\n157\t\n158\t      {/* Flow particles */}\n159\t      {Array.from({ length: 12 }).map((_, i) => (\n160\t        <circle\n161\t          key={i}\n162\t          cx={50 + i * 65}\n163\t          cy={180 + Math.sin(i * 0.8) * 30}\n164\t          r={3 + (i % 3)}\n165\t          fill=\"rgba(14, 165, 233, 0.6)\"\n166\t          filter=\"url(#glow)\"\n167\t          className=\"animate-[pulse_2s_ease-in-out_infinite]\"\n168\t          style={{ animationDelay: `${i * 0.2}s` }}\n169\t        />\n170\t      ))}\n171\t    </svg>\n172\t\n173\t    {/* Overlay gradient for text readability */}\n174\t    <div className=\"absolute inset-0 bg-gradient-to-t from-background/80 via-background/20 to-transparent\" />\n175\t  </div>\n176\t);\n177\t\n178\t// ── Home Page ─────────────────────────────────────────────────────────────────\n179\t\n180\tconst Home = () => {\n181\t  const handleGetConsultation = () => {\n182\t    toast.success('Redirecting to consultation form', {\n183\t      description: 'Our team will get back to you within 24 hours.',\n184\t    });\n185\t  };\n186\t\n187\t  return (\n188\t    <div className=\"flex flex-col min-h-screen\">\n189\t      {/* ── Hero Section ────────────────────────────────────────────────── */}\n190\t      <section className=\"relative w-full py-16 md:py-24 lg:py-32 overflow-hidden\">\n191\t        <div className=\"container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n192\t          <div className=\"grid lg:grid-cols-2 gap-12 items-center\">\n193\t            {/* Hero text content */}\n194\t            <div className=\"flex flex-col space-y-8\">\n195\t              <div className=\"space-y-6\">\n196\t                <Badge variant=\"outline\" className=\"w-fit text-primary border-primary/50\">\n197\t                  <Droplets className=\"mr-1 h-3 w-3\" />\n198\t                  Engineering Water Systems\n199\t                </Badge>\n200\t\n201\t                <h1 className=\"text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight\">\n202\t                  Engineering Intelligent Water Systems for a{' '}\n203\t                  <span className=\"text-primary\">Sustainable Future</span>\n204\t                </h1>\n205\t\n206\t                <p className=\"text-lg text-muted-foreground max-w-xl\">\n207\t                  Hydrologic Innovation delivers cutting-edge hydraulic modeling, water treatment\n208\t                  design, and GIS-powered infrastructure solutions for municipalities and industries\n209\t                  worldwide.\n210\t                </p>\n211\t              </div>\n212\t\n213\t              {/* CTA Buttons */}\n214\t              <div className=\"flex flex-col sm:flex-row gap-4\">\n215\t                <Button size=\"lg\" asChild onClick={handleGetConsultation}>\n216\t                  <Link to=\"/contact\">\n217\t                    Get Consultation\n218\t                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n219\t                  </Link>\n220\t                </Button>\n221\t                <Button size=\"lg\" variant=\"outline\" asChild>\n222\t                  <Link to=\"/services\">\n223\t                    Explore Services\n224\t                    <ChevronRight className=\"ml-2 h-5 w-5\" />\n225\t                  </Link>\n226\t                </Button>\n227\t              </div>\n228\t\n229\t              {/* Trust indicators */}\n230\t              <div className=\"flex flex-wrap gap-6 pt-4\">\n231\t                {[\n232\t                  { value: '150+', label: 'Projects Delivered' },\n233\t                  { value: '30+', label: 'Years Experience' },\n234\t                  { value: '50+', label: 'Municipal Clients' },\n235\t                ].map((stat) => (\n236\t                  <div key={stat.label} className=\"text-center sm:text-left\">\n237\t                    <div className=\"text-2xl font-bold text-primary\">{stat.value}</div>\n238\t                    <div className=\"text-sm text-muted-foreground\">{stat.label}</div>\n239\t                  </div>\n240\t                ))}\n241\t              </div>\n242\t            </div>\n243\t\n244\t            {/* Hero visual - animated water flow */}\n245\t            <div className=\"relative h-[400px] lg:h-[500px] rounded-xl overflow-hidden\">\n246\t              <WaterFlowAnimation />\n247\t\n248\t              {/* Floating stats cards */}\n249\t              <div className=\"absolute top-6 right-6 bg-background/90 backdrop-blur-sm rounded-lg p-4 shadow-lg animate-[float_3s_ease-in-out_infinite]\">\n250\t                <div className=\"flex items-center gap-3\">\n251\t                  <div className=\"h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center\">\n252\t                    <Zap className=\"h-5 w-5 text-primary\" />\n253\t                  </div>\n254\t                  <div>\n255\t                    <div className=\"text-sm font-semibold\">Efficiency</div>\n256\t                    <div className=\"text-xs text-muted-foreground\">+40% optimization</div>\n257\t                  </div>\n258\t                </div>\n259\t              </div>\n260\t\n261\t              <div className=\"absolute bottom-6 left-6 bg-background/90 backdrop-blur-sm rounded-lg p-4 shadow-lg animate-[float_3s_ease-in-out_infinite_reverse]\">\n262\t                <div className=\"flex items-center gap-3\">\n263\t                  <div className=\"h-10 w-10 rounded-full bg-green-500/10 flex items-center justify-center\">\n264\t                    <Shield className=\"h-5 w-5 text-green-600\" />\n265\t                  </div>\n266\t                  <div>\n267\t                    <div className=\"text-sm font-semibold\">Compliance</div>\n268\t                    <div className=\"text-xs text-muted-foreground\">100% regulatory</div>\n269\t                  </div>\n270\t                </div>\n271\t              </div>\n272\t            </div>\n273\t          </div>\n274\t        </div>\n275\t      </section>\n276\t\n277\t      <Separator />\n278\t\n279\t      {/* ── Services Overview Section ───────────────────────────────────── */}\n280\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n281\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n282\t          {/* Section header */}\n283\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n284\t            <Badge variant=\"secondary\" className=\"mb-4\">\n285\t              Our Expertise\n286\t            </Badge>\n287\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n288\t              Comprehensive Water Solutions\n289\t            </h2>\n290\t            <p className=\"text-muted-foreground text-lg\">\n291\t              From hydraulic modeling to environmental consulting, we provide end-to-end services\n292\t              for water infrastructure projects of any scale.\n293\t            </p>\n294\t          </div>\n295\t\n296\t          {/* Services grid */}\n297\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n298\t            {SERVICES.map((service) => (\n299\t              <Card\n300\t                key={service.title}\n301\t                className=\"group hover:shadow-lg transition-all duration-300 hover:-translate-y-1 border-muted\"\n302\t              >\n303\t                <CardHeader>\n304\t                  <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors\">\n305\t                    <service.icon className=\"h-6 w-6 text-primary\" />\n306\t                  </div>\n307\t                  <CardTitle className=\"text-xl\">{service.title}</CardTitle>\n308\t                </CardHeader>\n309\t                <CardContent>\n310\t                  <CardDescription className=\"text-base leading-relaxed\">\n311\t                    {service.description}\n312\t                  </CardDescription>\n313\t                  <Button\n314\t                    variant=\"link\"\n315\t                    className=\"px-0 mt-4 text-primary group-hover:underline\"\n316\t                    asChild\n317\t                  >\n318\t                    <Link to={service.path}>\n319\t                      Learn more\n320\t                      <ChevronRight className=\"ml-1 h-4 w-4\" />\n321\t                    </Link>\n322\t                  </Button>\n323\t                </CardContent>\n324\t              </Card>\n325\t            ))}\n326\t          </div>\n327\t        </div>\n328\t      </section>\n329\t\n330\t      <Separator />\n331\t\n332\t      {/* ── Why Choose Us Section ───────────────────────────────────────── */}\n333\t      <section className=\"w-full py-16 md:py-24\">\n334\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n335\t          <div className=\"grid lg:grid-cols-2 gap-14 items-center\">\n336\t            {/* Content */}\n337\t            <div className=\"space-y-8\">\n338\t              <div>\n339\t                <Badge variant=\"outline\" className=\"mb-4 text-primary border-primary/50\">\n340\t                  Why Hydrologic Innovation\n341\t                </Badge>\n342\t                <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n343\t                  Technology-Driven, People-Focused\n344\t                </h2>\n345\t                <p className=\"text-muted-foreground text-lg\">\n346\t                  We combine decades of hydrology expertise with modern AI and GIS technologies to\n347\t                  deliver solutions that are both technically superior and practically implementable.\n348\t                </p>\n349\t              </div>\n350\t\n351\t              <div className=\"space-y-5\">\n352\t                {DIFFERENTIATORS.map((item) => (\n353\t                  <div key={item.title} className=\"flex gap-4\">\n354\t                    <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n355\t                      <item.icon className=\"h-5 w-5 text-primary\" />\n356\t                    </div>\n357\t                    <div>\n358\t                      <h3 className=\"font-semibold text-lg mb-1\">{item.title}</h3>\n359\t                      <p className=\"text-muted-foreground text-sm leading-relaxed\">\n360\t                        {item.description}\n361\t                      </p>\n362\t                    </div>\n363\t                  </div>\n364\t                ))}\n365\t              </div>\n366\t\n367\t              <Button size=\"lg\" asChild>\n368\t                <Link to=\"/about\">\n369\t                  Learn About Our Team\n370\t                  <ArrowRight className=\"ml-2 h-5 w-5\" />\n371\t                </Link>\n372\t              </Button>\n373\t            </div>\n374\t\n375\t            {/* Visual - stats/achievements */}\n376\t            <div className=\"grid grid-cols-2 gap-5\">\n377\t              {[\n378\t                { value: '99.8%', label: 'Model Accuracy', icon: Activity },\n379\t                { value: '24/7', label: 'Monitoring', icon: BarChart3 },\n380\t                { value: '100+', label: 'Cities Served', icon: Globe },\n381\t                { value: '$2B+', label: 'Infrastructure Managed', icon: MapPin },\n382\t              ].map((stat) => (\n383\t                <Card key={stat.label} className=\"text-center p-6 hover:shadow-md transition-shadow\">\n384\t                  <stat.icon className=\"h-8 w-8 text-primary mx-auto mb-3\" />\n385\t                  <div className=\"text-3xl font-bold text-primary mb-1\">{stat.value}</div>\n386\t                  <div className=\"text-sm text-muted-foreground\">{stat.label}</div>\n387\t                </Card>\n388\t              ))}\n389\t            </div>\n390\t          </div>\n391\t        </div>\n392\t      </section>\n393\t\n394\t      <Separator />\n395\t\n396\t      {/* ── Technology Section ─────────────────────────────────────────── */}\n397\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n398\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n399\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n400\t            <Badge variant=\"secondary\" className=\"mb-4\">\n401\t              Tools & Technology\n402\t            </Badge>\n403\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n404\t              Industry-Leading Software\n405\t            </h2>\n406\t            <p className=\"text-muted-foreground text-lg\">\n407\t              We leverage best-in-class hydraulic modeling and GIS platforms to deliver precise,\n408\t              reliable results for every project.\n409\t            </p>\n410\t          </div>\n411\t\n412\t          <div className=\"grid md:grid-cols-2 gap-8 max-w-4xl mx-auto\">\n413\t            {TECHNOLOGIES.map((tech) => (\n414\t              <Card key={tech.name} className=\"overflow-hidden hover:shadow-lg transition-all\">\n415\t                <div className=\"h-2 bg-primary\" />\n416\t                <CardHeader>\n417\t                  <div className=\"flex items-start justify-between\">\n418\t                    <div>\n419\t                      <CardTitle className=\"text-2xl mb-2\">{tech.name}</CardTitle>\n420\t                      <Badge variant=\"secondary\">{tech.badge}</Badge>\n421\t                    </div>\n422\t                    <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center\">\n423\t                      <Droplets className=\"h-6 w-6 text-primary\" />\n424\t                    </div>\n425\t                  </div>\n426\t                </CardHeader>\n427\t                <CardContent>\n428\t                  <CardDescription className=\"text-base leading-relaxed\">\n429\t                    {tech.description}\n430\t                  </CardDescription>\n431\t                  <Button variant=\"link\" className=\"px-0 mt-4 text-primary\" asChild>\n432\t                    <Link to=\"/technology\">\n433\t                      Explore our tech stack\n434\t                      <ChevronRight className=\"ml-1 h-4 w-4\" />\n435\t                    </Link>\n436\t                  </Button>\n437\t                </CardContent>\n438\t              </Card>\n439\t            ))}\n440\t          </div>\n441\t        </div>\n442\t      </section>\n443\t\n444\t      <Separator />\n445\t\n446\t      {/* ── CTA Section ─────────────────────────────────────────────────── */}\n447\t      <section className=\"w-full py-16 md:py-24\">\n448\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n449\t          <div className=\"relative rounded-2xl bg-primary text-primary-foreground overflow-hidden\">\n450\t            {/* Background pattern */}\n451\t            <div className=\"absolute inset-0 opacity-10\">\n452\t              <svg\n453\t                viewBox=\"0 0 100 100\"\n454\t                className=\"w-full h-full\"\n455\t                xmlns=\"http://www.w3.org/2000/svg\"\n456\t              >\n457\t                <pattern id=\"dots\" x=\"0\" y=\"0\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n458\t                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"currentColor\" />\n459\t                </pattern>\n460\t                <rect width=\"100%\" height=\"100%\" fill=\"url(#dots)\" />\n461\t              </svg>\n462\t            </div>\n463\t\n464\t            <div className=\"relative z-10 text-center py-16 px-6\">\n465\t              <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n466\t                Ready to Transform Your Water Infrastructure?\n467\t              </h2>\n468\t              <p className=\"text-primary-foreground/80 text-lg max-w-2xl mx-auto mb-8\">\n469\t                Schedule a free consultation with our engineering team to discuss your project\n470\t                requirements and discover how we can help.\n471\t              </p>\n472\t\n473\t              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n474\t                <Button\n475\t                  size=\"lg\"\n476\t                  variant=\"secondary\"\n477\t                  className=\"text-primary\"\n478\t                  asChild\n479\t                  onClick={handleGetConsultation}\n480\t                >\n481\t                  <Link to=\"/contact\">\n482\t                    Get a Free Consultation\n483\t                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n484\t                  </Link>\n485\t                </Button>\n486\t                <Button\n487\t                  size=\"lg\"\n488\t                  variant=\"outline\"\n489\t                  className=\"border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10\"\n490\t                  asChild\n491\t                >\n492\t                  <Link to=\"/projects\">\n493\t                    View Our Projects\n494\t                    <ChevronRight className=\"ml-2 h-5 w-5\" />\n495\t                  </Link>\n496\t                </Button>\n497\t              </div>\n498\t\n499\t              {/* Trust badges */}\n500\t              <div className=\"flex flex-wrap justify-center gap-6 mt-12 text-sm text-primary-foreground/60\">\n501\t                {[\n502\t                  'Free Initial Assessment',\n503\t                  'No Obligation Quote',\n504\t                  'Dedicated Project Manager',\n505\t                ].map((item) => (\n506\t                  <div key={item} className=\"flex items-center gap-2\">\n507\t                    <CheckCircle2 className=\"h-4 w-4\" />\n508\t                    {item}\n509\t                  </div>\n510\t                ))}\n511\t              </div>\n512\t            </div>\n513\t          </div>\n514\t        </div>\n515\t      </section>\n516\t\n517\t      {/* ── Custom CSS for animations ─────────────────────────────────── */}\n518\t      <style>{`\n519\t        @keyframes wave {\n520\t          0%, 100% { transform: translateX(0); }\n521\t          50% { transform: translateX(-20px); }\n522\t        }\n523\t        @keyframes float {\n524\t          0%, 100% { transform: translateY(0); }\n525\t          50% { transform: translateY(-8px); }\n526\t        }\n527\t        @keyframes pulse {\n528\t          0%, 100% { opacity: 0.6; }\n529\t          50% { opacity: 1; }\n530\t        }\n531\t      `}</style>\n532\t    </div>\n533\t  );\n534\t};\n535\t\n536\texport default Home;\n537\t"}]},"parent_tool_use_id":null,"session_id":"a7acff44-f104-4b18-a19d-824b8719d3af","uuid":"19499d27-e954-4f20-87b4-e0bd153ae0ff","timestamp":"2026-04-18T17:19:55.696Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/code/project-code/code_base/app_7a97b333c52f0a2e89b9d85da46ab74b/frontend/src/pages/Home.tsx","content":"import { Link } from 'react-router-dom';\nimport {\n  Droplets,\n  Cpu,\n  Globe,\n  Shield,\n  Zap,\n  Users,\n  ArrowRight,\n  CheckCircle2,\n  ChevronRight,\n  Activity,\n  BarChart3,\n  MapPin,\n  Wrench,\n  Droplet,\n} from 'lucide-react';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport { Separator } from '@/components/ui/separator';\nimport { toast } from '@/lib/toast';\n\n// ── Mock data for Services section ─────────────────────────────────────────\n\nconst SERVICES = [\n  {\n    icon: Activity,\n    title: 'Hydraulic Network Modeling',\n    description:\n      'Advanced simulation and modeling of water distribution networks to optimize performance and identify potential issues before they occur.',\n    path: '/services/hydraulic-network-modeling',\n  },\n  {\n    icon: Droplet,\n    title: 'Water Treatment Plant Design',\n    description:\n      'Comprehensive design services for modern water treatment facilities, ensuring compliance with environmental standards and public health requirements.',\n    path: '/services/water-treatment-plant-design',\n  },\n  {\n    icon: Wrench,\n    title: 'Sewage Treatment Plant Design',\n    description:\n      'Innovative sewage treatment solutions that protect communities and ecosystems while meeting regulatory requirements.',\n    path: '/services/sewage-treatment-plant-design',\n  },\n  {\n    icon: Globe,\n    title: 'GIS Integration',\n    description:\n      'Geographic Information System integration for spatial analysis, asset management, and informed decision-making across water infrastructure.',\n    path: '/services/gis-integration',\n  },\n  {\n    icon: Shield,\n    title: 'Environmental & Irrigation Consulting',\n    description:\n      'Expert guidance on sustainable water usage, irrigation optimization, and environmental impact assessments.',\n    path: '/services/environmental-and-irrigation-consulting',\n  },\n];\n\n// ── Mock data for Why Choose Us section ─────────────────────────────────────\n\nconst DIFFERENTIATORS = [\n  {\n    icon: Cpu,\n    title: 'AI-Powered Analytics',\n    description:\n      'Leveraging machine learning algorithms to predict system failures and optimize water distribution efficiency.',\n  },\n  {\n    icon: BarChart3,\n    title: 'Real-Time Monitoring',\n    description:\n      '24/7 dashboard visibility into network performance, pressure zones, and flow rates across your entire infrastructure.',\n  },\n  {\n    icon: MapPin,\n    title: 'Precision Mapping',\n    description:\n      'Sub-meter accurate GIS data integrated with hydraulic models for unmatched spatial intelligence.',\n  },\n  {\n    icon: Users,\n    title: 'Expert Team',\n    description:\n      'Decades of combined experience in hydrology, environmental engineering, and water resource management.',\n  },\n];\n\n// ── Mock data for Technology section ───────────────────────────────────────\n\nconst TECHNOLOGIES = [\n  {\n    name: 'WaterGems',\n    description:\n      'Industry-leading hydraulic modeling software for water distribution network analysis, fire flow testing, and infrastructure planning.',\n    badge: 'Water Distribution',\n  },\n  {\n    name: 'SewerGems',\n    description:\n      'Comprehensive sewer and stormwater modeling solution for collection system design, rehabilitation planning, and overflow analysis.',\n    badge: 'Sewer Systems',\n  },\n];\n\n// ── Animated Water Flow SVG ──────────────────────────────────────────────────\n\nconst WaterFlowAnimation = () => (\n  <div className=\"absolute inset-0 overflow-hidden rounded-xl\">\n    <svg\n      viewBox=\"0 0 800 400\"\n      className=\"w-full h-full\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      preserveAspectRatio=\"xMidYMid slice\"\n    >\n      <defs>\n        <linearGradient id=\"waterGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stopColor=\"rgba(59, 130, 246, 0.3)\" />\n          <stop offset=\"50%\" stopColor=\"rgba(14, 165, 233, 0.5)\" />\n          <stop offset=\"100%\" stopColor=\"rgba(59, 130, 246, 0.3)\" />\n        </linearGradient>\n        <filter id=\"glow\">\n          <feGaussianBlur stdDeviation=\"3\" result=\"coloredBlur\" />\n          <feMerge>\n            <feMergeNode in=\"coloredBlur\" />\n            <feMergeNode in=\"SourceGraphic\" />\n          </feMerge>\n        </filter>\n      </defs>\n\n      {/* Animated wave layers */}\n      <g className=\"animate-[wave_8s_ease-in-out_infinite]\">\n        <path\n          d=\"M0,200 Q200,150 400,200 T800,200 L800,400 L0,400 Z\"\n          fill=\"url(#waterGradient)\"\n          opacity=\"0.4\"\n        />\n      </g>\n      <g className=\"animate-[wave_6s_ease-in-out_infinite_reverse]\">\n        <path\n          d=\"M0,220 Q200,180 400,220 T800,220 L800,400 L0,400 Z\"\n          fill=\"url(#waterGradient)\"\n          opacity=\"0.3\"\n        />\n      </g>\n      <g className=\"animate-[wave_10s_ease-in-out_infinite]\">\n        <path\n          d=\"M0,250 Q200,220 400,250 T800,250 L800,400 L0,400 Z\"\n          fill=\"url(#waterGradient)\"\n          opacity=\"0.2\"\n        />\n      </g>\n\n      {/* Flow particles */}\n      {Array.from({ length: 12 }).map((_, i) => (\n        <circle\n          key={i}\n          cx={50 + i * 65}\n          cy={180 + Math.sin(i * 0.8) * 30}\n          r={3 + (i % 3)}\n          fill=\"rgba(14, 165, 233, 0.6)\"\n          filter=\"url(#glow)\"\n          className=\"animate-[pulse_2s_ease-in-out_infinite]\"\n          style={{ animationDelay: `${i * 0.2}s` }}\n        />\n      ))}\n    </svg>\n\n    {/* Overlay gradient for text readability */}\n    <div className=\"absolute inset-0 bg-gradient-to-t from-background/80 via-background/20 to-transparent\" />\n  </div>\n);\n\n// ── Home Page ─────────────────────────────────────────────────────────────────\n\nconst Home = () => {\n  const handleGetConsultation = () => {\n    toast.success('Redirecting to consultation form', {\n      description: 'Our team will get back to you within 24 hours.',\n    });\n  };\n\n  return (\n    <div className=\"flex flex-col min-h-screen\">\n      {/* ── Hero Section ────────────────────────────────────────────────── */}\n      <section className=\"relative w-full py-16 md:py-24 lg:py-32 overflow-hidden\">\n        <div className=\"container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid lg:grid-cols-2 gap-12 items-center\">\n            {/* Hero text content */}\n            <div className=\"flex flex-col space-y-8\">\n              <div className=\"space-y-6\">\n                <Badge variant=\"outline\" className=\"w-fit text-primary border-primary/50\">\n                  <Droplets className=\"mr-1 h-3 w-3\" />\n                  Engineering Water Systems\n                </Badge>\n\n                <h1 className=\"text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight\">\n                  Engineering Intelligent Water Systems for a{' '}\n                  <span className=\"text-primary\">Sustainable Future</span>\n                </h1>\n\n                <p className=\"text-lg text-muted-foreground max-w-xl\">\n                  Hydrologic Innovation delivers cutting-edge hydraulic modeling, water treatment\n                  design, and GIS-powered infrastructure solutions for municipalities and industries\n                  worldwide.\n                </p>\n              </div>\n\n              {/* CTA Buttons */}\n              <div className=\"flex flex-col sm:flex-row gap-4\">\n                <Button size=\"lg\" asChild onClick={handleGetConsultation}>\n                  <Link to=\"/contact\">\n                    Get Consultation\n                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n                  </Link>\n                </Button>\n                <Button size=\"lg\" variant=\"outline\" asChild>\n                  <Link to=\"/services\">\n                    Explore Services\n                    <ChevronRight className=\"ml-2 h-5 w-5\" />\n                  </Link>\n                </Button>\n              </div>\n\n              {/* Trust indicators */}\n              <div className=\"flex flex-wrap gap-6 pt-4\">\n                {[\n                  { value: '150+', label: 'Projects Delivered' },\n                  { value: '30+', label: 'Years Experience' },\n                  { value: '50+', label: 'Municipal Clients' },\n                ].map((stat) => (\n                  <div key={stat.label} className=\"text-center sm:text-left\">\n                    <div className=\"text-2xl font-bold text-primary\">{stat.value}</div>\n                    <div className=\"text-sm text-muted-foreground\">{stat.label}</div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Hero visual - animated water flow */}\n            <div className=\"relative h-[400px] lg:h-[500px] rounded-xl overflow-hidden\">\n              <WaterFlowAnimation />\n\n              {/* Floating stats cards */}\n              <div className=\"absolute top-6 right-6 bg-background/90 backdrop-blur-sm rounded-lg p-4 shadow-lg animate-[float_3s_ease-in-out_infinite]\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center\">\n                    <Zap className=\"h-5 w-5 text-primary\" />\n                  </div>\n                  <div>\n                    <div className=\"text-sm font-semibold\">Efficiency</div>\n                    <div className=\"text-xs text-muted-foreground\">+40% optimization</div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"absolute bottom-6 left-6 bg-background/90 backdrop-blur-sm rounded-lg p-4 shadow-lg animate-[float_3s_ease-in-out_infinite_reverse]\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"h-10 w-10 rounded-full bg-green-500/10 flex items-center justify-center\">\n                    <Shield className=\"h-5 w-5 text-green-600\" />\n                  </div>\n                  <div>\n                    <div className=\"text-sm font-semibold\">Compliance</div>\n                    <div className=\"text-xs text-muted-foreground\">100% regulatory</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Services Overview Section ───────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          {/* Section header */}\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Our Expertise\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Comprehensive Water Solutions\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              From hydraulic modeling to environmental consulting, we provide end-to-end services\n              for water infrastructure projects of any scale.\n            </p>\n          </div>\n\n          {/* Services grid */}\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {SERVICES.map((service) => (\n              <Card\n                key={service.title}\n                className=\"group hover:shadow-lg transition-all duration-300 hover:-translate-y-1 border-muted\"\n              >\n                <CardHeader>\n                  <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors\">\n                    <service.icon className=\"h-6 w-6 text-primary\" />\n                  </div>\n                  <CardTitle className=\"text-xl\">{service.title}</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription className=\"text-base leading-relaxed\">\n                    {service.description}\n                  </CardDescription>\n                  <Button\n                    variant=\"link\"\n                    className=\"px-0 mt-4 text-primary group-hover:underline\"\n                    asChild\n                  >\n                    <Link to={service.path}>\n                      Learn more\n                      <ChevronRight className=\"ml-1 h-4 w-4\" />\n                    </Link>\n                  </Button>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Why Choose Us Section ───────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid lg:grid-cols-2 gap-14 items-center\">\n            {/* Content */}\n            <div className=\"space-y-8\">\n              <div>\n                <Badge variant=\"outline\" className=\"mb-4 text-primary border-primary/50\">\n                  Why Hydrologic Innovation\n                </Badge>\n                <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n                  Technology-Driven, People-Focused\n                </h2>\n                <p className=\"text-muted-foreground text-lg\">\n                  We combine decades of hydrology expertise with modern AI and GIS technologies to\n                  deliver solutions that are both technically superior and practically implementable.\n                </p>\n              </div>\n\n              <div className=\"space-y-5\">\n                {DIFFERENTIATORS.map((item) => (\n                  <div key={item.title} className=\"flex gap-4\">\n                    <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n                      <item.icon className=\"h-5 w-5 text-primary\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold text-lg mb-1\">{item.title}</h3>\n                      <p className=\"text-muted-foreground text-sm leading-relaxed\">\n                        {item.description}\n                      </p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n              <Button size=\"lg\" asChild>\n                <Link to=\"/about\">\n                  Learn About Our Team\n                  <ArrowRight className=\"ml-2 h-5 w-5\" />\n                </Link>\n              </Button>\n            </div>\n\n            {/* Visual - stats/achievements */}\n            <div className=\"grid grid-cols-2 gap-5\">\n              {[\n                { value: '99.8%', label: 'Model Accuracy', icon: Activity },\n                { value: '24/7', label: 'Monitoring', icon: BarChart3 },\n                { value: '100+', label: 'Cities Served', icon: Globe },\n                { value: '$2B+', label: 'Infrastructure Managed', icon: MapPin },\n              ].map((stat) => (\n                <Card key={stat.label} className=\"text-center p-6 hover:shadow-md transition-shadow\">\n                  <stat.icon className=\"h-8 w-8 text-primary mx-auto mb-3\" />\n                  <div className=\"text-3xl font-bold text-primary mb-1\">{stat.value}</div>\n                  <div className=\"text-sm text-muted-foreground\">{stat.label}</div>\n                </Card>\n              ))}\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Technology Section ─────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Tools & Technology\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Industry-Leading Software\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              We leverage best-in-class hydraulic modeling and GIS platforms to deliver precise,\n              reliable results for every project.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 gap-8 max-w-4xl mx-auto\">\n            {TECHNOLOGIES.map((tech) => (\n              <Card key={tech.name} className=\"overflow-hidden hover:shadow-lg transition-all\">\n                <div className=\"h-2 bg-primary\" />\n                <CardHeader>\n                  <div className=\"flex items-start justify-between\">\n                    <div>\n                      <CardTitle className=\"text-2xl mb-2\">{tech.name}</CardTitle>\n                      <Badge variant=\"secondary\">{tech.badge}</Badge>\n                    </div>\n                    <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center\">\n                      <Droplets className=\"h-6 w-6 text-primary\" />\n                    </div>\n                  </div>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription className=\"text-base leading-relaxed\">\n                    {tech.description}\n                  </CardDescription>\n                  <Button variant=\"link\" className=\"px-0 mt-4 text-primary\" asChild>\n                    <Link to=\"/technology\">\n                      Explore our tech stack\n                      <ChevronRight className=\"ml-1 h-4 w-4\" />\n                    </Link>\n                  </Button>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── CTA Section ─────────────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"relative rounded-2xl bg-primary text-primary-foreground overflow-hidden\">\n            {/* Background pattern */}\n            <div className=\"absolute inset-0 opacity-10\">\n              <svg\n                viewBox=\"0 0 100 100\"\n                className=\"w-full h-full\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n              >\n                <pattern id=\"dots\" x=\"0\" y=\"0\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"currentColor\" />\n                </pattern>\n                <rect width=\"100%\" height=\"100%\" fill=\"url(#dots)\" />\n              </svg>\n            </div>\n\n            <div className=\"relative z-10 text-center py-16 px-6\">\n              <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n                Ready to Transform Your Water Infrastructure?\n              </h2>\n              <p className=\"text-primary-foreground/80 text-lg max-w-2xl mx-auto mb-8\">\n                Schedule a free consultation with our engineering team to discuss your project\n                requirements and discover how we can help.\n              </p>\n\n              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                <Button\n                  size=\"lg\"\n                  variant=\"secondary\"\n                  className=\"text-primary\"\n                  asChild\n                  onClick={handleGetConsultation}\n                >\n                  <Link to=\"/contact\">\n                    Get a Free Consultation\n                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n                  </Link>\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  className=\"border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10\"\n                  asChild\n                >\n                  <Link to=\"/projects\">\n                    View Our Projects\n                    <ChevronRight className=\"ml-2 h-5 w-5\" />\n                  </Link>\n                </Button>\n              </div>\n\n              {/* Trust badges */}\n              <div className=\"flex flex-wrap justify-center gap-6 mt-12 text-sm text-primary-foreground/60\">\n                {[\n                  'Free Initial Assessment',\n                  'No Obligation Quote',\n                  'Dedicated Project Manager',\n                ].map((item) => (\n                  <div key={item} className=\"flex items-center gap-2\">\n                    <CheckCircle2 className=\"h-4 w-4\" />\n                    {item}\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* ── Custom CSS for animations ─────────────────────────────────── */}\n      <style>{`\n        @keyframes wave {\n          0%, 100% { transform: translateX(0); }\n          50% { transform: translateX(-20px); }\n        }\n        @keyframes float {\n          0%, 100% { transform: translateY(0); }\n          50% { transform: translateY(-8px); }\n        }\n        @keyframes pulse {\n          0%, 100% { opacity: 0.6; }\n          50% { opacity: 1; }\n        }\n      `}</style>\n    </div>\n  );\n};\n\nexport default Home;\n","numLines":537,"startLine":1,"totalLines":537}}}
