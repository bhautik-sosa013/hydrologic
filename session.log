{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_xg6w6znepitv_5","type":"tool_result","content":"1\timport { useNavigate } from 'react-router-dom';\n2\timport {\n3\t  ArrowLeft,\n4\t  Droplet,\n5\t  CheckCircle2,\n6\t  Shield,\n7\t  Globe,\n8\t  Settings,\n9\t  BarChart3,\n10\t  Wrench,\n11\t  Users,\n12\t  FileText,\n13\t  Award,\n14\t  Clock,\n15\t  Target,\n16\t  Zap,\n17\t} from 'lucide-react';\n18\timport { Button } from '@/components/ui/button';\n19\timport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n20\timport { Badge } from '@/components/ui/badge';\n21\timport { Separator } from '@/components/ui/separator';\n22\timport { toast } from '@/lib/toast';\n23\t\n24\t// ── Page config ───────────────────────────────────────────────────────────────\n25\t\n26\tconst PAGE_CONFIG = {\n27\t  title: 'Water Treatment Plant Design',\n28\t  subtitle: 'Engineering Sustainable Water Solutions',\n29\t  description:\n30\t    'Hydrologic Innovation delivers comprehensive water treatment plant design services, guiding projects from initial feasibility assessment through detailed engineering design and regulatory compliance. Our team specializes in scalable, cost-effective WTP solutions for government municipalities and industrial clients.',\n31\t  heroStat: '150+',\n32\t  heroStatLabel: 'WTP Projects Delivered',\n33\t};\n34\t\n35\t// ── Design Process Phases ─────────────────────────────────────────────────────\n36\t\n37\tconst DESIGN_PHASES = [\n38\t  {\n39\t    phase: '01',\n40\t    title: 'Feasibility Assessment',\n41\t    description:\n42\t      'Comprehensive analysis of source water quality, flow requirements, and regulatory standards. We evaluate site conditions, environmental impacts, and budget constraints to determine the most effective treatment approach.',\n43\t    icon: FileText,\n44\t  },\n45\t  {\n46\t    phase: '02',\n47\t    title: 'Conceptual Design',\n48\t    description:\n49\t      'Development of treatment process alternatives with preliminary sizing, capital cost estimates, and operational requirement assessments. We present trade-off analyses to stakeholders for informed decision-making.',\n50\t    icon: Target,\n51\t  },\n52\t  {\n53\t    phase: '03',\n54\t    title: 'Detailed Engineering',\n55\t    description:\n56\t      'Complete hydraulic and process design including structural, mechanical, and electrical specifications. All drawings, specifications, and technical documents are prepared for construction bidding and permitting.',\n57\t    icon: Settings,\n58\t  },\n59\t  {\n60\t    phase: '04',\n61\t    title: 'Compliance & Certification',\n62\t    description:\n63\t      'Coordination with regulatory agencies to secure environmental permits, operational licenses, and safety certifications. We ensure all designs meet or exceed EPA, state, and local water quality standards.',\n64\t    icon: Shield,\n65\t  },\n66\t];\n67\t\n68\t// ── Core Capabilities ─────────────────────────────────────────────────────────\n69\t\n70\tconst CAPABILITIES = [\n71\t  {\n72\t    title: 'Conventional Treatment',\n73\t    description:\n74\t      'Full-scale conventional treatment trains including coagulation, flocculation, sedimentation, and rapid sand filtration for municipal water supplies.',\n75\t  },\n76\t  {\n77\t    title: 'Advanced Filtration',\n78\t    description:\n79\t      'Membrane technologies including microfiltration, ultrafiltration, and nanofiltration for superior pathogen removal and taste improvement.',\n80\t  },\n81\t  {\n82\t    title: 'Disinfection Systems',\n83\t    description:\n84\t      'Chlorination, UV radiation, and ozone disinfection systems designed for optimal pathogen inactivation while minimizing disinfection byproducts.',\n85\t  },\n86\t  {\n87\t    title: 'Sludge Management',\n88\t    description:\n89\t      'Thickening, dewatering, and residuals handling systems that meet environmental disposal requirements and reduce operational costs.',\n90\t  },\n91\t  {\n92\t    title: 'Chemical Dosing',\n93\t    description:\n94\t      'Precise chemical feed systems for pH adjustment, corrosion control, and enhanced coagulation using SCADA-controlled dosing pumps.',\n95\t  },\n96\t  {\n97\t    title: 'Automation & Control',\n98\t    description:\n99\t      'Full plant automation with real-time monitoring, remote operation capabilities, and predictive maintenance algorithms.',\n100\t  },\n101\t];\n102\t\n103\t// ── Technologies & Standards ───────────────────────────────────────────────────\n104\t\n105\tconst TECHNOLOGIES = [\n106\t  { name: 'WaterGEMS', use: 'Hydraulic modeling & pipe network analysis' },\n107\t  { name: 'AutoCAD', use: 'Detailed engineering drawings & as-built documentation' },\n108\t  { name: 'EPANET', use: 'Water quality modeling & distribution analysis' },\n109\t  { name: 'CSAFE', use: 'Advanced treatment process simulation' },\n110\t  { name: 'SCADA', use: 'Real-time plant monitoring & control systems' },\n111\t];\n112\t\n113\t// TODO: fetch from backend config API when available\n114\tconst DESIGN_STANDARDS = [\n115\t  'EPA National Primary Drinking Water Regulations',\n116\t  'AWWA Standards for Water Treatment',\n117\t  'NSF/ANSI 60 & 61 for Chemical Safety',\n118\t  'ISO 9001 Quality Management',\n119\t  'OSHA Safety Standards for Industrial Facilities',\n120\t];\n121\t\n122\t// ── Project Scale Metrics ─────────────────────────────────────────────────────\n123\t\n124\tconst PROJECT_METRICS = [\n125\t  { value: '150+', label: 'WTP Projects', icon: Droplet },\n126\t  { value: '50M+', label: 'Gallons/Day Capacity', icon: BarChart3 },\n127\t  { value: '30+', label: 'Years Experience', icon: Clock },\n128\t  { value: '100%', label: 'Regulatory Compliance', icon: Award },\n129\t];\n130\t\n131\t// ── Client Types ──────────────────────────────────────────────────────────────\n132\t\n133\tconst CLIENT_TYPES = [\n134\t  {\n135\t    title: 'Municipal Governments',\n136\t    description:\n137\t      'Cities, counties, and regional water districts requiring new treatment facilities or upgrades to existing infrastructure for population growth and regulatory compliance.',\n138\t    icon: Globe,\n139\t  },\n140\t  {\n141\t    title: 'Industrial Facilities',\n142\t    description:\n143\t      'Manufacturing plants, power generation facilities, and commercial developments needing custom water treatment solutions for process water, boiler feed, or wastewater pretreatment.',\n144\t    icon: Settings,\n145\t  },\n146\t  {\n147\t    title: 'Federal & State Agencies',\n148\t    description:\n149\t      'Defense installations, federal complexes, and state-run facilities requiring reliable, compliant water treatment systems with stringent quality assurance requirements.',\n150\t    icon: Shield,\n151\t  },\n152\t];\n153\t\n154\t// ── Page Component ─────────────────────────────────────────────────────────────\n155\t\n156\tconst WaterTreatmentPlantDesign = () => {\n157\t  const navigate = useNavigate();\n158\t\n159\t  const handleContactClick = () => {\n160\t    toast.success('Contact request initiated', {\n161\t      description: 'Our WTP engineering team will reach out within 24 hours.',\n162\t    });\n163\t    navigate('/contact');\n164\t  };\n165\t\n166\t  return (\n167\t    <div className=\"flex flex-col min-h-screen\">\n168\t      {/* ── Hero Section ────────────────────────────────────────────────── */}\n169\t      <section className=\"relative w-full py-12 md:py-20 overflow-hidden\">\n170\t        <div className=\"container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n171\t          {/* Back button */}\n172\t          <Button\n173\t            variant=\"ghost\"\n174\t            size=\"sm\"\n175\t            onClick={() => navigate(-1)}\n176\t            className=\"mb-6 pl-0 hover:pl-0 hover:bg-transparent hover:text-primary\"\n177\t          >\n178\t            <ArrowLeft className=\"mr-2 h-4 w-4\" />\n179\t            Back to Services\n180\t          </Button>\n181\t\n182\t          <div className=\"grid lg:grid-cols-2 gap-12 items-center\">\n183\t            {/* Hero text content */}\n184\t            <div className=\"flex flex-col space-y-6\">\n185\t              <div className=\"space-y-4\">\n186\t                <Badge variant=\"outline\" className=\"w-fit text-primary border-primary/50\">\n187\t                  <Droplet className=\"mr-1 h-3 w-3\" />\n188\t                  Engineering Services\n189\t                </Badge>\n190\t\n191\t                <h1 className=\"text-4xl md:text-5xl font-bold tracking-tight leading-tight\">\n192\t                  {PAGE_CONFIG.title}\n193\t                </h1>\n194\t\n195\t                <p className=\"text-xl text-muted-foreground font-medium\">\n196\t                  {PAGE_CONFIG.subtitle}\n197\t                </p>\n198\t\n199\t                <p className=\"text-base text-muted-foreground leading-relaxed max-w-xl\">\n200\t                  {PAGE_CONFIG.description}\n201\t                </p>\n202\t              </div>\n203\t\n204\t              {/* CTA Buttons */}\n205\t              <div className=\"flex flex-col sm:flex-row gap-3\">\n206\t                <Button size=\"lg\" onClick={handleContactClick}>\n207\t                  Request Consultation\n208\t                </Button>\n209\t                <Button size=\"lg\" variant=\"outline\" onClick={() => navigate('/projects')}>\n210\t                  View Our Projects\n211\t                </Button>\n212\t              </div>\n213\t            </div>\n214\t\n215\t            {/* Hero visual - stats grid */}\n216\t            <div className=\"grid grid-cols-2 gap-4\">\n217\t              {PROJECT_METRICS.map((metric) => (\n218\t                <Card key={metric.label} className=\"text-center p-6 hover:shadow-md transition-shadow\">\n219\t                  <metric.icon className=\"h-8 w-8 text-primary mx-auto mb-3\" />\n220\t                  <div className=\"text-3xl font-bold text-primary mb-1\">{metric.value}</div>\n221\t                  <div className=\"text-sm text-muted-foreground\">{metric.label}</div>\n222\t                </Card>\n223\t              ))}\n224\t            </div>\n225\t          </div>\n226\t        </div>\n227\t      </section>\n228\t\n229\t      <Separator />\n230\t\n231\t      {/* ── Design Process Section ──────────────────────────────────────── */}\n232\t      <section className=\"w-full py-16 md:py-24\">\n233\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n234\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n235\t            <Badge variant=\"secondary\" className=\"mb-4\">\n236\t              Our Methodology\n237\t            </Badge>\n238\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n239\t              End-to-End Design Process\n240\t            </h2>\n241\t            <p className=\"text-muted-foreground text-lg\">\n242\t              From initial feasibility studies to regulatory approval, our structured approach\n243\t              ensures every project meets technical requirements and stays within budget and schedule.\n244\t            </p>\n245\t          </div>\n246\t\n247\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n248\t            {DESIGN_PHASES.map((phase) => (\n249\t              <Card key={phase.phase} className=\"relative overflow-hidden hover:shadow-lg transition-all\">\n250\t                <div className=\"h-1 bg-primary\" />\n251\t                <CardHeader>\n252\t                  <div className=\"flex items-center gap-3 mb-2\">\n253\t                    <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center\">\n254\t                      <phase.icon className=\"h-5 w-5 text-primary\" />\n255\t                    </div>\n256\t                    <span className=\"text-sm font-mono text-muted-foreground\">{phase.phase}</span>\n257\t                  </div>\n258\t                  <CardTitle className=\"text-lg\">{phase.title}</CardTitle>\n259\t                </CardHeader>\n260\t                <CardContent>\n261\t                  <CardDescription className=\"text-sm leading-relaxed\">\n262\t                    {phase.description}\n263\t                  </CardDescription>\n264\t                </CardContent>\n265\t              </Card>\n266\t            ))}\n267\t          </div>\n268\t        </div>\n269\t      </section>\n270\t\n271\t      <Separator />\n272\t\n273\t      {/* ── Core Capabilities Section ──────────────────────────────────── */}\n274\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n275\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n276\t          <div className=\"grid lg:grid-cols-2 gap-14 items-center\">\n277\t            {/* Content */}\n278\t            <div className=\"space-y-8\">\n279\t              <div>\n280\t                <Badge variant=\"outline\" className=\"mb-4 text-primary border-primary/50\">\n281\t                  Technical Expertise\n282\t                </Badge>\n283\t                <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n284\t                  Core Capabilities\n285\t                </h2>\n286\t                <p className=\"text-muted-foreground text-lg\">\n287\t                  Our engineering team brings decades of hands-on experience designing water treatment\n288\t                  facilities that reliably produce safe drinking water while minimizing operational costs.\n289\t                </p>\n290\t              </div>\n291\t\n292\t              <div className=\"space-y-4\">\n293\t                {CAPABILITIES.map((cap) => (\n294\t                  <div key={cap.title} className=\"flex gap-4\">\n295\t                    <div className=\"h-8 w-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5\">\n296\t                      <CheckCircle2 className=\"h-4 w-4 text-primary\" />\n297\t                    </div>\n298\t                    <div>\n299\t                      <h3 className=\"font-semibold mb-1\">{cap.title}</h3>\n300\t                      <p className=\"text-sm text-muted-foreground leading-relaxed\">\n301\t                        {cap.description}\n302\t                      </p>\n303\t                    </div>\n304\t                  </div>\n305\t                ))}\n306\t              </div>\n307\t            </div>\n308\t\n309\t            {/* Visual - technology card */}\n310\t            <div className=\"space-y-6\">\n311\t              <Card className=\"overflow-hidden\">\n312\t                <div className=\"h-2 bg-primary\" />\n313\t                <CardHeader>\n314\t                  <CardTitle className=\"text-xl\">Technologies We Use</CardTitle>\n315\t                  <CardDescription>\n316\t                    Industry-leading software and control systems\n317\t                  </CardDescription>\n318\t                </CardHeader>\n319\t                <CardContent>\n320\t                  <div className=\"space-y-4\">\n321\t                    {TECHNOLOGIES.map((tech) => (\n322\t                      <div\n323\t                        key={tech.name}\n324\t                        className=\"flex items-center justify-between py-2 border-b last:border-0\"\n325\t                      >\n326\t                        <div className=\"flex items-center gap-3\">\n327\t                          <div className=\"h-8 w-8 rounded bg-primary/10 flex items-center justify-center\">\n328\t                            <Zap className=\"h-4 w-4 text-primary\" />\n329\t                          </div>\n330\t                          <span className=\"font-medium\">{tech.name}</span>\n331\t                        </div>\n332\t                        <span className=\"text-sm text-muted-foreground text-right\">\n333\t                          {tech.use}\n334\t                        </span>\n335\t                      </div>\n336\t                    ))}\n337\t                  </div>\n338\t                </CardContent>\n339\t              </Card>\n340\t\n341\t              <Card>\n342\t                <CardHeader>\n343\t                  <CardTitle className=\"text-lg\">Design Standards</CardTitle>\n344\t                </CardHeader>\n345\t                <CardContent>\n346\t                  <div className=\"flex flex-wrap gap-2\">\n347\t                    {DESIGN_STANDARDS.map((standard) => (\n348\t                      <Badge key={standard} variant=\"secondary\">\n349\t                        {standard}\n350\t                      </Badge>\n351\t                    ))}\n352\t                  </div>\n353\t                </CardContent>\n354\t              </Card>\n355\t            </div>\n356\t          </div>\n357\t        </div>\n358\t      </section>\n359\t\n360\t      <Separator />\n361\t\n362\t      {/* ── Client Types Section ────────────────────────────────────────── */}\n363\t      <section className=\"w-full py-16 md:py-24\">\n364\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n365\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n366\t            <Badge variant=\"secondary\" className=\"mb-4\">\n367\t              Who We Serve\n368\t            </Badge>\n369\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n370\t              Trusted by Leading Organizations\n371\t            </h2>\n372\t            <p className=\"text-muted-foreground text-lg\">\n373\t              Our water treatment plant design expertise serves diverse clients across government,\n374\t              industrial, and federal sectors with customized solutions for every scale of operation.\n375\t            </p>\n376\t          </div>\n377\t\n378\t          <div className=\"grid md:grid-cols-3 gap-6\">\n379\t            {CLIENT_TYPES.map((client) => (\n380\t              <Card key={client.title} className=\"hover:shadow-lg transition-all\">\n381\t                <CardHeader>\n382\t                  <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n383\t                    <client.icon className=\"h-6 w-6 text-primary\" />\n384\t                  </div>\n385\t                  <CardTitle className=\"text-xl\">{client.title}</CardTitle>\n386\t                </CardHeader>\n387\t                <CardContent>\n388\t                  <CardDescription className=\"text-base leading-relaxed\">\n389\t                    {client.description}\n390\t                  </CardDescription>\n391\t                </CardContent>\n392\t              </Card>\n393\t            ))}\n394\t          </div>\n395\t        </div>\n396\t      </section>\n397\t\n398\t      <Separator />\n399\t\n400\t      {/* ── CTA Section ─────────────────────────────────────────────────── */}\n401\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n402\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n403\t          <div className=\"relative rounded-2xl bg-primary text-primary-foreground overflow-hidden\">\n404\t            {/* Background pattern */}\n405\t            <div className=\"absolute inset-0 opacity-10\">\n406\t              <svg\n407\t                viewBox=\"0 0 100 100\"\n408\t                className=\"w-full h-full\"\n409\t                xmlns=\"http://www.w3.org/2000/svg\"\n410\t              >\n411\t                <pattern id=\"dots\" x=\"0\" y=\"0\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n412\t                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"currentColor\" />\n413\t                </pattern>\n414\t                <rect width=\"100%\" height=\"100%\" fill=\"url(#dots)\" />\n415\t              </svg>\n416\t            </div>\n417\t\n418\t            <div className=\"relative z-10 text-center py-16 px-6\">\n419\t              <Users className=\"h-12 w-12 mx-auto mb-4 opacity-80\" />\n420\t              <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n421\t                Ready to Start Your WTP Project?\n422\t              </h2>\n423\t              <p className=\"text-primary-foreground/80 text-lg max-w-2xl mx-auto mb-8\">\n424\t                Our engineering team has the expertise to design a water treatment solution\n425\t                that meets your capacity requirements, budget constraints, and regulatory obligations.\n426\t              </p>\n427\t\n428\t              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n429\t                <Button\n430\t                  size=\"lg\"\n431\t                  variant=\"secondary\"\n432\t                  className=\"text-primary\"\n433\t                  onClick={handleContactClick}\n434\t                >\n435\t                  Schedule a Consultation\n436\t                </Button>\n437\t                <Button\n438\t                  size=\"lg\"\n439\t                  variant=\"outline\"\n440\t                  className=\"border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10\"\n441\t                  onClick={() => navigate('/projects')}\n442\t                >\n443\t                  View Past Projects\n444\t                </Button>\n445\t              </div>\n446\t            </div>\n447\t          </div>\n448\t        </div>\n449\t      </section>\n450\t    </div>\n451\t  );\n452\t};\n453\t\n454\texport default WaterTreatmentPlantDesign;\n455\t"}]},"parent_tool_use_id":null,"session_id":"a7acff44-f104-4b18-a19d-824b8719d3af","uuid":"78366961-0f2c-43c8-9fc1-0c67d8f855bd","timestamp":"2026-04-18T17:19:57.936Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/code/project-code/code_base/app_7a97b333c52f0a2e89b9d85da46ab74b/frontend/src/pages/WaterTreatmentPlantDesign.tsx","content":"import { useNavigate } from 'react-router-dom';\nimport {\n  ArrowLeft,\n  Droplet,\n  CheckCircle2,\n  Shield,\n  Globe,\n  Settings,\n  BarChart3,\n  Wrench,\n  Users,\n  FileText,\n  Award,\n  Clock,\n  Target,\n  Zap,\n} from 'lucide-react';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport { Separator } from '@/components/ui/separator';\nimport { toast } from '@/lib/toast';\n\n// ── Page config ───────────────────────────────────────────────────────────────\n\nconst PAGE_CONFIG = {\n  title: 'Water Treatment Plant Design',\n  subtitle: 'Engineering Sustainable Water Solutions',\n  description:\n    'Hydrologic Innovation delivers comprehensive water treatment plant design services, guiding projects from initial feasibility assessment through detailed engineering design and regulatory compliance. Our team specializes in scalable, cost-effective WTP solutions for government municipalities and industrial clients.',\n  heroStat: '150+',\n  heroStatLabel: 'WTP Projects Delivered',\n};\n\n// ── Design Process Phases ─────────────────────────────────────────────────────\n\nconst DESIGN_PHASES = [\n  {\n    phase: '01',\n    title: 'Feasibility Assessment',\n    description:\n      'Comprehensive analysis of source water quality, flow requirements, and regulatory standards. We evaluate site conditions, environmental impacts, and budget constraints to determine the most effective treatment approach.',\n    icon: FileText,\n  },\n  {\n    phase: '02',\n    title: 'Conceptual Design',\n    description:\n      'Development of treatment process alternatives with preliminary sizing, capital cost estimates, and operational requirement assessments. We present trade-off analyses to stakeholders for informed decision-making.',\n    icon: Target,\n  },\n  {\n    phase: '03',\n    title: 'Detailed Engineering',\n    description:\n      'Complete hydraulic and process design including structural, mechanical, and electrical specifications. All drawings, specifications, and technical documents are prepared for construction bidding and permitting.',\n    icon: Settings,\n  },\n  {\n    phase: '04',\n    title: 'Compliance & Certification',\n    description:\n      'Coordination with regulatory agencies to secure environmental permits, operational licenses, and safety certifications. We ensure all designs meet or exceed EPA, state, and local water quality standards.',\n    icon: Shield,\n  },\n];\n\n// ── Core Capabilities ─────────────────────────────────────────────────────────\n\nconst CAPABILITIES = [\n  {\n    title: 'Conventional Treatment',\n    description:\n      'Full-scale conventional treatment trains including coagulation, flocculation, sedimentation, and rapid sand filtration for municipal water supplies.',\n  },\n  {\n    title: 'Advanced Filtration',\n    description:\n      'Membrane technologies including microfiltration, ultrafiltration, and nanofiltration for superior pathogen removal and taste improvement.',\n  },\n  {\n    title: 'Disinfection Systems',\n    description:\n      'Chlorination, UV radiation, and ozone disinfection systems designed for optimal pathogen inactivation while minimizing disinfection byproducts.',\n  },\n  {\n    title: 'Sludge Management',\n    description:\n      'Thickening, dewatering, and residuals handling systems that meet environmental disposal requirements and reduce operational costs.',\n  },\n  {\n    title: 'Chemical Dosing',\n    description:\n      'Precise chemical feed systems for pH adjustment, corrosion control, and enhanced coagulation using SCADA-controlled dosing pumps.',\n  },\n  {\n    title: 'Automation & Control',\n    description:\n      'Full plant automation with real-time monitoring, remote operation capabilities, and predictive maintenance algorithms.',\n  },\n];\n\n// ── Technologies & Standards ───────────────────────────────────────────────────\n\nconst TECHNOLOGIES = [\n  { name: 'WaterGEMS', use: 'Hydraulic modeling & pipe network analysis' },\n  { name: 'AutoCAD', use: 'Detailed engineering drawings & as-built documentation' },\n  { name: 'EPANET', use: 'Water quality modeling & distribution analysis' },\n  { name: 'CSAFE', use: 'Advanced treatment process simulation' },\n  { name: 'SCADA', use: 'Real-time plant monitoring & control systems' },\n];\n\n// TODO: fetch from backend config API when available\nconst DESIGN_STANDARDS = [\n  'EPA National Primary Drinking Water Regulations',\n  'AWWA Standards for Water Treatment',\n  'NSF/ANSI 60 & 61 for Chemical Safety',\n  'ISO 9001 Quality Management',\n  'OSHA Safety Standards for Industrial Facilities',\n];\n\n// ── Project Scale Metrics ─────────────────────────────────────────────────────\n\nconst PROJECT_METRICS = [\n  { value: '150+', label: 'WTP Projects', icon: Droplet },\n  { value: '50M+', label: 'Gallons/Day Capacity', icon: BarChart3 },\n  { value: '30+', label: 'Years Experience', icon: Clock },\n  { value: '100%', label: 'Regulatory Compliance', icon: Award },\n];\n\n// ── Client Types ──────────────────────────────────────────────────────────────\n\nconst CLIENT_TYPES = [\n  {\n    title: 'Municipal Governments',\n    description:\n      'Cities, counties, and regional water districts requiring new treatment facilities or upgrades to existing infrastructure for population growth and regulatory compliance.',\n    icon: Globe,\n  },\n  {\n    title: 'Industrial Facilities',\n    description:\n      'Manufacturing plants, power generation facilities, and commercial developments needing custom water treatment solutions for process water, boiler feed, or wastewater pretreatment.',\n    icon: Settings,\n  },\n  {\n    title: 'Federal & State Agencies',\n    description:\n      'Defense installations, federal complexes, and state-run facilities requiring reliable, compliant water treatment systems with stringent quality assurance requirements.',\n    icon: Shield,\n  },\n];\n\n// ── Page Component ─────────────────────────────────────────────────────────────\n\nconst WaterTreatmentPlantDesign = () => {\n  const navigate = useNavigate();\n\n  const handleContactClick = () => {\n    toast.success('Contact request initiated', {\n      description: 'Our WTP engineering team will reach out within 24 hours.',\n    });\n    navigate('/contact');\n  };\n\n  return (\n    <div className=\"flex flex-col min-h-screen\">\n      {/* ── Hero Section ────────────────────────────────────────────────── */}\n      <section className=\"relative w-full py-12 md:py-20 overflow-hidden\">\n        <div className=\"container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          {/* Back button */}\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            onClick={() => navigate(-1)}\n            className=\"mb-6 pl-0 hover:pl-0 hover:bg-transparent hover:text-primary\"\n          >\n            <ArrowLeft className=\"mr-2 h-4 w-4\" />\n            Back to Services\n          </Button>\n\n          <div className=\"grid lg:grid-cols-2 gap-12 items-center\">\n            {/* Hero text content */}\n            <div className=\"flex flex-col space-y-6\">\n              <div className=\"space-y-4\">\n                <Badge variant=\"outline\" className=\"w-fit text-primary border-primary/50\">\n                  <Droplet className=\"mr-1 h-3 w-3\" />\n                  Engineering Services\n                </Badge>\n\n                <h1 className=\"text-4xl md:text-5xl font-bold tracking-tight leading-tight\">\n                  {PAGE_CONFIG.title}\n                </h1>\n\n                <p className=\"text-xl text-muted-foreground font-medium\">\n                  {PAGE_CONFIG.subtitle}\n                </p>\n\n                <p className=\"text-base text-muted-foreground leading-relaxed max-w-xl\">\n                  {PAGE_CONFIG.description}\n                </p>\n              </div>\n\n              {/* CTA Buttons */}\n              <div className=\"flex flex-col sm:flex-row gap-3\">\n                <Button size=\"lg\" onClick={handleContactClick}>\n                  Request Consultation\n                </Button>\n                <Button size=\"lg\" variant=\"outline\" onClick={() => navigate('/projects')}>\n                  View Our Projects\n                </Button>\n              </div>\n            </div>\n\n            {/* Hero visual - stats grid */}\n            <div className=\"grid grid-cols-2 gap-4\">\n              {PROJECT_METRICS.map((metric) => (\n                <Card key={metric.label} className=\"text-center p-6 hover:shadow-md transition-shadow\">\n                  <metric.icon className=\"h-8 w-8 text-primary mx-auto mb-3\" />\n                  <div className=\"text-3xl font-bold text-primary mb-1\">{metric.value}</div>\n                  <div className=\"text-sm text-muted-foreground\">{metric.label}</div>\n                </Card>\n              ))}\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Design Process Section ──────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Our Methodology\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              End-to-End Design Process\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              From initial feasibility studies to regulatory approval, our structured approach\n              ensures every project meets technical requirements and stays within budget and schedule.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {DESIGN_PHASES.map((phase) => (\n              <Card key={phase.phase} className=\"relative overflow-hidden hover:shadow-lg transition-all\">\n                <div className=\"h-1 bg-primary\" />\n                <CardHeader>\n                  <div className=\"flex items-center gap-3 mb-2\">\n                    <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center\">\n                      <phase.icon className=\"h-5 w-5 text-primary\" />\n                    </div>\n                    <span className=\"text-sm font-mono text-muted-foreground\">{phase.phase}</span>\n                  </div>\n                  <CardTitle className=\"text-lg\">{phase.title}</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription className=\"text-sm leading-relaxed\">\n                    {phase.description}\n                  </CardDescription>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Core Capabilities Section ──────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid lg:grid-cols-2 gap-14 items-center\">\n            {/* Content */}\n            <div className=\"space-y-8\">\n              <div>\n                <Badge variant=\"outline\" className=\"mb-4 text-primary border-primary/50\">\n                  Technical Expertise\n                </Badge>\n                <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n                  Core Capabilities\n                </h2>\n                <p className=\"text-muted-foreground text-lg\">\n                  Our engineering team brings decades of hands-on experience designing water treatment\n                  facilities that reliably produce safe drinking water while minimizing operational costs.\n                </p>\n              </div>\n\n              <div className=\"space-y-4\">\n                {CAPABILITIES.map((cap) => (\n                  <div key={cap.title} className=\"flex gap-4\">\n                    <div className=\"h-8 w-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5\">\n                      <CheckCircle2 className=\"h-4 w-4 text-primary\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold mb-1\">{cap.title}</h3>\n                      <p className=\"text-sm text-muted-foreground leading-relaxed\">\n                        {cap.description}\n                      </p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Visual - technology card */}\n            <div className=\"space-y-6\">\n              <Card className=\"overflow-hidden\">\n                <div className=\"h-2 bg-primary\" />\n                <CardHeader>\n                  <CardTitle className=\"text-xl\">Technologies We Use</CardTitle>\n                  <CardDescription>\n                    Industry-leading software and control systems\n                  </CardDescription>\n                </CardHeader>\n                <CardContent>\n                  <div className=\"space-y-4\">\n                    {TECHNOLOGIES.map((tech) => (\n                      <div\n                        key={tech.name}\n                        className=\"flex items-center justify-between py-2 border-b last:border-0\"\n                      >\n                        <div className=\"flex items-center gap-3\">\n                          <div className=\"h-8 w-8 rounded bg-primary/10 flex items-center justify-center\">\n                            <Zap className=\"h-4 w-4 text-primary\" />\n                          </div>\n                          <span className=\"font-medium\">{tech.name}</span>\n                        </div>\n                        <span className=\"text-sm text-muted-foreground text-right\">\n                          {tech.use}\n                        </span>\n                      </div>\n                    ))}\n                  </div>\n                </CardContent>\n              </Card>\n\n              <Card>\n                <CardHeader>\n                  <CardTitle className=\"text-lg\">Design Standards</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {DESIGN_STANDARDS.map((standard) => (\n                      <Badge key={standard} variant=\"secondary\">\n                        {standard}\n                      </Badge>\n                    ))}\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Client Types Section ────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Who We Serve\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Trusted by Leading Organizations\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              Our water treatment plant design expertise serves diverse clients across government,\n              industrial, and federal sectors with customized solutions for every scale of operation.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-3 gap-6\">\n            {CLIENT_TYPES.map((client) => (\n              <Card key={client.title} className=\"hover:shadow-lg transition-all\">\n                <CardHeader>\n                  <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4\">\n                    <client.icon className=\"h-6 w-6 text-primary\" />\n                  </div>\n                  <CardTitle className=\"text-xl\">{client.title}</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription className=\"text-base leading-relaxed\">\n                    {client.description}\n                  </CardDescription>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── CTA Section ─────────────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"relative rounded-2xl bg-primary text-primary-foreground overflow-hidden\">\n            {/* Background pattern */}\n            <div className=\"absolute inset-0 opacity-10\">\n              <svg\n                viewBox=\"0 0 100 100\"\n                className=\"w-full h-full\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n              >\n                <pattern id=\"dots\" x=\"0\" y=\"0\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"currentColor\" />\n                </pattern>\n                <rect width=\"100%\" height=\"100%\" fill=\"url(#dots)\" />\n              </svg>\n            </div>\n\n            <div className=\"relative z-10 text-center py-16 px-6\">\n              <Users className=\"h-12 w-12 mx-auto mb-4 opacity-80\" />\n              <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n                Ready to Start Your WTP Project?\n              </h2>\n              <p className=\"text-primary-foreground/80 text-lg max-w-2xl mx-auto mb-8\">\n                Our engineering team has the expertise to design a water treatment solution\n                that meets your capacity requirements, budget constraints, and regulatory obligations.\n              </p>\n\n              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                <Button\n                  size=\"lg\"\n                  variant=\"secondary\"\n                  className=\"text-primary\"\n                  onClick={handleContactClick}\n                >\n                  Schedule a Consultation\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  className=\"border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10\"\n                  onClick={() => navigate('/projects')}\n                >\n                  View Past Projects\n                </Button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n\nexport default WaterTreatmentPlantDesign;\n","numLines":455,"startLine":1,"totalLines":455}}}
