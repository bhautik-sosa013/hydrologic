{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_xg6w6znepitv_7","type":"tool_result","content":"1\timport { useNavigate } from 'react-router-dom';\n2\timport {\n3\t  ArrowLeft,\n4\t  Map,\n5\t  Layers,\n6\t  Database,\n7\t  BarChart3,\n8\t  Globe,\n9\t  FileText,\n10\t  CheckCircle2,\n11\t  Settings2,\n12\t  TrendingUp,\n13\t  Users,\n14\t  Building2,\n15\t  MapPin,\n16\t  Shield,\n17\t  Wrench,\n18\t  ArrowRight,\n19\t} from 'lucide-react';\n20\timport { Button } from '@/components/ui/button';\n21\timport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n22\timport { Badge } from '@/components/ui/badge';\n23\timport { Separator } from '@/components/ui/separator';\n24\t\n25\t// ── Mock data ─────────────────────────────────────────────────────────────────\n26\t\n27\tconst DATA_CAPTURE_WORKFLOWS = [\n28\t  {\n29\t    title: 'Field Data Collection',\n30\t    description:\n31\t      'Mobile GIS applications enable field crews to capture asset data, photos, and condition assessments directly from the site. GPS-tagged entries ensure sub-meter spatial accuracy.',\n32\t    icon: MapPin,\n33\t    details: ['GPS-tagged asset locations', 'Offline-capable mobile apps', 'Real-time sync to central database'],\n34\t  },\n35\t  {\n36\t    title: 'Record Digitization',\n37\t    description:\n38\t      'Legacy paper records, CAD drawings, and scanned maps are converted to georeferenced digital formats, creating a complete historical archive searchable by location.',\n39\t    icon: FileText,\n40\t    details: ['As-built drawing georeferencing', 'Historical record integration', 'PDF and CAD format support'],\n41\t  },\n42\t  {\n43\t    title: 'Remote Sensing Integration',\n44\t    description:\n45\t      'Aerial imagery, LiDAR point clouds, and satellite data are processed to extract infrastructure features and terrain models for network modeling.',\n46\t    icon: Globe,\n47\t    details: ['Aerial photography interpretation', 'LiDAR terrain modeling', 'Satellite land-use analysis'],\n48\t  },\n49\t  {\n50\t    title: 'IoT Sensor Mapping',\n51\t    description:\n52\t      'SCADA and IoT sensor data is spatially referenced and integrated with the GIS, providing real-time operational visibility across the entire network.',\n53\t    icon: Layers,\n54\t    details: ['SCADA data spatial correlation', 'Sensor location mapping', 'Real-time telemetry overlay'],\n55\t  },\n56\t];\n57\t\n58\tconst HYDRAULIC_INTEGRATION = [\n59\t  {\n60\t    name: 'WaterGems',\n61\t    description:\n62\t      'Our GIS data seamlessly feeds into WaterGems hydraulic models, ensuring pipe attributes, node elevations, and demand locations reflect real-world spatial conditions.',\n63\t    capabilities: [\n64\t      'Automatic network topology generation from GIS lines',\n65\t      'Elevation and demand zone mapping',\n66\t      'Fire flow result visualization on the map',\n67\t      'Tank and pump location accuracy',\n68\t    ],\n69\t    icon: Map,\n70\t  },\n71\t  {\n72\t    name: 'SewerGems',\n73\t    description:\n74\t      'Sewer network GIS layers are directly imported into SewerGems for hydrological and hydraulic analysis, with manhole invert elevations and catchment delineation.',\n75\t    capabilities: [\n76\t      'Manhole and pipe network import',\n77\t      'Catchment area delineation from terrain',\n78\t      'Rainfall-dependent infiltration mapping',\n79\t      'Overflow node visualization',\n80\t    ],\n81\t    icon: Layers,\n82\t  },\n83\t  {\n84\t    name: 'MIKE+',\n85\t    description:\n86\t      'Integrated water distribution and rainfall-runoff modeling with full bidirectional data exchange between GIS layers and hydraulic simulation engine.',\n87\t    capabilities: [\n88\t      'Integrated urban drainage modeling',\n89\t      'Catchment-to-pipe connectivity',\n90\t      'Real-time simulation support',\n91\t      'Cross-platform data interoperability',\n92\t    ],\n93\t    icon: Database,\n94\t  },\n95\t];\n96\t\n97\tconst ASSET_MANAGEMENT = [\n98\t  {\n99\t    title: 'Inventory & Condition Tracking',\n100\t    description:\n101\t      'Complete asset registries with condition ratings, installation dates, material specifications, and maintenance history — all queryable by geographic area.',\n102\t    metric: '100% asset coverage',\n103\t    icon: Database,\n104\t  },\n105\t  {\n106\t    title: 'Predictive Maintenance',\n107\t    description:\n108\t      'GIS-linked analytics identify at-risk assets based on age, material, pressure history, and soil conditions, enabling proactive replacement before failures occur.',\n109\t    metric: '40% reduction in emergency repairs',\n110\t    icon: TrendingUp,\n111\t  },\n112\t  {\n113\t    title: 'Work Order Management',\n114\t    description:\n115\t      'Field crews access assigned work orders via mobile GIS, navigate to asset locations, update condition data, and close jobs with photo documentation.',\n116\t    metric: '60% faster work order cycles',\n117\t    icon: Wrench,\n118\t  },\n119\t  {\n120\t    title: 'Capital Planning',\n121\t    description:\n122\t      'Geographic prioritization engine ranks infrastructure investments by condition, consequence of failure, and population served, ensuring optimal capital allocation.',\n123\t    metric: '$2M average annual savings',\n124\t    icon: BarChart3,\n125\t  },\n126\t];\n127\t\n128\tconst PLANNING_INSIGHTS = [\n129\t  {\n130\t    icon: Users,\n131\t    title: 'Government Clients',\n132\t    description:\n133\t      'Municipal water departments leverage our GIS platforms to meet regulatory reporting requirements, plan rate-funded capital programs, and communicate infrastructure needs to elected officials through visual storytelling.',\n134\t  },\n135\t  {\n136\t    icon: Building2,\n137\t    title: 'Utility Companies',\n138\t    description:\n139\t      'Investor-owned and co-op utilities use our GIS analytics to optimize service territory coverage, plan expansion into new developments, and demonstrate asset integrity to state regulators.',\n140\t  },\n141\t  {\n142\t    icon: Shield,\n143\t    title: 'Regulatory Compliance',\n144\t    description:\n145\t      'Spatial reporting tools generate EPA SDWIS-compliant inventory exports, cross-connection documentation, and source water protection area delineations required for permit renewals.',\n146\t  },\n147\t  {\n148\t    icon: Settings2,\n149\t    title: 'Infrastructure Resilience',\n150\t    description:\n151\t      'Scenario modeling maps the impact of climate events, population shifts, and land-use changes on water and sewer networks, supporting long-range infrastructure resilience plans.',\n152\t  },\n153\t];\n154\t\n155\t// TODO: fetch from backend config API when available\n156\tconst GIS_TOOLS = [\n157\t  { name: 'ArcGIS Pro', category: 'Enterprise GIS' },\n158\t  { name: 'QGIS', category: 'Open Source GIS' },\n159\t  { name: 'AutoCAD Map 3D', category: 'CAD-GIS Integration' },\n160\t  { name: 'PostGIS', category: 'Spatial Database' },\n161\t  { name: 'GeoServer', category: 'Spatial API' },\n162\t  { name: 'Leaflet', category: 'Web Mapping' },\n163\t];\n164\t\n165\tconst DELIVERABLES = [\n166\t  {\n167\t    title: 'Interactive Web Map Portal',\n168\t    description: 'Password-protected online dashboard for staff and stakeholders to explore network assets, query data, and generate reports by geographic area.',\n169\t    icon: Globe,\n170\t  },\n171\t  {\n172\t    title: 'GIS-Coupled Hydraulic Model',\n173\t    description: 'Fully calibrated model with live link to GIS layers — any GIS update automatically reflects in the hydraulic simulation.',\n174\t    icon: Settings2,\n175\t  },\n176\t  {\n177\t    title: 'Asset Inventory Report',\n178\t    description: 'Comprehensive pipe and structure inventory with condition grades, material specs, installation dates, and maintenance history.',\n179\t    icon: FileText,\n180\t  },\n181\t  {\n182\t    title: 'Capital Improvement Map',\n183\t    description: 'Prioritized project locations displayed on an interactive map with cost estimates, timelines, and consequence-of-failure scores.',\n184\t    icon: MapPin,\n185\t  },\n186\t  {\n187\t    title: 'Field Mobile Application',\n188\t    description: 'Custom mobile GIS app for iOS and Android enabling field data collection, asset inspections, and work order management offline.',\n189\t    icon: Map,\n190\t  },\n191\t  {\n192\t    title: 'Regulatory Submission Package',\n193\t    description: 'EPA- and state-compliant spatial data exports, sanitary survey maps, and source water protection area documentation.',\n194\t    icon: Shield,\n195\t  },\n196\t];\n197\t\n198\t// ── Page ─────────────────────────────────────────────────────────────────────\n199\t\n200\tconst GISIntegration = () => {\n201\t  const navigate = useNavigate();\n202\t\n203\t  return (\n204\t    <div className=\"flex flex-col min-h-screen\">\n205\t      {/* ── Back Navigation ────────────────────────────────────────────── */}\n206\t      <section className=\"w-full py-6 border-b\">\n207\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n208\t          <Button\n209\t            variant=\"ghost\"\n210\t            size=\"sm\"\n211\t            onClick={() => navigate(-1)}\n212\t            className=\"pl-0 hover:pl-2 transition-all\"\n213\t          >\n214\t            <ArrowLeft className=\"mr-2 h-4 w-4\" />\n215\t            Back to Services\n216\t          </Button>\n217\t        </div>\n218\t      </section>\n219\t\n220\t      {/* ── Hero Section ───────────────────────────────────────────────── */}\n221\t      <section className=\"relative w-full py-16 md:py-24 overflow-hidden\">\n222\t        <div className=\"container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n223\t          <div className=\"max-w-4xl\">\n224\t            <Badge variant=\"outline\" className=\"mb-4 text-primary border-primary/50\">\n225\t              <Map className=\"mr-1 h-3 w-3\" />\n226\t              Engineering Service\n227\t            </Badge>\n228\t\n229\t            <h1 className=\"text-4xl md:text-5xl font-bold tracking-tight mb-6\">\n230\t              GIS Integration\n231\t            </h1>\n232\t\n233\t            <p className=\"text-xl text-muted-foreground leading-relaxed mb-8\">\n234\t              Hydrologic Innovation leverages Geographic Information Systems to map, analyze, and\n235\t              manage water and sewer networks spatially. Our GIS-driven approach transforms raw\n236\t              infrastructure data into actionable insights, supporting data-driven planning for\n237\t              government and utility clients across the full asset lifecycle — from initial data\n238\t              capture to long-range capital planning.\n239\t            </p>\n240\t\n241\t            <div className=\"flex flex-wrap gap-4\">\n242\t              <Button size=\"lg\" asChild>\n243\t                <a href=\"/contact\">\n244\t                  Request GIS Assessment\n245\t                  <ArrowRight className=\"ml-2 h-5 w-5\" />\n246\t                </a>\n247\t              </Button>\n248\t              <Button size=\"lg\" variant=\"outline\" asChild>\n249\t                <a href=\"/projects\">\n250\t                  View Related Projects\n251\t                  <Map className=\"ml-2 h-5 w-5\" />\n252\t                </a>\n253\t              </Button>\n254\t            </div>\n255\t          </div>\n256\t        </div>\n257\t      </section>\n258\t\n259\t      <Separator />\n260\t\n261\t      {/* ── Data Capture Workflows ──────────────────────────────────────── */}\n262\t      <section className=\"w-full py-16 md:py-24\">\n263\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n264\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n265\t            <Badge variant=\"secondary\" className=\"mb-4\">\n266\t              Data Foundation\n267\t            </Badge>\n268\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n269\t              Comprehensive Data Capture\n270\t            </h2>\n271\t            <p className=\"text-muted-foreground text-lg\">\n272\t              Every GIS project begins with rigorous data capture workflows that establish a\n273\t              complete, accurate, and spatially-referenced digital twin of your water and sewer\n274\t              infrastructure.\n275\t            </p>\n276\t          </div>\n277\t\n278\t          <div className=\"grid md:grid-cols-2 gap-8\">\n279\t            {DATA_CAPTURE_WORKFLOWS.map((workflow) => (\n280\t              <Card key={workflow.title} className=\"overflow-hidden hover:shadow-lg transition-all\">\n281\t                <div className=\"h-1.5 bg-primary\" />\n282\t                <CardHeader>\n283\t                  <div className=\"flex items-start gap-4\">\n284\t                    <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n285\t                      <workflow.icon className=\"h-6 w-6 text-primary\" />\n286\t                    </div>\n287\t                    <div>\n288\t                      <CardTitle className=\"text-xl mb-2\">{workflow.title}</CardTitle>\n289\t                      <CardDescription className=\"text-base leading-relaxed\">\n290\t                        {workflow.description}\n291\t                      </CardDescription>\n292\t                    </div>\n293\t                  </div>\n294\t                </CardHeader>\n295\t                <CardContent>\n296\t                  <div className=\"space-y-2\">\n297\t                    {workflow.details.map((detail) => (\n298\t                      <div key={detail} className=\"flex items-center gap-2 text-sm\">\n299\t                        <CheckCircle2 className=\"h-4 w-4 text-primary flex-shrink-0\" />\n300\t                        <span>{detail}</span>\n301\t                      </div>\n302\t                    ))}\n303\t                  </div>\n304\t                </CardContent>\n305\t              </Card>\n306\t            ))}\n307\t          </div>\n308\t        </div>\n309\t      </section>\n310\t\n311\t      <Separator />\n312\t\n313\t      {/* ── Hydraulic Model Integration ───────────────────────────────── */}\n314\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n315\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n316\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n317\t            <Badge variant=\"secondary\" className=\"mb-4\">\n318\t              Model Integration\n319\t            </Badge>\n320\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n321\t              Seamless Hydraulic Model Integration\n322\t            </h2>\n323\t            <p className=\"text-muted-foreground text-lg\">\n324\t              Our GIS platform maintains a live bidirectional link with industry-leading hydraulic\n325\t              modeling tools, ensuring spatial data and network simulations always stay in sync.\n326\t            </p>\n327\t          </div>\n328\t\n329\t          <div className=\"grid md:grid-cols-3 gap-8\">\n330\t            {HYDRAULIC_INTEGRATION.map((tool) => (\n331\t              <Card key={tool.name} className=\"overflow-hidden hover:shadow-lg transition-all\">\n332\t                <div className=\"h-2 bg-primary\" />\n333\t                <CardHeader>\n334\t                  <div className=\"flex items-center gap-4 mb-2\">\n335\t                    <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center\">\n336\t                      <tool.icon className=\"h-6 w-6 text-primary\" />\n337\t                    </div>\n338\t                    <CardTitle className=\"text-xl\">{tool.name}</CardTitle>\n339\t                  </div>\n340\t                  <CardDescription className=\"text-base leading-relaxed\">\n341\t                    {tool.description}\n342\t                  </CardDescription>\n343\t                </CardHeader>\n344\t                <CardContent>\n345\t                  <div className=\"space-y-2\">\n346\t                    {tool.capabilities.map((cap) => (\n347\t                      <div key={cap} className=\"flex items-start gap-2 text-sm\">\n348\t                        <CheckCircle2 className=\"h-4 w-4 text-primary flex-shrink-0 mt-0.5\" />\n349\t                        <span>{cap}</span>\n350\t                      </div>\n351\t                    ))}\n352\t                  </div>\n353\t                </CardContent>\n354\t              </Card>\n355\t            ))}\n356\t          </div>\n357\t        </div>\n358\t      </section>\n359\t\n360\t      <Separator />\n361\t\n362\t      {/* ── GIS Tools ──────────────────────────────────────────────────── */}\n363\t      <section className=\"w-full py-16 md:py-24\">\n364\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n365\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n366\t            <Badge variant=\"secondary\" className=\"mb-4\">\n367\t              Technology Stack\n368\t            </Badge>\n369\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n370\t              Industry-Standard GIS Tools\n371\t            </h2>\n372\t            <p className=\"text-muted-foreground text-lg\">\n373\t              We deploy a proven technology stack spanning enterprise platforms, open-source\n374\t              solutions, and custom spatial databases tailored to each client&apos;s scale and\n375\t              budget.\n376\t            </p>\n377\t          </div>\n378\t\n379\t          <div className=\"flex flex-wrap justify-center gap-4\">\n380\t            {GIS_TOOLS.map((tool) => (\n381\t              <Badge key={tool.name} variant=\"outline\" className=\"px-4 py-2 text-sm\">\n382\t                {tool.name}\n383\t                <span className=\"ml-2 text-muted-foreground text-xs\">{tool.category}</span>\n384\t              </Badge>\n385\t            ))}\n386\t          </div>\n387\t        </div>\n388\t      </section>\n389\t\n390\t      <Separator />\n391\t\n392\t      {/* ── Asset Management ───────────────────────────────────────────── */}\n393\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n394\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n395\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n396\t            <Badge variant=\"secondary\" className=\"mb-4\">\n397\t              Asset Lifecycle\n398\t            </Badge>\n399\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n400\t              GIS-Powered Asset Management\n401\t            </h2>\n402\t            <p className=\"text-muted-foreground text-lg\">\n403\t              Move beyond reactive maintenance with a spatially-enabled asset management system\n404\t              that tracks the full lifecycle of every infrastructure component.\n405\t            </p>\n406\t          </div>\n407\t\n408\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n409\t            {ASSET_MANAGEMENT.map((item) => (\n410\t              <Card key={item.title} className=\"hover:shadow-md transition-shadow\">\n411\t                <CardHeader>\n412\t                  <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3\">\n413\t                    <item.icon className=\"h-5 w-5 text-primary\" />\n414\t                  </div>\n415\t                  <CardTitle className=\"text-lg\">{item.title}</CardTitle>\n416\t                </CardHeader>\n417\t                <CardContent>\n418\t                  <CardDescription className=\"text-sm leading-relaxed mb-4\">\n419\t                    {item.description}\n420\t                  </CardDescription>\n421\t                  <Badge variant=\"outline\" className=\"text-primary border-primary/30 bg-primary/5\">\n422\t                    {item.metric}\n423\t                  </Badge>\n424\t                </CardContent>\n425\t              </Card>\n426\t            ))}\n427\t          </div>\n428\t        </div>\n429\t      </section>\n430\t\n431\t      <Separator />\n432\t\n433\t      {/* ── Infrastructure Planning Insights ───────────────────────────── */}\n434\t      <section className=\"w-full py-16 md:py-24\">\n435\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n436\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n437\t            <Badge variant=\"secondary\" className=\"mb-4\">\n438\t              Client Solutions\n439\t            </Badge>\n440\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n441\t              Data-Driven Infrastructure Planning\n442\t            </h2>\n443\t            <p className=\"text-muted-foreground text-lg\">\n444\t              Our GIS analytics platform transforms spatial data into strategic insights that\n445\t              support capital investment decisions, regulatory compliance, and long-range\n446\t              infrastructure resilience planning.\n447\t            </p>\n448\t          </div>\n449\t\n450\t          <div className=\"grid md:grid-cols-2 gap-8\">\n451\t            {PLANNING_INSIGHTS.map((insight) => (\n452\t              <div key={insight.title} className=\"flex items-start gap-4\">\n453\t                <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n454\t                  <insight.icon className=\"h-6 w-6 text-primary\" />\n455\t                </div>\n456\t                <div>\n457\t                  <h3 className=\"font-semibold text-lg mb-2\">{insight.title}</h3>\n458\t                  <p className=\"text-muted-foreground leading-relaxed\">{insight.description}</p>\n459\t                </div>\n460\t              </div>\n461\t            ))}\n462\t          </div>\n463\t        </div>\n464\t      </section>\n465\t\n466\t      <Separator />\n467\t\n468\t      {/* ── Deliverables ───────────────────────────────────────────────── */}\n469\t      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n470\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n471\t          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n472\t            <Badge variant=\"secondary\" className=\"mb-4\">\n473\t              Project Output\n474\t            </Badge>\n475\t            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n476\t              What You Receive\n477\t            </h2>\n478\t            <p className=\"text-muted-foreground text-lg\">\n479\t              Every GIS integration engagement delivers a suite of tangible products that empower\n480\t              your team to manage, analyze, and plan your infrastructure with confidence.\n481\t            </p>\n482\t          </div>\n483\t\n484\t          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n485\t            {DELIVERABLES.map((item) => (\n486\t              <Card key={item.title} className=\"hover:shadow-md transition-shadow\">\n487\t                <CardHeader className=\"flex flex-row items-start gap-4\">\n488\t                  <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n489\t                    <item.icon className=\"h-5 w-5 text-primary\" />\n490\t                  </div>\n491\t                  <div>\n492\t                    <CardTitle className=\"text-lg mb-1\">{item.title}</CardTitle>\n493\t                    <CardDescription>{item.description}</CardDescription>\n494\t                  </div>\n495\t                </CardHeader>\n496\t              </Card>\n497\t            ))}\n498\t          </div>\n499\t        </div>\n500\t      </section>\n501\t\n502\t      <Separator />\n503\t\n504\t      {/* ── CTA Section ────────────────────────────────────────────────── */}\n505\t      <section className=\"w-full py-16 md:py-24\">\n506\t        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n507\t          <div className=\"relative rounded-2xl bg-primary text-primary-foreground overflow-hidden\">\n508\t            {/* Background pattern */}\n509\t            <div className=\"absolute inset-0 opacity-10\">\n510\t              <svg\n511\t                viewBox=\"0 0 100 100\"\n512\t                className=\"w-full h-full\"\n513\t                xmlns=\"http://www.w3.org/2000/svg\"\n514\t              >\n515\t                <pattern id=\"dots\" x=\"0\" y=\"0\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n516\t                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"currentColor\" />\n517\t                </pattern>\n518\t                <rect width=\"100%\" height=\"100%\" fill=\"url(#dots)\" />\n519\t              </svg>\n520\t            </div>\n521\t\n522\t            <div className=\"relative z-10 text-center py-16 px-6\">\n523\t              <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n524\t                Ready to Unlock Your Infrastructure Data?\n525\t              </h2>\n526\t              <p className=\"text-primary-foreground/80 text-lg max-w-2xl mx-auto mb-8\">\n527\t                Schedule a free GIS readiness assessment with our team to discover how spatial\n528\t                analysis can transform your water and sewer network planning, compliance\n529\t                reporting, and capital investment strategy.\n530\t              </p>\n531\t\n532\t              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n533\t                <Button\n534\t                  size=\"lg\"\n535\t                  variant=\"secondary\"\n536\t                  className=\"text-primary\"\n537\t                  asChild\n538\t                >\n539\t                  <a href=\"/contact\">\n540\t                    Get Free Assessment\n541\t                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n542\t                  </a>\n543\t                </Button>\n544\t                <Button\n545\t                  size=\"lg\"\n546\t                  variant=\"outline\"\n547\t                  className=\"border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10\"\n548\t                  asChild\n549\t                >\n550\t                  <a href=\"/projects\">\n551\t                    View Our Projects\n552\t                    <Map className=\"ml-2 h-5 w-5\" />\n553\t                  </a>\n554\t                </Button>\n555\t              </div>\n556\t\n557\t              {/* Trust indicators */}\n558\t              <div className=\"flex flex-wrap justify-center gap-6 mt-12 text-sm text-primary-foreground/60\">\n559\t                {[\n560\t                  'No Obligation Quote',\n561\t                  'Expert GIS Engineers',\n562\t                  'Proven Municipal Results',\n563\t                ].map((item) => (\n564\t                  <div key={item} className=\"flex items-center gap-2\">\n565\t                    <CheckCircle2 className=\"h-4 w-4\" />\n566\t                    {item}\n567\t                  </div>\n568\t                ))}\n569\t              </div>\n570\t            </div>\n571\t          </div>\n572\t        </div>\n573\t      </section>\n574\t    </div>\n575\t  );\n576\t};\n577\t\n578\texport default GISIntegration;"}]},"parent_tool_use_id":null,"session_id":"a7acff44-f104-4b18-a19d-824b8719d3af","uuid":"fa251093-eaff-45bd-a99d-4f43f3db0a2b","timestamp":"2026-04-18T17:19:58.851Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/code/project-code/code_base/app_7a97b333c52f0a2e89b9d85da46ab74b/frontend/src/pages/GISIntegration.tsx","content":"import { useNavigate } from 'react-router-dom';\nimport {\n  ArrowLeft,\n  Map,\n  Layers,\n  Database,\n  BarChart3,\n  Globe,\n  FileText,\n  CheckCircle2,\n  Settings2,\n  TrendingUp,\n  Users,\n  Building2,\n  MapPin,\n  Shield,\n  Wrench,\n  ArrowRight,\n} from 'lucide-react';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport { Separator } from '@/components/ui/separator';\n\n// ── Mock data ─────────────────────────────────────────────────────────────────\n\nconst DATA_CAPTURE_WORKFLOWS = [\n  {\n    title: 'Field Data Collection',\n    description:\n      'Mobile GIS applications enable field crews to capture asset data, photos, and condition assessments directly from the site. GPS-tagged entries ensure sub-meter spatial accuracy.',\n    icon: MapPin,\n    details: ['GPS-tagged asset locations', 'Offline-capable mobile apps', 'Real-time sync to central database'],\n  },\n  {\n    title: 'Record Digitization',\n    description:\n      'Legacy paper records, CAD drawings, and scanned maps are converted to georeferenced digital formats, creating a complete historical archive searchable by location.',\n    icon: FileText,\n    details: ['As-built drawing georeferencing', 'Historical record integration', 'PDF and CAD format support'],\n  },\n  {\n    title: 'Remote Sensing Integration',\n    description:\n      'Aerial imagery, LiDAR point clouds, and satellite data are processed to extract infrastructure features and terrain models for network modeling.',\n    icon: Globe,\n    details: ['Aerial photography interpretation', 'LiDAR terrain modeling', 'Satellite land-use analysis'],\n  },\n  {\n    title: 'IoT Sensor Mapping',\n    description:\n      'SCADA and IoT sensor data is spatially referenced and integrated with the GIS, providing real-time operational visibility across the entire network.',\n    icon: Layers,\n    details: ['SCADA data spatial correlation', 'Sensor location mapping', 'Real-time telemetry overlay'],\n  },\n];\n\nconst HYDRAULIC_INTEGRATION = [\n  {\n    name: 'WaterGems',\n    description:\n      'Our GIS data seamlessly feeds into WaterGems hydraulic models, ensuring pipe attributes, node elevations, and demand locations reflect real-world spatial conditions.',\n    capabilities: [\n      'Automatic network topology generation from GIS lines',\n      'Elevation and demand zone mapping',\n      'Fire flow result visualization on the map',\n      'Tank and pump location accuracy',\n    ],\n    icon: Map,\n  },\n  {\n    name: 'SewerGems',\n    description:\n      'Sewer network GIS layers are directly imported into SewerGems for hydrological and hydraulic analysis, with manhole invert elevations and catchment delineation.',\n    capabilities: [\n      'Manhole and pipe network import',\n      'Catchment area delineation from terrain',\n      'Rainfall-dependent infiltration mapping',\n      'Overflow node visualization',\n    ],\n    icon: Layers,\n  },\n  {\n    name: 'MIKE+',\n    description:\n      'Integrated water distribution and rainfall-runoff modeling with full bidirectional data exchange between GIS layers and hydraulic simulation engine.',\n    capabilities: [\n      'Integrated urban drainage modeling',\n      'Catchment-to-pipe connectivity',\n      'Real-time simulation support',\n      'Cross-platform data interoperability',\n    ],\n    icon: Database,\n  },\n];\n\nconst ASSET_MANAGEMENT = [\n  {\n    title: 'Inventory & Condition Tracking',\n    description:\n      'Complete asset registries with condition ratings, installation dates, material specifications, and maintenance history — all queryable by geographic area.',\n    metric: '100% asset coverage',\n    icon: Database,\n  },\n  {\n    title: 'Predictive Maintenance',\n    description:\n      'GIS-linked analytics identify at-risk assets based on age, material, pressure history, and soil conditions, enabling proactive replacement before failures occur.',\n    metric: '40% reduction in emergency repairs',\n    icon: TrendingUp,\n  },\n  {\n    title: 'Work Order Management',\n    description:\n      'Field crews access assigned work orders via mobile GIS, navigate to asset locations, update condition data, and close jobs with photo documentation.',\n    metric: '60% faster work order cycles',\n    icon: Wrench,\n  },\n  {\n    title: 'Capital Planning',\n    description:\n      'Geographic prioritization engine ranks infrastructure investments by condition, consequence of failure, and population served, ensuring optimal capital allocation.',\n    metric: '$2M average annual savings',\n    icon: BarChart3,\n  },\n];\n\nconst PLANNING_INSIGHTS = [\n  {\n    icon: Users,\n    title: 'Government Clients',\n    description:\n      'Municipal water departments leverage our GIS platforms to meet regulatory reporting requirements, plan rate-funded capital programs, and communicate infrastructure needs to elected officials through visual storytelling.',\n  },\n  {\n    icon: Building2,\n    title: 'Utility Companies',\n    description:\n      'Investor-owned and co-op utilities use our GIS analytics to optimize service territory coverage, plan expansion into new developments, and demonstrate asset integrity to state regulators.',\n  },\n  {\n    icon: Shield,\n    title: 'Regulatory Compliance',\n    description:\n      'Spatial reporting tools generate EPA SDWIS-compliant inventory exports, cross-connection documentation, and source water protection area delineations required for permit renewals.',\n  },\n  {\n    icon: Settings2,\n    title: 'Infrastructure Resilience',\n    description:\n      'Scenario modeling maps the impact of climate events, population shifts, and land-use changes on water and sewer networks, supporting long-range infrastructure resilience plans.',\n  },\n];\n\n// TODO: fetch from backend config API when available\nconst GIS_TOOLS = [\n  { name: 'ArcGIS Pro', category: 'Enterprise GIS' },\n  { name: 'QGIS', category: 'Open Source GIS' },\n  { name: 'AutoCAD Map 3D', category: 'CAD-GIS Integration' },\n  { name: 'PostGIS', category: 'Spatial Database' },\n  { name: 'GeoServer', category: 'Spatial API' },\n  { name: 'Leaflet', category: 'Web Mapping' },\n];\n\nconst DELIVERABLES = [\n  {\n    title: 'Interactive Web Map Portal',\n    description: 'Password-protected online dashboard for staff and stakeholders to explore network assets, query data, and generate reports by geographic area.',\n    icon: Globe,\n  },\n  {\n    title: 'GIS-Coupled Hydraulic Model',\n    description: 'Fully calibrated model with live link to GIS layers — any GIS update automatically reflects in the hydraulic simulation.',\n    icon: Settings2,\n  },\n  {\n    title: 'Asset Inventory Report',\n    description: 'Comprehensive pipe and structure inventory with condition grades, material specs, installation dates, and maintenance history.',\n    icon: FileText,\n  },\n  {\n    title: 'Capital Improvement Map',\n    description: 'Prioritized project locations displayed on an interactive map with cost estimates, timelines, and consequence-of-failure scores.',\n    icon: MapPin,\n  },\n  {\n    title: 'Field Mobile Application',\n    description: 'Custom mobile GIS app for iOS and Android enabling field data collection, asset inspections, and work order management offline.',\n    icon: Map,\n  },\n  {\n    title: 'Regulatory Submission Package',\n    description: 'EPA- and state-compliant spatial data exports, sanitary survey maps, and source water protection area documentation.',\n    icon: Shield,\n  },\n];\n\n// ── Page ─────────────────────────────────────────────────────────────────────\n\nconst GISIntegration = () => {\n  const navigate = useNavigate();\n\n  return (\n    <div className=\"flex flex-col min-h-screen\">\n      {/* ── Back Navigation ────────────────────────────────────────────── */}\n      <section className=\"w-full py-6 border-b\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            onClick={() => navigate(-1)}\n            className=\"pl-0 hover:pl-2 transition-all\"\n          >\n            <ArrowLeft className=\"mr-2 h-4 w-4\" />\n            Back to Services\n          </Button>\n        </div>\n      </section>\n\n      {/* ── Hero Section ───────────────────────────────────────────────── */}\n      <section className=\"relative w-full py-16 md:py-24 overflow-hidden\">\n        <div className=\"container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"max-w-4xl\">\n            <Badge variant=\"outline\" className=\"mb-4 text-primary border-primary/50\">\n              <Map className=\"mr-1 h-3 w-3\" />\n              Engineering Service\n            </Badge>\n\n            <h1 className=\"text-4xl md:text-5xl font-bold tracking-tight mb-6\">\n              GIS Integration\n            </h1>\n\n            <p className=\"text-xl text-muted-foreground leading-relaxed mb-8\">\n              Hydrologic Innovation leverages Geographic Information Systems to map, analyze, and\n              manage water and sewer networks spatially. Our GIS-driven approach transforms raw\n              infrastructure data into actionable insights, supporting data-driven planning for\n              government and utility clients across the full asset lifecycle — from initial data\n              capture to long-range capital planning.\n            </p>\n\n            <div className=\"flex flex-wrap gap-4\">\n              <Button size=\"lg\" asChild>\n                <a href=\"/contact\">\n                  Request GIS Assessment\n                  <ArrowRight className=\"ml-2 h-5 w-5\" />\n                </a>\n              </Button>\n              <Button size=\"lg\" variant=\"outline\" asChild>\n                <a href=\"/projects\">\n                  View Related Projects\n                  <Map className=\"ml-2 h-5 w-5\" />\n                </a>\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Data Capture Workflows ──────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Data Foundation\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Comprehensive Data Capture\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              Every GIS project begins with rigorous data capture workflows that establish a\n              complete, accurate, and spatially-referenced digital twin of your water and sewer\n              infrastructure.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 gap-8\">\n            {DATA_CAPTURE_WORKFLOWS.map((workflow) => (\n              <Card key={workflow.title} className=\"overflow-hidden hover:shadow-lg transition-all\">\n                <div className=\"h-1.5 bg-primary\" />\n                <CardHeader>\n                  <div className=\"flex items-start gap-4\">\n                    <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n                      <workflow.icon className=\"h-6 w-6 text-primary\" />\n                    </div>\n                    <div>\n                      <CardTitle className=\"text-xl mb-2\">{workflow.title}</CardTitle>\n                      <CardDescription className=\"text-base leading-relaxed\">\n                        {workflow.description}\n                      </CardDescription>\n                    </div>\n                  </div>\n                </CardHeader>\n                <CardContent>\n                  <div className=\"space-y-2\">\n                    {workflow.details.map((detail) => (\n                      <div key={detail} className=\"flex items-center gap-2 text-sm\">\n                        <CheckCircle2 className=\"h-4 w-4 text-primary flex-shrink-0\" />\n                        <span>{detail}</span>\n                      </div>\n                    ))}\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Hydraulic Model Integration ───────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Model Integration\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Seamless Hydraulic Model Integration\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              Our GIS platform maintains a live bidirectional link with industry-leading hydraulic\n              modeling tools, ensuring spatial data and network simulations always stay in sync.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-3 gap-8\">\n            {HYDRAULIC_INTEGRATION.map((tool) => (\n              <Card key={tool.name} className=\"overflow-hidden hover:shadow-lg transition-all\">\n                <div className=\"h-2 bg-primary\" />\n                <CardHeader>\n                  <div className=\"flex items-center gap-4 mb-2\">\n                    <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center\">\n                      <tool.icon className=\"h-6 w-6 text-primary\" />\n                    </div>\n                    <CardTitle className=\"text-xl\">{tool.name}</CardTitle>\n                  </div>\n                  <CardDescription className=\"text-base leading-relaxed\">\n                    {tool.description}\n                  </CardDescription>\n                </CardHeader>\n                <CardContent>\n                  <div className=\"space-y-2\">\n                    {tool.capabilities.map((cap) => (\n                      <div key={cap} className=\"flex items-start gap-2 text-sm\">\n                        <CheckCircle2 className=\"h-4 w-4 text-primary flex-shrink-0 mt-0.5\" />\n                        <span>{cap}</span>\n                      </div>\n                    ))}\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── GIS Tools ──────────────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Technology Stack\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Industry-Standard GIS Tools\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              We deploy a proven technology stack spanning enterprise platforms, open-source\n              solutions, and custom spatial databases tailored to each client&apos;s scale and\n              budget.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap justify-center gap-4\">\n            {GIS_TOOLS.map((tool) => (\n              <Badge key={tool.name} variant=\"outline\" className=\"px-4 py-2 text-sm\">\n                {tool.name}\n                <span className=\"ml-2 text-muted-foreground text-xs\">{tool.category}</span>\n              </Badge>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Asset Management ───────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Asset Lifecycle\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              GIS-Powered Asset Management\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              Move beyond reactive maintenance with a spatially-enabled asset management system\n              that tracks the full lifecycle of every infrastructure component.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {ASSET_MANAGEMENT.map((item) => (\n              <Card key={item.title} className=\"hover:shadow-md transition-shadow\">\n                <CardHeader>\n                  <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3\">\n                    <item.icon className=\"h-5 w-5 text-primary\" />\n                  </div>\n                  <CardTitle className=\"text-lg\">{item.title}</CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <CardDescription className=\"text-sm leading-relaxed mb-4\">\n                    {item.description}\n                  </CardDescription>\n                  <Badge variant=\"outline\" className=\"text-primary border-primary/30 bg-primary/5\">\n                    {item.metric}\n                  </Badge>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Infrastructure Planning Insights ───────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Client Solutions\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              Data-Driven Infrastructure Planning\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              Our GIS analytics platform transforms spatial data into strategic insights that\n              support capital investment decisions, regulatory compliance, and long-range\n              infrastructure resilience planning.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 gap-8\">\n            {PLANNING_INSIGHTS.map((insight) => (\n              <div key={insight.title} className=\"flex items-start gap-4\">\n                <div className=\"h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n                  <insight.icon className=\"h-6 w-6 text-primary\" />\n                </div>\n                <div>\n                  <h3 className=\"font-semibold text-lg mb-2\">{insight.title}</h3>\n                  <p className=\"text-muted-foreground leading-relaxed\">{insight.description}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── Deliverables ───────────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24 bg-muted/30\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <Badge variant=\"secondary\" className=\"mb-4\">\n              Project Output\n            </Badge>\n            <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n              What You Receive\n            </h2>\n            <p className=\"text-muted-foreground text-lg\">\n              Every GIS integration engagement delivers a suite of tangible products that empower\n              your team to manage, analyze, and plan your infrastructure with confidence.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {DELIVERABLES.map((item) => (\n              <Card key={item.title} className=\"hover:shadow-md transition-shadow\">\n                <CardHeader className=\"flex flex-row items-start gap-4\">\n                  <div className=\"h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0\">\n                    <item.icon className=\"h-5 w-5 text-primary\" />\n                  </div>\n                  <div>\n                    <CardTitle className=\"text-lg mb-1\">{item.title}</CardTitle>\n                    <CardDescription>{item.description}</CardDescription>\n                  </div>\n                </CardHeader>\n              </Card>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <Separator />\n\n      {/* ── CTA Section ────────────────────────────────────────────────── */}\n      <section className=\"w-full py-16 md:py-24\">\n        <div className=\"container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n          <div className=\"relative rounded-2xl bg-primary text-primary-foreground overflow-hidden\">\n            {/* Background pattern */}\n            <div className=\"absolute inset-0 opacity-10\">\n              <svg\n                viewBox=\"0 0 100 100\"\n                className=\"w-full h-full\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n              >\n                <pattern id=\"dots\" x=\"0\" y=\"0\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n                  <circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"currentColor\" />\n                </pattern>\n                <rect width=\"100%\" height=\"100%\" fill=\"url(#dots)\" />\n              </svg>\n            </div>\n\n            <div className=\"relative z-10 text-center py-16 px-6\">\n              <h2 className=\"text-3xl md:text-4xl font-bold tracking-tight mb-4\">\n                Ready to Unlock Your Infrastructure Data?\n              </h2>\n              <p className=\"text-primary-foreground/80 text-lg max-w-2xl mx-auto mb-8\">\n                Schedule a free GIS readiness assessment with our team to discover how spatial\n                analysis can transform your water and sewer network planning, compliance\n                reporting, and capital investment strategy.\n              </p>\n\n              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                <Button\n                  size=\"lg\"\n                  variant=\"secondary\"\n                  className=\"text-primary\"\n                  asChild\n                >\n                  <a href=\"/contact\">\n                    Get Free Assessment\n                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n                  </a>\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  className=\"border-primary-foreground/50 text-primary-foreground hover:bg-primary-foreground/10\"\n                  asChild\n                >\n                  <a href=\"/projects\">\n                    View Our Projects\n                    <Map className=\"ml-2 h-5 w-5\" />\n                  </a>\n                </Button>\n              </div>\n\n              {/* Trust indicators */}\n              <div className=\"flex flex-wrap justify-center gap-6 mt-12 text-sm text-primary-foreground/60\">\n                {[\n                  'No Obligation Quote',\n                  'Expert GIS Engineers',\n                  'Proven Municipal Results',\n                ].map((item) => (\n                  <div key={item} className=\"flex items-center gap-2\">\n                    <CheckCircle2 className=\"h-4 w-4\" />\n                    {item}\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n\nexport default GISIntegration;","numLines":578,"startLine":1,"totalLines":578}}}
